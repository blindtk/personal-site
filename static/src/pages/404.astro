---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/ui';

const dict = t('pt');
const dictEn = t('en');
---

<BaseLayout lang="pt" title="404">
  <div class="page-head not-found-head">
    <h1>404</h1>
    <p class="intro">{dict.notFound.body}</p>
    <p class="intro" lang="en">{dictEn.notFound.body}</p>
  </div>
  <pre>~$ cd /404
bash: cd: /404: No such file or directory</pre>
  <p>
    <a href="/" class="mono">→ {dict.notFound.home}</a> ·{' '}
    <a href="/en/" class="mono" lang="en">→ {dictEn.notFound.home}</a>
  </p>
</BaseLayout>

<style>
  .not-found-head { margin-top: 3rem; }
  pre { white-space: pre-wrap; }
  .not-found-head h1 {
    font-size: clamp(5rem, 20vw, 10rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }
  /* o '//' do .page-head, à escala de 10rem, competia com o número */
  .not-found-head h1::before { font-size: 0.25em; vertical-align: 0.9em; }
</style>
