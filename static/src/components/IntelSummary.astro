---
/**
 * "O que o sensor viu": resumo agregado do honeypot externo na página do
 * projeto Threat Intel. Tudo resolvido no build a partir de
 * content/intel-summary.json (lib/intel.ts) — zero JS, zero pedidos de rede.
 * Sem ficheiro (ou com um resumo antigo) o componente não renderiza nada.
 *
 * As barras são <svg><rect width=…>: atributos de apresentação, não estilos
 * inline, por isso a CSP (style-src 'self') não é tocada.
 */
import attackData from '../../../content/attack.json';
import { SITE, type Lang } from '../config';
import { t } from '../i18n/ui';
import { routes } from '../i18n/routes';
import { intelSummary } from '../lib/intel';
import { techniqueUrl } from '../scripts/intel-summary.js';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).intel;
const locale = lang === 'pt' ? 'pt-PT' : 'en-GB';
const num = new Intl.NumberFormat(locale);

// Técnicas que também estão na minha matriz ATT&CK (pelo id base): liga o
// que o sensor vê ao que digo cobrir.
const covered = new Set(
  (attackData.tactics as { techniques: { id: string }[] }[]).flatMap((tac) => tac.techniques.map((tech) => tech.id)),
);

const summary = intelSummary;
const until = summary
  ? new Intl.DateTimeFormat(locale, { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(summary.generatedAt))
  : '';
const pct = (count: number, max: number) => (max > 0 ? Math.max(1, Math.round((count / max) * 100)) : 0);
const techMax = summary?.techniques[0]?.count ?? 0;
const userMax = summary?.usernames[0]?.count ?? 0;
---

{summary && (
  <section class="intel" aria-labelledby="h-intel">
    <div class="section-title">
      <h2 id="h-intel">{s.title}</h2>
    </div>
    <p class="intel-window mono">{summary.windowDays} {s.windowDays} · {s.until} {until}</p>
    <div class="metric-grid">
      <div class="stat"><div class="n">{num.format(summary.totals.events)}</div><div class="l">{s.events}</div></div>
      <div class="stat blue"><div class="n">{num.format(summary.totals.sources)}</div><div class="l">{s.sources}</div></div>
      <div class="stat blue"><div class="n">{num.format(summary.totals.sessions)}</div><div class="l">{s.sessions}</div></div>
    </div>
    <div class="intel-cols">
      {summary.techniques.length > 0 && (
        <div>
          <h3 class="intel-sub mono">{s.techniques}</h3>
          <ol class="intel-rows">
            {summary.techniques.map((row) => (
              <li>
                <span class="intel-key mono">
                  <a href={techniqueUrl(row.id)} rel="noopener">{row.id}</a>
                  {covered.has(row.id.split('.')[0]) && (
                    <a class="badge" href={routes.attack[lang]}>{s.covered}</a>
                  )}
                </span>
                <span class="intel-name">{row.name}</span>
                <span class="intel-count mono">{num.format(row.count)}</span>
                <svg class="intel-bar" viewBox="0 0 100 4" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                  <rect width={pct(row.count, techMax)} height="4" />
                </svg>
              </li>
            ))}
          </ol>
        </div>
      )}
      {summary.usernames.length > 0 && (
        <div>
          <h3 class="intel-sub mono">{s.usernames}</h3>
          <ol class="intel-rows">
            {summary.usernames.map((row) => (
              <li>
                <span class="intel-key mono">{row.name}</span>
                <span class="intel-count mono">{num.format(row.count)}</span>
                <svg class="intel-bar amber" viewBox="0 0 100 4" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                  <rect width={pct(row.count, userMax)} height="4" />
                </svg>
              </li>
            ))}
          </ol>
        </div>
      )}
    </div>
    <p class="note">
      {s.note}{' '}
      <a href={SITE.honeypotIntel} rel="noopener">{s.more} →</a>
    </p>
  </section>
)}

<style>
  .intel {
    margin-bottom: 2rem;
  }
  .intel-window {
    margin: 0 0 0.7rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .intel-cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.4rem;
    margin-top: 1.2rem;
  }
  @media (min-width: 860px) {
    .intel-cols { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); }
  }
  .intel-sub {
    margin: 0 0 0.6rem;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .intel-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .intel-rows li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.15rem 0.8rem;
    align-items: baseline;
  }
  .intel-key {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.86rem;
    overflow-wrap: anywhere;
  }
  .intel-key a { color: var(--accent); }
  .intel-key .badge { text-decoration: none; }
  .intel-name {
    grid-column: 1;
    font-size: 0.84rem;
    color: var(--muted);
  }
  .intel-count {
    grid-column: 2;
    grid-row: 1;
    font-size: 0.86rem;
    font-variant-numeric: tabular-nums;
  }
  .intel-bar {
    grid-column: 1 / -1;
    width: 100%;
    height: 4px;
    background: var(--bg-raise-2);
    border-radius: 2px;
  }
  .intel-bar rect { fill: var(--accent); }
  .intel-bar.amber rect { fill: var(--accent-2); }
</style>
