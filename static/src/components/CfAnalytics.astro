---
/**
 * Estado da Cloudflare (ao vivo) — painel da página Provas com métricas
 * reais desta zona/Worker via GET /api/cf-stats (Worker em
 * dynamic/worker/). NÃO é o Cloudflare Radar (esse é global e anónimo) —
 * são dados só desta zona/conta, via GraphQL Analytics API. Mesmo padrão do
 * CtWatch: fallback visível por omissão, painel só aparece quando a API
 * responde; rendering sempre via textContent.
 */
import { API_BASE, type Lang } from '../config';
import { t } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang).cfanalytics;

const jsStrings = {
  lastCheck: c.lastCheck,
};
---

<div class="cfa" id="cfa" data-api={API_BASE} data-lang={lang} data-strings={JSON.stringify(jsStrings)}>
  <p class="hp-fallback" id="cfa-fallback">{c.unavailable}</p>

  <div id="cfa-body" hidden>
    <div class="stats-grid">
      <div class="stat"><div class="n" id="cfa-requests">—</div><div class="l">{c.statRequests}</div></div>
      <div class="stat blue"><div class="n" id="cfa-cache">—</div><div class="l">{c.statCache}</div></div>
      <div class="stat" id="cfa-stat-threats"><div class="n" id="cfa-threats">—</div><div class="l">{c.statThreats}</div></div>
      <div class="stat" id="cfa-stat-errors"><div class="n" id="cfa-errors">—</div><div class="l">{c.statWorkerErrors}</div></div>
    </div>

    <p class="note">{c.workerNote} <span class="mono" id="cfa-worker-requests">—</span> {c.workerNoteSuffix}</p>
    <p class="note">🛰️ {c.privacyNote}</p>
    <p class="scan-ts" id="cfa-ts"></p>
  </div>
</div>

<script>
  const root = document.getElementById('cfa')!;
  const base = root.dataset.api ?? '';
  const lang = root.dataset.lang === 'pt' ? 'pt-PT' : 'en-GB';
  const S = JSON.parse(root.dataset.strings!);

  const setText = (id: string, value: string) => {
    document.getElementById(id)!.textContent = value;
  };
  const pct = (n: number) => `${(n * 100).toFixed(1)}%`;

  async function load() {
    try {
      const res = await fetch(`${base}/api/cf-stats`, { headers: { accept: 'application/json' } });
      const ctype = res.headers.get('content-type') ?? '';
      if (!res.ok || !ctype.includes('application/json')) throw new Error('no api');
      const data = await res.json();
      const zone = data.zone ?? {};
      const worker = data.worker ?? {};

      setText('cfa-requests', (zone.requests ?? 0).toLocaleString(lang));
      setText('cfa-cache', pct(zone.cacheRatio ?? 0));
      setText('cfa-threats', String(zone.threats ?? 0));
      setText('cfa-errors', pct(worker.errorRatio ?? 0));
      setText('cfa-worker-requests', (worker.requests ?? 0).toLocaleString(lang));

      document.getElementById('cfa-stat-threats')!.classList.toggle('amber', (zone.threats ?? 0) > 0);
      document.getElementById('cfa-stat-errors')!.classList.toggle('amber', (worker.errorRatio ?? 0) > 0);

      if (data.fetchedAt) {
        setText('cfa-ts', `${S.lastCheck}: ${new Date(data.fetchedAt).toLocaleString(lang)}`);
      }
      document.getElementById('cfa-fallback')!.hidden = true;
      document.getElementById('cfa-body')!.hidden = false;
    } catch {
      // Sem Worker publicado (ou sem CF_API_TOKEN configurado), o HTML já
      // nasce neste estado — nada a mudar, evita o salto de layout.
    }
  }

  load();
</script>
