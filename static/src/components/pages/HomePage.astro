---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NetworkTopology from '../NetworkTopology.astro';
import { SITE, type Lang } from '../../config';
import { t } from '../../i18n/ui';
import { routes, blogPostUrl, toolUrl, projectUrl } from '../../i18n/routes';
// content/ é a fonte de verdade: o nº de badges do painel stats vem daqui,
// com o mesmo critério (verified !== false) da página Certificações.
import certs from '../../../../content/certs.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t(lang);
const other: Lang = lang === 'pt' ? 'en' : 'pt';

const posts = (await getCollection('blog', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const projects = (await getCollection('projects', (e) => e.id.startsWith(`${lang}/`)))
  .sort((a, b) => a.data.order - b.data.order);

// As 6 ferramentas client-side — a lista completa, para o título
// "Ferramentas · client-side" não prometer mais nem menos do que mostra.
const tools = [
  { slug: 'subnets', ...dict.tools.subnets },
  { slug: 'hashes', ...dict.tools.hashes },
  { slug: 'encoder', ...dict.tools.encoder },
  { slug: 'passwords', ...dict.tools.passwords },
  { slug: 'email-headers', ...dict.tools['email-headers'] },
  { slug: 'exif', ...dict.tools.exif },
];

const dateFmt = new Intl.DateTimeFormat(lang === 'pt' ? 'pt-PT' : 'en-GB', { dateStyle: 'medium' });

// Stats: sinais de competência, não de consumo (os 550 repos do catálogo
// GitHub vivem na página Links, não aqui). Os nºs de certificações vêm do
// certs.json para nunca divergir da página Certificações.
const certItems = certs.items as { verified?: boolean }[];
const totalCerts = certItems.length;
const verifiedBadges = certItems.filter((item) => item.verified !== false).length;
const statValues: Record<string, string> = {
  certsTotal: String(totalCerts),
  certs: String(verifiedBadges),
};
const stats = dict.home.statsStatic.map((stat) =>
  'key' in stat && stat.key in statValues ? { ...stat, n: statValues[stat.key] } : stat,
);

const toneClass: Record<string, string> = { green: '', amber: 'amber', blue: 'blue' };
---

<BaseLayout
  lang={lang}
  title={dict.home.metaTitle}
  altUrl={routes.home[other]}
>
  <div class="top-grid">
    <section class="panel identity" aria-label={dict.home.identity}>
      <NetworkTopology />
      <div class="phead">
        <span>&#47;&#47; {dict.home.identity}</span>
        <span>{dict.home.location}</span>
      </div>
      <h1>{SITE.name}</h1>
      <p class="role">{SITE.role[lang]}</p>
      <p class="sum">{dict.home.bio}</p>
      <div class="meta-row">
        {dict.home.meta.map((item) => <span>{item}</span>)}
      </div>
      <div class="chip-row">
        {dict.home.chips.map((chip) => <span class="chip">{chip}</span>)}
      </div>
    </section>

    <section class="panel" aria-label={dict.home.statsLabel}>
      <div class="phead">
        <span>&#47;&#47; {dict.home.statsLabel}</span>
      </div>
      <div class="stats-grid">
        {stats.map((stat) => {
          const cls = `stat ${toneClass[stat.tone] ?? ''}`.trim();
          // Os dois stats de certificações vêm de certs.json — ligá-los à
          // página que os prova é o cruzamento natural (a mesma lógica
          // "não acredites, verifica").
          return 'key' in stat && (stat.key === 'certs' || stat.key === 'certsTotal') ? (
            <a class={`${cls} stat-link`} href={routes.certifications[lang]}>
              <div class="n">{stat.n}</div>
              <div class="l">{stat.d}</div>
            </a>
          ) : (
            <div class={cls}>
              <div class="n">{stat.n}</div>
              <div class="l">{stat.d}</div>
            </div>
          );
        })}
      </div>
    </section>
  </div>

  <section aria-labelledby="h-journey">
    <div class="section-title">
      <h2 id="h-journey">{dict.home.journey.title}</h2>
    </div>
    <p class="atk-hint journey-hint" aria-hidden="true">{dict.home.journey.scrollHint}</p>
    <div class="journey-wrap">
      <ol class="journey" id="journey-scroll">
        {dict.home.journey.items.map((stop) => (
          <li class="stop">
            <span class="dot" aria-hidden="true"></span>
            <span class="years">{stop.years}</span>
            <span class="name">
              <img class="flag" src={`/flags/${stop.flag}.svg`} alt="" width="20" height="15" decoding="async" />
              {stop.name}
            </span>
            <span class="place">{stop.place}</span>
            <span class="note">{stop.note}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {posts.length > 0 && (
    <section aria-labelledby="h-posts">
      <div class="section-title">
        <h2 id="h-posts">{dict.home.latestPosts}</h2>
        {posts.length >= 3 && <a class="more" href={routes.blog[lang]}>{dict.home.allPosts} →</a>}
      </div>
      <div class="grid grid-3">
        {posts.map((post) => (
          <a class="card" href={blogPostUrl(lang, post.id.slice(3))}>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="meta">
              <span>{dateFmt.format(post.data.pubDate)}</span>
              {post.data.tags.map((tag) => <span class="badge">{tag}</span>)}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {projects.length > 0 && (
    <section aria-labelledby="h-projects">
      <div class="section-title">
        <h2 id="h-projects">{dict.home.projects}</h2>
        <a class="more" href={routes.projects[lang]}>{dict.home.allProjects} →</a>
      </div>
      <div class="mini-list">
        {projects.map((project) => (
          <a href={projectUrl(lang, project.id.slice(3))}>
            <span class="name">{project.data.title}</span>
            <span class="desc">{project.data.description}</span>
            <span class="go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section aria-labelledby="h-tools">
    <div class="section-title">
      <h2 id="h-tools">{dict.home.featuredTools}</h2>
      <a class="more" href={routes.tools[lang]}>{dict.home.allTools} →</a>
    </div>
    <div class="mini-list">
      {tools.map((tool) => (
        <a href={toolUrl(lang, tool.slug)}>
          <span class="name">{tool.name}</span>
          <span class="desc">{tool.desc}</span>
          <span class="go" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  // Esconde o hint textual quando o utilizador chega ao fim do scroll
  // horizontal da timeline — mesmo padrão do heatmap ATT&CK.
  const scrollEl = document.getElementById('journey-scroll');
  const hint = document.querySelector('.journey-hint');

  if (scrollEl && hint) {
    const checkEnd = () => {
      const atEnd = scrollEl.scrollLeft + scrollEl.clientWidth >= scrollEl.scrollWidth - 4;
      hint.classList.toggle('hidden', atEnd);
    };
    scrollEl.addEventListener('scroll', checkEnd, { passive: true });
    window.addEventListener('resize', checkEnd);
    checkEnd();
  }
</script>
