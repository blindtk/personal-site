---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NetworkTopology from '../NetworkTopology.astro';
import { SITE, type Lang } from '../../config';
import { t } from '../../i18n/ui';
import { routes, blogPostUrl, toolUrl, projectUrl } from '../../i18n/routes';
import { TOOLS } from '../../lib/tools';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t(lang);
const other: Lang = lang === 'pt' ? 'en' : 'pt';

const posts = (await getCollection('blog', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const projects = (await getCollection('projects', (e) => e.id.startsWith(`${lang}/`)))
  .sort((a, b) => a.data.order - b.data.order);

// Seleção de ferramentas para a Home — "em destaque", só as que correm no
// browser; a lista completa (com as que precisam de servidor) vive em
// Ferramentas. Os glifos vêm de TOOLS (lib/tools.ts).
const featured = ['subnets', 'hashes', 'passwords', 'csp', 'email-headers', 'exif'] as const;
const tools = featured.map((slug) => ({
  slug,
  glyph: TOOLS.find((tool) => tool.slug === slug)!.glyph,
  ...dict.tools[slug],
}));

const dateFmt = new Intl.DateTimeFormat(lang === 'pt' ? 'pt-PT' : 'en-GB', { dateStyle: 'medium' });
---

<BaseLayout
  lang={lang}
  title={dict.home.metaTitle}
  altUrl={routes.home[other]}
>
  <section class="panel identity" aria-label={dict.home.identity}>
    <NetworkTopology />
    <div class="phead">
      <span>{dict.home.location}</span>
    </div>
    <h1>{SITE.name}</h1>
    <p class="role">{SITE.role[lang]}</p>
    <p class="sum">{dict.home.bio}</p>
    <div class="meta-row">
      {dict.home.meta.map((item) => <span>{item}</span>)}
    </div>
    <div class="chip-row">
      {dict.home.chips.map((chip) => <span class="chip">{chip}</span>)}
    </div>
    <p class="stack-line">{dict.home.stack}</p>
  </section>

  <section aria-labelledby="h-journey">
    <div class="section-title">
      <h2 id="h-journey">{dict.home.journey.title}</h2>
    </div>
    <ol class="journey">
      {dict.home.journey.items.map((stop) => (
        <li class="stop">
          <span class="dot" aria-hidden="true"></span>
          <span class="years">{stop.years}</span>
          <span class="name">{stop.name}</span>
          <span class="role">{stop.role}</span>
          {stop.note && <span class="note">{stop.note}</span>}
          {stop.projects.length > 0 && (
            <ul class="projects">
              {stop.projects.map((project) => (
                <li>
                  <span class="pname">
                    <img class="flag" src={`/flags/${project.flag}.svg`} alt="" width="20" height="15" decoding="async" />
                    {project.name}
                  </span>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ol>
  </section>

  {posts.length > 0 && (
    <section aria-labelledby="h-posts">
      <div class="section-title">
        <h2 id="h-posts">{dict.home.latestPosts}</h2>
        {posts.length >= 3 && <a class="more" href={routes.blog[lang]}>{dict.home.allPosts} →</a>}
      </div>
      <div class="grid grid-3">
        {posts.map((post) => (
          <a class="card" href={blogPostUrl(lang, post.id.slice(3))}>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="meta">
              <span>{dateFmt.format(post.data.pubDate)}</span>
              {post.data.tags.map((tag) => <span class="badge">{tag}</span>)}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {projects.length > 0 && (
    <section aria-labelledby="h-projects">
      <div class="section-title">
        <h2 id="h-projects">{dict.home.projects}</h2>
        <a class="more" href={routes.projects[lang]}>{dict.home.allProjects} →</a>
      </div>
      <ol class="proj-index">
        {projects.map((project, i) => (
          <li>
            <a href={projectUrl(lang, project.id.slice(3))}>
              <span class="idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="body">
                <span class="name">{project.data.title}</span>
                <span class="desc">{project.data.description}</span>
              </span>
              <span class="tags" aria-hidden="true">{project.data.tags.join(' · ')}</span>
              <span class="go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section aria-labelledby="h-tools">
    <div class="section-title">
      <h2 id="h-tools">{dict.home.featuredTools}</h2>
      <a class="more" href={routes.tools[lang]}>{dict.home.allTools} →</a>
    </div>
    <div class="tool-tiles">
      {tools.map((tool) => (
        <a href={toolUrl(lang, tool.slug)}>
          <span class="glyph" aria-hidden="true">{tool.glyph}</span>
          <span class="name">{tool.name}</span>
          <span class="desc">{tool.desc}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

