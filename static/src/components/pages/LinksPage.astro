---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../config';
import { t } from '../../i18n/ui';
import { routes } from '../../i18n/routes';
import linksData from '../../../../content/links.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t(lang);
const other: Lang = lang === 'pt' ? 'en' : 'pt';
---

<BaseLayout lang={lang} title={dict.links.title} altUrl={routes.links[other]} active="links">
  <div class="page-head">
    <h1>{dict.links.title}</h1>
    <p class="intro">{dict.links.intro}</p>
  </div>

  {linksData.map((group) => (
    <section>
      <div class="section-title">
        <h2>{group.category[lang]}</h2>
      </div>
      <div class="grid grid-3">
        {group.items.map((item) => (
          <a class="card" href={item.url} rel="noopener">
            <h3>{item.name}</h3>
            <p>{item.desc[lang]}</p>
            <div class="meta"><span>{new URL(item.url).hostname}</span></div>
          </a>
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
