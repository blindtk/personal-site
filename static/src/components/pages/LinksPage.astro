---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../config';
import { t } from '../../i18n/ui';
import { routes } from '../../i18n/routes';
import { getCatalog } from '../../lib/catalog';
import linksData from '../../../../content/links.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t(lang);
const other: Lang = lang === 'pt' ? 'en' : 'pt';

const catalog = await getCatalog();
const dateFmt = new Intl.DateTimeFormat(lang === 'pt' ? 'pt-PT' : 'en-GB', { dateStyle: 'medium' });

const slug = (name: string) =>
  name.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-');
---

<BaseLayout lang={lang} title={dict.links.title} altUrl={routes.links[other]} active="links">
  <div class="page-head">
    <h1>{dict.links.title}</h1>
    <p class="intro">{dict.links.intro}</p>
  </div>

  {catalog ? (
    <div id="catalog" data-empty-msg={dict.links.emptyResults}>
      <div class="catalog-toolbar panel">
        <div class="field" style="margin-bottom:0; flex:1; min-width: 14rem;">
          <label for="catalog-search">{dict.links.searchLabel}</label>
          <input
            type="search"
            id="catalog-search"
            placeholder={dict.links.searchPlaceholder}
            autocomplete="off"
            spellcheck="false"
          />
        </div>
        <div class="catalog-meta mono">
          <span id="catalog-count">{catalog.totalRepos}</span> {dict.links.reposWord}
          <span class="cat-updated">· {dict.links.updatedWord} {dateFmt.format(new Date(catalog.generatedAt))}</span>
        </div>
      </div>

      <div class="catalog-filters" role="group" aria-label={dict.links.title}>
        <button class="filter-chip active" data-cat="*">{dict.links.allCategories}</button>
        {catalog.categories.map((cat) => (
          <button class="filter-chip" data-cat={slug(cat.name)}>
            {cat.name} <span class="count">{cat.count}</span>
          </button>
        ))}
      </div>

      {catalog.categories.map((cat) => (
        <section class="catalog-section" data-cat={slug(cat.name)}>
          <div class="section-title">
            <h2>{cat.name}</h2>
            <span class="more">{cat.count} {dict.links.reposWord}</span>
          </div>
          <div class="grid grid-2">
            {cat.repos.map((repo) => (
              <a
                class="card repo-card"
                href={repo.url}
                rel="noopener"
                data-search={`${repo.name} ${repo.description ?? ''} ${repo.language ?? ''} ${repo.tags.join(' ')}`.toLowerCase()}
              >
                <h3>{repo.name}</h3>
                <p>{repo.description}</p>
                <div class="meta">
                  <span class="stars">★ {repo.stars.toLocaleString(lang === 'pt' ? 'pt-PT' : 'en-GB')}</span>
                  {repo.language && <span class="badge">{repo.language}</span>}
                  {repo.tags.slice(0, 3).map((tag) => <span class="badge amber">{tag}</span>)}
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}

      <p class="note" id="catalog-empty" hidden>{dict.links.emptyResults}</p>
    </div>
  ) : (
    <div class="construction">
      <strong>[ {dict.links.offlineTitle} ]</strong>
      <p style="margin:.6rem 0 0; color: var(--muted); font-family: var(--sans);">
        {dict.links.offlineBody}
        <a href="https://github.com/blindtk/github-stars" rel="noopener">github.com/blindtk/github-stars</a>
      </p>
    </div>
  )}

  <section>
    <div class="section-title">
      <h2>{dict.links.otherTitle}</h2>
    </div>
    {linksData.map((group) => (
      <div style="margin-bottom: 1.4rem;">
        <p class="mono" style="font-size:.78rem; color: var(--muted); margin: 0 0 .6rem;">{group.category[lang]}</p>
        <div class="grid grid-3">
          {group.items.map((item) => (
            <a class="card" href={item.url} rel="noopener">
              <h3>{item.name}</h3>
              <p>{item.desc[lang]}</p>
              <div class="meta"><span>{new URL(item.url).hostname}</span></div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>

<script>
  // Pesquisa + filtro por categoria, tudo client-side sobre o DOM já renderizado.
  const root = document.getElementById('catalog');
  if (root) {
    const search = document.getElementById('catalog-search') as HTMLInputElement;
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.filter-chip')];
    const sections = [...root.querySelectorAll<HTMLElement>('.catalog-section')];
    const countEl = document.getElementById('catalog-count')!;
    const emptyEl = document.getElementById('catalog-empty')!;
    let activeCat = '*';

    function apply() {
      const q = search.value.trim().toLowerCase();
      let visible = 0;
      for (const section of sections) {
        const inCat = activeCat === '*' || section.dataset.cat === activeCat;
        let sectionVisible = 0;
        for (const card of section.querySelectorAll<HTMLElement>('.repo-card')) {
          const show = inCat && (!q || card.dataset.search!.includes(q));
          card.hidden = !show;
          if (show) sectionVisible++;
        }
        section.hidden = sectionVisible === 0;
        visible += sectionVisible;
      }
      countEl.textContent = String(visible);
      emptyEl.hidden = visible > 0;
    }

    search.addEventListener('input', apply);
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        activeCat = chip.dataset.cat!;
        chips.forEach((other) => other.classList.toggle('active', other === chip));
        apply();
      });
    }
  }
</script>
