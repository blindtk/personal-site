---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../config';
import { t } from '../../i18n/ui';
import { routes, projectUrl } from '../../i18n/routes';
import { getCatalog } from '../../lib/catalog';
import linksData from '../../../../content/links.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t(lang);
const other: Lang = lang === 'pt' ? 'en' : 'pt';

const catalog = getCatalog();
const dateFmt = new Intl.DateTimeFormat(lang === 'pt' ? 'pt-PT' : 'en-GB', { dateStyle: 'medium' });
// 6 e não 10: com ~20 categorias, este cap é o que domina a altura inicial
// da página — o resto fica atrás do "ver todos" de cada secção. Tem de
// bater com o CAP do <script> abaixo.
const CAP = 6;

const slug = (name: string) =>
  name.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-');
---

<BaseLayout lang={lang} title={dict.links.title} altUrl={routes.links[other]} active="links">
  <div class="page-head">
    <h1>{dict.links.title}</h1>
    <p class="intro">{dict.links.intro}</p>
  </div>

  <div class="section-title">
    <h2>{dict.links.catalogTitle}</h2>
  </div>
  <p class="catalog-note">
    {dict.links.catalogNote}
    {' '}
    {/* Página do projeto star-organizer e não o repo github-stars: o repo é
       privado — para um visitante o link dava 404. A história de como o
       catálogo é gerado (e porquê o snapshot) está contada no projeto. */}
    <a href={projectUrl(lang, 'star-organizer')}>{dict.links.catalogLink}</a>
  </p>
  <p class="catalog-note">{dict.links.hubNote}</p>

  <div id="catalog" data-empty-msg={dict.links.emptyResults}>
    <div class="catalog-toolbar panel">
      <div class="field search-field">
        <label for="catalog-search">{dict.links.searchLabel}</label>
        <input
          type="search"
          id="catalog-search"
          placeholder={dict.links.searchPlaceholder}
          autocomplete="off"
          spellcheck="false"
        />
      </div>
      <div class="sort-group mono" role="group" aria-label={dict.links.sortLabel}>
        <span class="sort-label">{dict.links.sortLabel}</span>
        <button class="filter-chip sort-chip active" data-sort="stars">{dict.links.sortStars}</button>
        <button class="filter-chip sort-chip" data-sort="alpha">{dict.links.sortAlpha}</button>
      </div>
      <div class="catalog-meta mono">
        <span id="catalog-count">{catalog.totalRepos}</span> {dict.links.reposWord}
        {' '}
        <span class="cat-updated">· {dict.links.updatedWord} {dateFmt.format(new Date(catalog.generatedAt))}</span>
      </div>
    </div>

    <div class="catalog-filters" role="group" aria-label={dict.links.title}>
      <button class="filter-chip active" data-cat="*">{dict.links.allCategories}</button>
      {catalog.categories.map((cat) => (
        <button class="filter-chip" data-cat={slug(cat.name)}>
          {cat.name} <span class="count">{cat.count}</span>
        </button>
      ))}
    </div>

    {catalog.categories.map((cat) => (
      <section class="catalog-section" data-cat={slug(cat.name)}>
        <div class="section-title">
          <h2>{cat.name}</h2>
          <span class="more">{cat.count} {dict.links.reposWord}</span>
        </div>
        <div class="grid grid-2">
          {cat.repos.map((repo, i) => (
            <a
              class="card repo-card"
              href={repo.url}
              rel="noopener"
              hidden={i >= CAP}
              data-search={`${repo.name} ${repo.description ?? ''} ${repo.language ?? ''} ${repo.tags.join(' ')}`.toLowerCase()}
              data-stars={repo.stars}
              data-name={repo.name.toLowerCase()}
            >
              <h3>{repo.name}</h3>
              <p>{repo.description}</p>
              <div class="meta">
                <span class="stars">★ {repo.stars.toLocaleString(lang === 'pt' ? 'pt-PT' : 'en-GB')}</span>
                {repo.language && <span class="badge">{repo.language}</span>}
                {repo.tags.slice(0, 3).map((tag) => <span class="badge amber">{tag}</span>)}
              </div>
            </a>
          ))}
        </div>
        {cat.repos.length > CAP && (
          <button class="view-all mono" data-label={dict.links.viewAll}>
            {dict.links.viewAll} ({cat.repos.length - CAP}) →
          </button>
        )}
      </section>
    ))}

    <p class="note" id="catalog-empty" hidden>{dict.links.emptyResults}</p>
  </div>

  <section>
    <div class="section-title">
      <h2>{dict.links.otherTitle}</h2>
    </div>
    <p class="catalog-note">{dict.links.otherNote}</p>
    {linksData.map((group) => (
      <div class="link-group">
        <p class="mono link-group-label">{group.category[lang]}</p>
        <div class="grid grid-3">
          {group.items.map((item) => (
            <a class="card" href={item.url} rel="noopener">
              <h3>{item.name}</h3>
              <p>{item.desc[lang]}</p>
              <div class="meta"><span>{new URL(item.url).hostname}</span></div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>

<script>
  // Pesquisa + filtro + ordenação + cap por categoria, tudo client-side sobre
  // o DOM já renderizado (índice de pesquisa pré-construído no build via
  // data-search).
  const root = document.getElementById('catalog');
  if (root) {
    const CAP = 6; // tem de bater com o CAP do frontmatter
    const search = document.getElementById('catalog-search') as HTMLInputElement;
    const catChips = [...root.querySelectorAll<HTMLButtonElement>('.filter-chip[data-cat]')];
    const sortChips = [...root.querySelectorAll<HTMLButtonElement>('.filter-chip[data-sort]')];
    const sections = [...root.querySelectorAll<HTMLElement>('.catalog-section')];
    const countEl = document.getElementById('catalog-count')!;
    const emptyEl = document.getElementById('catalog-empty')!;
    let activeCat = '*';
    let sortMode: 'stars' | 'alpha' = 'stars';
    const expanded = new Set<string>();

    function sortSection(section: HTMLElement): HTMLElement[] {
      const grid = section.querySelector<HTMLElement>('.grid')!;
      const cards = [...grid.querySelectorAll<HTMLElement>('.repo-card')];
      cards.sort((a, b) =>
        sortMode === 'alpha'
          ? a.dataset.name!.localeCompare(b.dataset.name!)
          : Number(b.dataset.stars) - Number(a.dataset.stars),
      );
      for (const card of cards) grid.appendChild(card);
      return cards;
    }

    function apply() {
      const q = search.value.trim().toLowerCase();
      let totalMatched = 0;
      for (const section of sections) {
        const inCat = activeCat === '*' || section.dataset.cat === activeCat;
        const cards = sortSection(section);
        const isExpanded = expanded.has(section.dataset.cat!) || !!q;
        const viewAllBtn = section.querySelector<HTMLButtonElement>('.view-all');
        let matched = 0;
        for (const card of cards) {
          const matches = inCat && (!q || card.dataset.search!.includes(q));
          if (matches) matched++;
          card.hidden = !(matches && (isExpanded || matched <= CAP));
        }
        section.hidden = matched === 0;
        totalMatched += matched;
        if (viewAllBtn) {
          const remaining = matched - CAP;
          if (!inCat || isExpanded || remaining <= 0) {
            viewAllBtn.hidden = true;
          } else {
            viewAllBtn.hidden = false;
            viewAllBtn.textContent = `${viewAllBtn.dataset.label} (${remaining}) →`;
          }
        }
      }
      countEl.textContent = String(totalMatched);
      emptyEl.hidden = totalMatched > 0;
    }

    search.addEventListener('input', apply);
    for (const chip of catChips) {
      chip.addEventListener('click', () => {
        activeCat = chip.dataset.cat!;
        catChips.forEach((other) => other.classList.toggle('active', other === chip));
        apply();
      });
    }
    for (const chip of sortChips) {
      chip.addEventListener('click', () => {
        sortMode = chip.dataset.sort as 'stars' | 'alpha';
        sortChips.forEach((other) => other.classList.toggle('active', other === chip));
        apply();
      });
    }
    for (const section of sections) {
      section.querySelector<HTMLButtonElement>('.view-all')?.addEventListener('click', () => {
        expanded.add(section.dataset.cat!);
        apply();
      });
    }

    apply();
  }
</script>

<style>
  .search-field { margin-bottom: 0; flex: 1; min-width: 14rem; }
  .link-group { margin-bottom: 1.4rem; }
  .link-group-label { font-size: 0.78rem; color: var(--muted); margin: 0 0 0.6rem; }
</style>
