---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../config';
import { t } from '../../i18n/ui';
import { routes } from '../../i18n/routes';
// content/ é a fonte de verdade (ver CLAUDE.md): as fotos/coins são a prova,
// não texto escrito à mão — as imagens vivem em static/public/awards/.
import awards from '../../../../content/awards.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t(lang);
const a = dict.awards;
const other: Lang = lang === 'pt' ? 'en' : 'pt';

const entry = await getEntry('pages', lang === 'pt' ? 'sobre' : 'about');
if (!entry) throw new Error(`Missing about page content for lang "${lang}" in content/pages/`);
const { Content } = await render(entry);

type Award = { event: string; org: string; year: number; image: string; width: number; height: number; note: Record<Lang, string> };
const items = (awards.items as Award[]).slice().sort((x, y) => y.year - x.year);
---

<BaseLayout lang={lang} title={dict.nav.about} altUrl={routes.about[other]} active="about">
  <div class="page-head">
    <h1>{entry.data.title}</h1>
  </div>
  <article class="prose">
    <Content />
  </article>

  <section aria-labelledby="h-awards">
    <div class="section-title">
      <h2 id="h-awards">{a.title}</h2>
    </div>
    <p class="intro">{a.intro}</p>
    <div class="grid grid-2 awards-grid">
      {items.map((item) => (
        <figure class="card award-card">
          <img
            src={item.image}
            width={item.width}
            height={item.height}
            loading="lazy"
            decoding="async"
            alt={`${item.event} — ${item.org} ${item.year}`}
          />
          <figcaption>
            <span class="badge">{a.firstPlace} · {item.year}</span>
            <h3>{item.event}</h3>
            <p class="award-org mono">{item.org}</p>
            <p>{item.note[lang]}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .awards-grid {
    margin-top: 1rem;
  }
  .award-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  .award-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 25%;
    display: block;
    border-bottom: 1px solid var(--border);
  }
  .award-card figcaption {
    padding: 1rem 1.1rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .award-card h3 {
    margin: 0.2rem 0 0;
    font-size: 1rem;
  }
  .award-org {
    color: var(--muted);
    font-size: 0.8rem;
    margin: 0;
  }
  .award-card .badge {
    align-self: flex-start;
  }
  @media (max-width: 640px) {
    .awards-grid.grid-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
