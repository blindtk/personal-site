---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Widget from '../site/Widget.astro';
import Skeleton from '../site/Skeleton.astro';
import SiteLayers from '../SiteLayers.astro';
import { API_BASE, type Lang } from '../../config';
import { t } from '../../i18n/ui';
import { routes } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t(lang);
const s = dict.site;
const other: Lang = lang === 'pt' ? 'en' : 'pt';

const jsStrings = {
  countriesEmpty: s.countriesEmpty,
  firewallEmpty: s.firewallEmpty,
  tiNoneYet: s.tiNoneYet,
  countryUnknown: s.countryUnknown,
  tlPeak: s.tlPeak,
  tlLast: s.tlLast,
  tiDailyTitle: s.tiDailyTitle,
  tiDailyBlocked: s.tiDailyBlocked,
  tiDailyChallenged: s.tiDailyChallenged,
  tiDailyAllowed: s.tiDailyAllowed,
};
---

<BaseLayout lang={lang} title={s.cloudflareMetaTitle} altUrl={routes.cloudflare[other]} active="cloudflare" wide>
  <SiteLayers lang={lang} current="cloudflare" />
  <div class="page-head">
    <h1>{s.cloudflareTitle}</h1>
    <p class="intro">{s.cloudflareIntro}</p>
  </div>

  <div id="cf-root" data-api={API_BASE} data-lang={lang} data-strings={JSON.stringify(jsStrings)}>
    <p class="hp-fallback" id="cf-fallback">{s.unavailable}</p>
    <div id="cf-body" hidden>
      <div class="metric-grid">
        <div class="stat amber"><div class="n" id="cf-threats">—</div><div class="l">{s.cardThreats}</div></div>
        <div class="stat amber"><div class="n" id="cf-blocked">—</div><div class="l">{s.cardBlocked}</div></div>
        <div class="stat amber"><div class="n" id="cf-threatrate">—</div><div class="l">{s.cardThreatRate}</div></div>
      </div>

      <div class="widget-grid an-mt">
        <Widget title={s.tlThreats} tone="warn" meta={s.windowNote} class="wide-widget">
          <div class="spark warn" id="cf-tl-threats"><Skeleton block /></div>
        </Widget>
      </div>
      <div class="widget-grid an-mt">
        <Widget title={s.wTopCountries} tone="warn" meta={s.windowNote}>
          <div id="cf-countries"><Skeleton rows={4} /></div>
        </Widget>
      </div>
      <div class="widget-grid an-mt">
        <Widget title={s.wFirewallPaths} tone="warn"><div id="cf-fw-paths"><Skeleton rows={4} /></div></Widget>
        <Widget title={s.wFirewallUserAgents} tone="warn"><div id="cf-fw-uas"><Skeleton rows={4} /></div></Widget>
        <Widget title={s.wFirewallAsns} tone="warn"><div id="cf-fw-asns"><Skeleton rows={4} /></div></Widget>
      </div>

      {/* Mitigação por dia e firewall por ação lado a lado: a mesma janela de
         7 dias vista de dois ângulos. Sozinho a toda a largura, o gráfico
         ficava limitado a 44rem e deixava meio widget vazio. */}
      <div class="split-grid an-mt">
        <Widget title={s.tiDailyTitle} tone="warn" meta={s.windowNote}>
          <div id="cf-daily"><Skeleton block /></div>
        </Widget>
        <Widget title={s.tiFirewallAction} tone="warn" meta={s.windowNote}><div id="cf-fwaction"></div></Widget>
      </div>

    </div>
  </div>

</BaseLayout>

<script>
  import {
    formatNumber, formatPercent, threatRate, withBars, sparkPath,
    firewallActionTone, classifyDaily,
  } from '../../scripts/observability.js';

  const root = document.getElementById('cf-root')!;
  const base = root.dataset.api ?? '';
  const locale = root.dataset.lang === 'pt' ? 'pt-PT' : 'en-GB';
  const S = JSON.parse(root.dataset.strings ?? '{}');

  const setText = (id: string, value: string) => {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
  };

  const SVG_NS = 'http://www.w3.org/2000/svg';

  // ---------- Barras horizontais (mesma lógica do antigo Analytics/Perímetro) ----------
  function renderBars(
    id: string,
    rows: { label: string; value: number; tone?: string; display?: string }[],
    empty: string,
  ) {
    const host = document.getElementById(id);
    if (!host) return;
    host.replaceChildren();
    if (rows.length === 0) {
      const el = document.createElement('p');
      el.className = 'note';
      el.textContent = empty;
      host.append(el);
      return;
    }
    const list = document.createElement('div');
    list.className = 'bar-list';
    for (const row of withBars(rows)) {
      const r = document.createElement('div');
      r.className = 'bar-row';
      const head = document.createElement('div');
      head.className = 'bar-head';
      const label = document.createElement('span');
      label.className = 'bar-label';
      label.textContent = row.label;
      const val = document.createElement('span');
      val.className = 'bar-val';
      val.textContent = (row as any).display ?? formatNumber(row.value, locale);
      head.append(label, val);
      const track = document.createElement('div');
      track.className = 'bar-track';
      const fill = document.createElement('div');
      fill.className = row.tone ? `bar-fill ${row.tone}` : 'bar-fill';
      fill.style.width = `${(row as any).pct}%`;
      track.append(fill);
      r.append(head, track);
      list.append(r);
    }
    host.append(list);
  }

  // Nome do país por extenso (a API só dá o código ISO); "T1" é o código da
  // Cloudflare para Tor, que não é uma região válida para o Intl.
  const regionNames = (() => {
    try { return new Intl.DisplayNames([locale], { type: 'region' }); } catch { return null; }
  })();
  const countryName = (code: string) => {
    if (code === 'T1') return 'Tor';
    if (code === 'XX') return S.countryUnknown;
    try { return regionNames?.of(code) ?? code; } catch { return code; }
  };

  const bars = (rows: any[], keyField: string, valField: string, tone?: string) =>
    rows.map((r) => ({ label: String(r[keyField]), value: Number(r[valField]) || 0, tone }));

  function renderSpark(id: string, series: any[], valueKey: string) {
    const host = document.getElementById(id);
    if (!host) return;
    host.replaceChildren();
    const values = series.map((d) => Number(d?.[valueKey]) || 0);
    if (values.length === 0) {
      const el = document.createElement('p');
      el.className = 'note';
      el.textContent = S.tiNoneYet;
      host.append(el);
      return;
    }
    const { line, area, max } = sparkPath(values);
    const svg = document.createElementNS(SVG_NS, 'svg');
    svg.setAttribute('class', 'spark-svg');
    svg.setAttribute('viewBox', '0 0 100 30');
    svg.setAttribute('preserveAspectRatio', 'none');
    svg.setAttribute('role', 'img');
    const areaEl = document.createElementNS(SVG_NS, 'path');
    areaEl.setAttribute('class', 'spark-area');
    areaEl.setAttribute('d', area);
    const lineEl = document.createElementNS(SVG_NS, 'path');
    lineEl.setAttribute('class', 'spark-line');
    lineEl.setAttribute('d', line);
    lineEl.setAttribute('vector-effect', 'non-scaling-stroke');
    svg.append(areaEl, lineEl);
    host.append(svg);
    const cap = document.createElement('div');
    cap.className = 'spark-cap';
    const last = document.createElement('span');
    last.textContent = `${S.tlLast}: ${formatNumber(values[values.length - 1], locale)}`;
    const peak = document.createElement('span');
    peak.textContent = `${S.tlPeak}: ${formatNumber(max, locale)}`;
    cap.append(last, peak);
    host.append(cap);
  }

  // ---------- Cloudflare (ameaças à zona, /api/cf-stats) ----------
  async function loadCfThreats() {
    try {
      const res = await fetch(`${base}/api/cf-stats`, { headers: { accept: 'application/json' } });
      const ctype = res.headers.get('content-type') ?? '';
      if (!res.ok || !ctype.includes('application/json')) throw new Error('no api');
      const zone = (await res.json()).zone ?? {};

      const requests = Number(zone.requests ?? 0);
      const threats = Number(zone.threats ?? 0);
      const blocked = (zone.blockedByStatus ?? []).reduce((a: number, r: any) => a + (Number(r.count) || 0), 0);

      setText('cf-threats', formatNumber(threats, locale));
      setText('cf-blocked', formatNumber(blocked, locale));
      setText('cf-threatrate', formatPercent(threatRate(threats, requests)));

      renderBars(
        'cf-countries',
        bars(zone.topCountries ?? [], 'country', 'threats', 'warn').map((r) => ({ ...r, label: countryName(r.label) })),
        S.countriesEmpty,
      );

      // Detalhe por URL/user-agent/ASN — vem do dataset CRU
      // firewallEventsAdaptive (dataset amostrado): nunca IP, mesmo esse
      // campo estando disponível na fonte.
      renderBars('cf-fw-paths', bars(zone.firewallByPath ?? [], 'key', 'count', 'warn'), S.firewallEmpty);
      renderBars('cf-fw-uas', bars(zone.firewallByUserAgent ?? [], 'key', 'count', 'warn'), S.firewallEmpty);
      renderBars(
        'cf-fw-asns',
        (zone.firewallByAsn ?? []).map((r: any) => ({
          label: r.name ? `${r.key} · ${r.name}` : String(r.key),
          value: Number(r.count) || 0,
          tone: 'warn',
        })),
        S.firewallEmpty,
      );

      const series = Array.isArray(zone.series) ? zone.series : [];
      renderSpark('cf-tl-threats', series, 'threats');

      document.getElementById('cf-fallback')!.hidden = true;
      document.getElementById('cf-body')!.hidden = false;
    } catch {
      // Sem Worker: fica o fallback já pintado.
    }
  }

  // ---------- Mitigação por dia + firewall por ação/origem (/api/threat-intel) ----------
  const dayFmt = new Intl.DateTimeFormat(locale, { day: '2-digit', month: '2-digit', timeZone: 'UTC' });

  function renderDailyBars(daily: any[]) {
    const host = document.getElementById('cf-daily');
    if (!host) return;
    host.replaceChildren();
    const rows = classifyDaily(daily);
    if (rows.length === 0) {
      const el = document.createElement('p');
      el.className = 'note';
      el.textContent = S.tiNoneYet;
      host.append(el);
      return;
    }
    const W = 620;
    const H = 216;
    const ML = 42;
    const MR = 8;
    const TOP = 26;
    const AXIS_Y = 178;
    const GAP = 2;
    const MINH = 2.2;
    const n = rows.length;
    const slot = (W - ML - MR) / n;
    const barW = Math.min(58, slot * 0.72);
    const max = Math.max(1, ...rows.map((r) => r.total));
    const scale = (AXIS_Y - TOP - GAP * 2) / max;
    const todayIso = new Date().toISOString().slice(0, 10);

    const svg = document.createElementNS(SVG_NS, 'svg');
    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    svg.setAttribute('class', 'daily-svg');
    svg.setAttribute('role', 'img');
    svg.setAttribute('aria-label', S.tiDailyTitle);
    const axis = document.createElementNS(SVG_NS, 'line');
    axis.setAttribute('x1', String(ML));
    axis.setAttribute('y1', String(AXIS_Y));
    axis.setAttribute('x2', String(W - MR));
    axis.setAttribute('y2', String(AXIS_Y));
    axis.setAttribute('class', 'chart-axis');
    svg.append(axis);

    rows.forEach((r, i) => {
      const x = ML + i * slot + (slot - barW) / 2;
      const cx = x + barW / 2;
      const g = document.createElementNS(SVG_NS, 'g');
      const title = document.createElementNS(SVG_NS, 'title');
      title.textContent = `${r.date} · ${S.tiDailyBlocked}: ${formatNumber(r.blocked, locale)} · `
        + `${S.tiDailyChallenged}: ${formatNumber(r.challenged, locale)} · `
        + `${S.tiDailyAllowed}: ${formatNumber(r.allowed, locale)}`;
      g.append(title);

      let y = AXIS_Y;
      const seg = (value: number, cls: string) => {
        if (value <= 0) return;
        const h = Math.max(MINH, value * scale);
        y -= h;
        const rect = document.createElementNS(SVG_NS, 'rect');
        rect.setAttribute('x', x.toFixed(1));
        rect.setAttribute('y', y.toFixed(1));
        rect.setAttribute('width', barW.toFixed(1));
        rect.setAttribute('height', h.toFixed(1));
        rect.setAttribute('rx', Math.min(4, h / 2).toFixed(1));
        rect.setAttribute('class', `daily-seg ${cls}`);
        g.append(rect);
        y -= GAP;
      };
      seg(r.blocked, 'blocked');
      seg(r.challenged, 'challenged');
      seg(r.allowed, 'allowed');

      if (r.total > 0) {
        const val = document.createElementNS(SVG_NS, 'text');
        val.setAttribute('x', cx.toFixed(1));
        val.setAttribute('y', (y - 6).toFixed(1));
        val.setAttribute('text-anchor', 'middle');
        val.setAttribute('class', 'chart-val');
        val.textContent = formatNumber(r.total, locale);
        g.append(val);
      }
      const dayLbl = document.createElementNS(SVG_NS, 'text');
      dayLbl.setAttribute('x', cx.toFixed(1));
      dayLbl.setAttribute('y', String(AXIS_Y + 16));
      dayLbl.setAttribute('text-anchor', 'middle');
      dayLbl.setAttribute('class', r.date === todayIso ? 'chart-lbl strong' : 'chart-lbl');
      dayLbl.textContent = dayFmt.format(new Date(`${r.date}T00:00:00Z`));
      g.append(dayLbl);

      svg.append(g);
    });
    host.append(svg);

    const legend = document.createElement('div');
    legend.className = 'chart-legend mono';
    const totals = rows.reduce(
      (acc, r) => ({ blocked: acc.blocked + r.blocked, challenged: acc.challenged + r.challenged, allowed: acc.allowed + r.allowed }),
      { blocked: 0, challenged: 0, allowed: 0 },
    );
    const swatches: [string, string, number][] = [
      ['blocked', S.tiDailyBlocked, totals.blocked],
      ['challenged', S.tiDailyChallenged, totals.challenged],
      ['allowed', S.tiDailyAllowed, totals.allowed],
    ];
    for (const [cls, label, count] of swatches) {
      const span = document.createElement('span');
      const dot = document.createElement('i');
      dot.className = `chart-dot ${cls}`;
      span.append(dot, document.createTextNode(`${label} · ${formatNumber(count, locale)}`));
      legend.append(span);
    }
    host.append(legend);
  }

  async function loadFirewallTrends() {
    try {
      const res = await fetch(`${base}/api/threat-intel`, { headers: { accept: 'application/json' } });
      const ctype = res.headers.get('content-type') ?? '';
      if (!res.ok || !ctype.includes('application/json')) throw new Error('no api');
      const d = await res.json();
      const fw = d.firewall7d ?? {};
      renderDailyBars(Array.isArray(fw.daily) ? fw.daily : []);
      // Tom por CLASSE de ação, não âmbar para tudo.
      renderBars(
        'cf-fwaction',
        (fw.byAction ?? []).map((r: any) => ({
          label: String(r.key),
          value: Number(r.count) || 0,
          tone: firewallActionTone(r.key),
        })),
        S.firewallEmpty,
      );
    } catch {
      // Sem Worker/dados: fica o fallback já pintado no widget-container.
    }
  }

  loadCfThreats();
  loadFirewallTrends();
</script>

<style>
  .an-mt { margin-top: 0.9rem; }
  .wide-widget { grid-column: 1 / -1; }

  .split-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.8rem;
    align-items: start;
  }
  @media (min-width: 960px) {
    .split-grid { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); }
  }
  /* O SVG diário (viewBox 620) encolhe para ~0,4× num telemóvel e os rótulos
     de 9 unidades ficavam com ~3,6px. O texto está em unidades do viewBox:
     duplicá-lo aqui compensa a escala (7 colunas de ~80 unidades cabem
     "28/09" a 18). :global porque o SVG é criado pelo script. */
  @media (max-width: 40rem) {
    #cf-daily :global(.chart-lbl),
    #cf-daily :global(.chart-val) { font-size: 18px; }
  }
</style>
