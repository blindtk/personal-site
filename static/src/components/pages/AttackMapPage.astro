---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tabs from '../site/Tabs.astro';
import { API_BASE, type Lang } from '../../config';
import { t } from '../../i18n/ui';
import { routes } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t(lang);
const m = dict.attackMap;
const other: Lang = lang === 'pt' ? 'en' : 'pt';

// Dois separadores, um globo em cada: "Este site" (firewall da zona,
// /api/threat-intel, bolhas por país de origem) primeiro, e "Mundo" (Cloudflare
// Radar, /api/radar-attacks, arcos origem → alvo) como contexto. Ver
// dynamic/PLAN.md.
const tabs = [
  { id: 'self', label: m.tabSelf },
  { id: 'world', label: m.tabWorld },
];

const jsStrings = {
  pause: m.pause,
  play: m.play,
  unavailable: m.unavailable,
  selfEmpty: m.selfEmpty,
  selfUnavailable: m.selfUnavailable,
  countryUnknown: m.countryUnknown,
  blocked: m.legendBlocked,
  challenged: m.legendChallenged,
  allowed: m.legendAllowed,
};
---

<BaseLayout lang={lang} title={m.metaTitle} altUrl={routes.attackMap[other]}>
  <div class="page-head">
    <h1>{m.title} <span class="badge amber am-badge">{m.serverBadge}</span></h1>
    <p class="intro">{m.intro}</p>
  </div>

  <div id="am-root" data-api={API_BASE} data-lang={lang} data-strings={JSON.stringify(jsStrings)}>
    <Tabs tabs={tabs} label={m.tabsLabel}>
      <div slot="self">
        <p class="note am-scope">{m.selfNote} <a href={routes.cloudflare[lang]}>{m.selfLink}</a>.</p>
        <p class="hp-loading" id="am-self-status" role="status">{m.loading}</p>
        <div id="am-self-body" hidden>
          <figure class="am-figure" data-globe="self">
            <canvas class="am-globe" role="img" aria-label={m.selfGlobeLabel}></canvas>
            <figcaption class="am-caption">
              <span class="am-legend">
                <span><i class="am-sw blocked" aria-hidden="true"></i>{m.legendBlocked}</span>
                <span><i class="am-sw challenged" aria-hidden="true"></i>{m.legendChallenged}</span>
                <span><i class="am-sw allowed" aria-hidden="true"></i>{m.legendAllowed}</span>
              </span>
              <span class="am-controls">
                <button type="button" class="btn small ghost am-toggle">{m.pause}</button>
                <span class="note am-hint">{m.dragHint}</span>
              </span>
            </figcaption>
          </figure>

          <h2 class="am-h2">{m.selfTableTitle}</h2>
          <div class="table-scroll">
            <table class="result-table am-table">
              <caption class="visually-hidden">{m.selfTableCaption}</caption>
              <thead>
                <tr>
                  <th scope="col">{m.colCountry}</th>
                  <th scope="col">{m.colAction}</th>
                  <th scope="col" class="num">{m.colEvents}</th>
                </tr>
              </thead>
              <tbody id="am-self-rows"></tbody>
            </table>
          </div>
        </div>
      </div>

      <div slot="world">
        <p class="note warn am-scope">{m.worldNote}</p>
        <p class="hp-loading" id="am-world-status" role="status">{m.loading}</p>
        <div id="am-world-body" hidden>
          <figure class="am-figure" data-globe="world">
            <canvas class="am-globe" role="img" aria-label={m.globeLabel}></canvas>
            <figcaption class="am-caption">
              <span class="am-legend">
                <span><i class="am-sw origin" aria-hidden="true"></i>{m.legendOrigin}</span>
                <span><i class="am-sw target" aria-hidden="true"></i>{m.legendTarget}</span>
                <span><i class="am-sw ring" aria-hidden="true"></i>{m.legendDomestic}</span>
              </span>
              <span class="am-window mono">{m.windowLabel}: <span id="am-window">—</span></span>
              <span class="am-controls">
                <button type="button" class="btn small ghost am-toggle">{m.pause}</button>
                <span class="note am-hint">{m.dragHint}</span>
              </span>
            </figcaption>
          </figure>

          <h2 class="am-h2">{m.tableTitle}</h2>
          <div class="table-scroll">
            <table class="result-table am-table">
              <caption class="visually-hidden">{m.tableCaption}</caption>
              <thead>
                <tr>
                  <th scope="col">{m.colRank}</th>
                  <th scope="col">{m.colOrigin}</th>
                  <th scope="col">{m.colTarget}</th>
                  <th scope="col" class="num">{m.colShare}</th>
                </tr>
              </thead>
              <tbody id="am-pairs"></tbody>
            </table>
          </div>
        </div>

        {/* Atribuição exigida pela licença dos dados da Radar (CC BY-NC 4.0). */}
        <p class="note">
          {m.attributionPrefix}{' '}
          <a href="https://radar.cloudflare.com/security/application-layer" rel="noopener">Cloudflare Radar</a>
          {' · '}
          <a href="https://creativecommons.org/licenses/by-nc/4.0/" rel="noopener license">{m.attributionLicense}</a>
        </p>
      </div>
    </Tabs>
  </div>

  <hr class="am-hr" />
  <a href={routes.attack[lang]} class="mono">{m.seeAttack}</a>
</BaseLayout>

<script>
  import { formatNumber, firewallActionClass } from '../../scripts/observability.js';
  import type { GlobeData } from '../attack-map/globe-canvas';

  type Pair = [string, string, number];

  const root = document.getElementById('am-root')!;
  const base = root.dataset.api ?? '';
  const locale = root.dataset.lang === 'pt' ? 'pt-PT' : 'en-GB';
  const S = JSON.parse(root.dataset.strings ?? '{}');

  const regionNames = (() => {
    try { return new Intl.DisplayNames([locale], { type: 'region' }); } catch { return null; }
  })();
  const countryName = (code: string) => {
    if (code === 'T1') return 'Tor';
    if (code === 'XX' || !code) return S.countryUnknown;
    try { return regionNames?.of(code) ?? code; } catch { return code; }
  };
  const pctFmt = new Intl.NumberFormat(locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const hourFmt = new Intl.DateTimeFormat(locale, { hour: '2-digit', minute: '2-digit' });
  const hourZoneFmt = new Intl.DateTimeFormat(locale, { hour: '2-digit', minute: '2-digit', timeZoneName: 'short' });

  function cell(text: string, cls?: string) {
    const td = document.createElement('td');
    td.textContent = text;
    if (cls) td.className = cls;
    return td;
  }

  function countryCell(code: string) {
    const td = document.createElement('td');
    td.append(document.createTextNode(`${countryName(code)} `));
    const c = document.createElement('span');
    c.className = 'am-cc';
    c.textContent = code;
    td.append(c);
    return td;
  }

  async function getJson(path: string) {
    const res = await fetch(`${base}${path}`, { headers: { accept: 'application/json' } });
    const ctype = res.headers.get('content-type') ?? '';
    if (!res.ok || !ctype.includes('application/json')) throw new Error('no api');
    return res.json();
  }

  function fail(statusId: string, text: string) {
    const status = document.getElementById(statusId)!;
    status.className = 'hp-fallback';
    status.textContent = text;
  }

  function show(prefix: string) {
    document.getElementById(`${prefix}-status`)!.hidden = true;
    document.getElementById(`${prefix}-body`)!.hidden = false;
  }

  // Um globo por separador. Só se descarrega (import() → chunk próprio, com
  // os dados geográficos) quando o canvas aparece: o do separador escondido
  // não interseta o ecrã, por isso só monta (e só anima) quando é mostrado.
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  function lazyGlobe(name: string, data: GlobeData) {
    const figure = document.querySelector<HTMLElement>(`[data-globe="${name}"]`)!;
    const canvas = figure.querySelector('canvas')!;
    const toggle = figure.querySelector<HTMLButtonElement>('.am-toggle')!;
    // Com movimento reduzido o globo começa parado; o botão continua a
    // deixar pô-lo a rodar, por escolha explícita.
    let playing = !motion.matches;
    const label = () => {
      toggle.textContent = playing ? S.pause : S.play;
      toggle.setAttribute('aria-pressed', String(!playing));
    };
    label();

    const io = new IntersectionObserver(async ([entry]) => {
      if (!entry.isIntersecting) return;
      io.disconnect();
      const { mountGlobe } = await import('../attack-map/globe-canvas');
      const globe = mountGlobe(canvas, data, { playing });
      if (!globe) {
        canvas.hidden = true;
        toggle.hidden = true;
        return;
      }
      toggle.addEventListener('click', () => {
        playing = !playing;
        globe.setPlaying(playing);
        label();
      });
      motion.addEventListener('change', () => {
        if (motion.matches && playing) {
          playing = false;
          globe.setPlaying(false);
          label();
        }
      });
    }, { rootMargin: '200px' });
    io.observe(canvas);
  }

  // ---------- Este site: firewall da zona, 7 dias (/api/threat-intel) ----------
  async function loadSelf() {
    let rows: { country: string; action: string; count: number; total?: number }[];
    try {
      const raw = (await getJson('/api/threat-intel'))?.firewall7d?.byCountry;
      rows = Array.isArray(raw) ? raw : [];
    } catch {
      fail('am-self-status', S.selfUnavailable);
      return;
    }
    if (rows.length === 0) {
      fail('am-self-status', S.selfEmpty);
      return;
    }
    const events = (r: (typeof rows)[number]) => Number(r.total ?? r.count) || 0;
    rows.sort((a, b) => events(b) - events(a));
    document.getElementById('am-self-rows')!.replaceChildren(
      ...rows.map((r) => {
        const tr = document.createElement('tr');
        const action = document.createElement('td');
        action.append(document.createTextNode(`${S[firewallActionClass(r.action)]} `));
        const raw = document.createElement('span');
        raw.className = 'am-cc';
        raw.textContent = String(r.action);
        action.append(raw);
        tr.append(countryCell(String(r.country)), action, cell(formatNumber(events(r), locale), 'num'));
        return tr;
      }),
    );
    show('am-self');
    lazyGlobe('self', { countries: rows });
  }

  // ---------- Mundo: Cloudflare Radar, última hora (/api/radar-attacks) ----------
  async function loadWorld() {
    let data: any;
    try {
      data = await getJson('/api/radar-attacks');
    } catch {
      data = null;
    }
    const pairs: Pair[] = Array.isArray(data?.pairs) ? data.pairs : [];
    if (data?.ok !== true || pairs.length === 0) {
      fail('am-world-status', S.unavailable);
      return;
    }
    document.getElementById('am-pairs')!.replaceChildren(
      ...pairs.map(([origin, target, pct], i) => {
        const tr = document.createElement('tr');
        tr.append(cell(String(i + 1)), countryCell(origin), countryCell(target), cell(`${pctFmt.format(pct)} %`, 'num'));
        return tr;
      }),
    );
    const s = new Date(data.start);
    const e = new Date(data.end);
    if (!Number.isNaN(s.getTime()) && !Number.isNaN(e.getTime())) {
      // Hora local de quem vê, com o fuso no fim (ex.: "20:00–21:00 WET").
      document.getElementById('am-window')!.textContent = `${hourFmt.format(s)}–${hourZoneFmt.format(e)}`;
    }
    show('am-world');
    lazyGlobe('world', { pairs });
  }

  loadSelf();
  loadWorld();
</script>

<style>
  .am-badge {
    vertical-align: middle;
    font-size: 0.7rem;
    margin-left: 0.4rem;
  }
  .am-scope { margin-top: 0; }
  .am-figure {
    margin: 1.2rem 0 0;
    display: grid;
    gap: 0.8rem;
    justify-items: center;
  }
  .am-globe {
    width: 100%;
    max-width: 34rem;
    aspect-ratio: 1;
    touch-action: none;
    cursor: grab;
  }
  .am-globe:active { cursor: grabbing; }
  .am-caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    justify-content: center;
    align-items: center;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .am-legend { display: inline-flex; flex-wrap: wrap; gap: 0.4rem 1rem; }
  .am-legend > span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .am-sw {
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
  }
  .am-sw.origin, .am-sw.challenged { background: var(--accent-2); }
  .am-sw.target, .am-sw.allowed { background: var(--accent); }
  .am-sw.blocked { background: var(--danger); }
  .am-sw.ring { border: 2px solid var(--accent-2); }
  .am-controls { display: inline-flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; }
  .am-hint { margin: 0; }
  .am-h2 { margin-top: 2rem; }
  .am-table th { width: auto; }
  /* :global — as linhas são criadas pelo script, sem o atributo de scope. */
  .am-table :global(td) { word-break: normal; }
  .am-table :global(.num) { text-align: right; white-space: nowrap; }
  .am-table :global(.am-cc) { color: var(--muted); font-size: 0.78rem; }
  .am-hr { margin: 1.6rem 0 1.3rem; }
  #am-self-body[hidden], #am-world-body[hidden] { display: none; }
</style>
