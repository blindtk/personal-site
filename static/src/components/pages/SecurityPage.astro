---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL, type Lang } from '../../config';
import { t } from '../../i18n/ui';
import { routes } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t(lang);
const other: Lang = lang === 'pt' ? 'en' : 'pt';
const sec = dict.security;

// Host real (do SITE_URL) para os links dos scanners externos.
const host = new URL(SITE_URL).host;
const links = [
  { label: sec.securityTxtLabel, href: '/.well-known/security.txt' },
  { label: sec.headersScanLabel, href: `https://securityheaders.com/?q=${host}&followRedirects=on` },
  { label: sec.observatoryLabel, href: `https://developer.mozilla.org/en-US/observatory/analyze?host=${host}` },
];
---

<BaseLayout lang={lang} title={sec.metaTitle} altUrl={routes.security[other]} active="security">
  <div class="page-head">
    <h1>{sec.title}</h1>
    <p class="intro">{sec.intro}</p>
  </div>

  <div class="grid grid-2">
    {sec.measures.map((m) => (
      <div class="card">
        <h3>{m.name}</h3>
        <p>{m.desc}</p>
      </div>
    ))}
  </div>

  <section aria-labelledby="h-verify">
    <div class="section-title">
      <h2 id="h-verify">{sec.verifyTitle}</h2>
    </div>
    <p class="intro">{sec.verifyIntro}</p>
    <ul class="verify-links mono">
      {links.map((l) => (
        <li>
          <a href={l.href} rel="noopener">→ {l.label}</a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .verify-links {
    list-style: none;
    padding: 0;
    margin: 0.6rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .verify-links a {
    color: var(--accent);
    text-decoration: none;
  }
  .verify-links a:hover {
    text-decoration: underline;
  }
</style>
