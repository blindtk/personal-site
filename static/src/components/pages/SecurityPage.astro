---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SelfScan from '../tools/SelfScan.astro';
import Ticker from '../Ticker.astro';
import { SITE_URL, type Lang } from '../../config';
import { t } from '../../i18n/ui';
import { routes } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t(lang);
const other: Lang = lang === 'pt' ? 'en' : 'pt';
const sec = dict.security;

// Host real (do SITE_URL) para os links dos scanners externos.
const host = new URL(SITE_URL).host;
const scanners = [
  { label: sec.headersScanLabel, href: `https://securityheaders.com/?q=${host}&followRedirects=on` },
  { label: sec.observatoryLabel, href: `https://developer.mozilla.org/en-US/observatory/analyze?host=${host}` },
];
---

<BaseLayout lang={lang} title={sec.metaTitle} altUrl={routes.security[other]} active="security">
  <Ticker lang={lang} />
  <div class="page-head">
    <h1>{sec.title}</h1>
    <p class="intro">{sec.intro}</p>
  </div>

  <section aria-labelledby="h-threat">
    <div class="section-title">
      <h2 id="h-threat">{sec.threatTitle}</h2>
    </div>
    <p>{sec.threatBody}</p>
  </section>

  <section aria-labelledby="h-headers">
    <div class="section-title">
      <h2 id="h-headers">{sec.headersTitle}</h2>
    </div>
    <p class="intro">{sec.headersIntro}</p>
    <div class="table-scroll">
      <table class="result-table">
        <tbody>
          {sec.headers.map((h) => (
            <tr>
              <th class="mono">{h.name}</th>
              <td>{h.why}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="h-privacy">
    <div class="section-title">
      <h2 id="h-privacy">{sec.privacyTitle}</h2>
    </div>
    <p>{sec.privacyBody}</p>
  </section>

  <section aria-labelledby="h-report">
    <div class="section-title">
      <h2 id="h-report">{sec.reportTitle}</h2>
    </div>
    <p>{sec.reportBody}</p>
    <ul class="sec-links mono">
      <li><a href="/.well-known/security.txt" rel="noopener">→ {sec.securityTxtLabel}</a></li>
    </ul>
  </section>

  <section aria-labelledby="h-verify">
    <div class="section-title">
      <h2 id="h-verify">{sec.verifyTitle}</h2>
    </div>
    <p class="intro">{dict.selfscan.intro}</p>
    <SelfScan lang={lang} />
    <p class="intro scan-links-intro">{sec.verifyIntro}</p>
    <ul class="sec-links mono">
      {scanners.map((l) => (
        <li><a href={l.href} rel="noopener">→ {l.label}</a></li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="h-attack">
    <div class="section-title">
      <h2 id="h-attack">{sec.attackTitle}</h2>
    </div>
    <p>{sec.attackBody}</p>
    <ul class="sec-links mono">
      <li><a href={routes.attack[lang]}>{sec.attackCta}</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .sec-links {
    list-style: none;
    padding: 0;
    margin: 0.6rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .sec-links a {
    color: var(--accent);
    text-decoration: none;
  }
  .sec-links a:hover {
    text-decoration: underline;
  }
</style>
