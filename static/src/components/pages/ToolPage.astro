---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubnetCalc from '../tools/SubnetCalc.astro';
import HashTool from '../tools/HashTool.astro';
import EncoderTool from '../tools/EncoderTool.astro';
import PasswordGen from '../tools/PasswordGen.astro';
import EmailHeaderTool from '../tools/EmailHeaderTool.astro';
import ExifTool from '../tools/ExifTool.astro';
import PwnedCheck from '../tools/PwnedCheck.astro';
import SelfScan from '../tools/SelfScan.astro';
import CspLint from '../tools/CspLint.astro';
import Mirror from '../tools/Mirror.astro';
import PasskeyLab from '../tools/PasskeyLab.astro';
import { SITE_URL, type Lang } from '../../config';
import { t } from '../../i18n/ui';
import { routes, toolUrl } from '../../i18n/routes';

type ToolSlug = 'subnets' | 'hashes' | 'encoder' | 'passwords' | 'email-headers' | 'exif' | 'pwned' | 'self-scan' | 'csp' | 'mirror' | 'passkeys';

// 'server': fala com o Worker (dynamic/) — mostra serverNote em vez de
// clientSideNote no rodapé da página. Ver dynamic/PLAN.md.
const KIND: Record<ToolSlug, 'client' | 'server'> = {
  subnets: 'client',
  hashes: 'client',
  encoder: 'client',
  passwords: 'client',
  'email-headers': 'client',
  exif: 'client',
  pwned: 'server',
  'self-scan': 'server',
  csp: 'client',
  mirror: 'server',
  passkeys: 'client',
};

interface Props {
  lang: Lang;
  tool: ToolSlug;
}
const { lang, tool } = Astro.props;
const dict = t(lang);
const other: Lang = lang === 'pt' ? 'en' : 'pt';
const meta = dict.tools[tool];

const components = {
  subnets: SubnetCalc,
  hashes: HashTool,
  encoder: EncoderTool,
  passwords: PasswordGen,
  'email-headers': EmailHeaderTool,
  exif: ExifTool,
  pwned: PwnedCheck,
  'self-scan': SelfScan,
  csp: CspLint,
  mirror: Mirror,
  passkeys: PasskeyLab,
} as const;
const ToolComponent = components[tool];
const kind = KIND[tool];

// O texto de fallback do self-scan ("corre os scanners públicos abaixo")
// exige que os scanners estejam mesmo abaixo — os mesmos links da Segurança.
const host = new URL(SITE_URL).host;
const scanners =
  tool === 'self-scan'
    ? [
        { label: dict.evidence.verifyHeadersScan, href: `https://securityheaders.com/?q=${host}&followRedirects=on` },
        { label: dict.evidence.verifyObservatory, href: `https://developer.mozilla.org/en-US/observatory/analyze?host=${host}` },
      ]
    : [];
---

<BaseLayout
  lang={lang}
  title={meta.name}
  description={meta.desc}
  altUrl={toolUrl(other, tool)}
  active="tools"
>
  <div class="page-head">
    <h1>{meta.name}</h1>
    <p class="intro">{meta.desc}</p>
  </div>
  <ToolComponent lang={lang} />
  {scanners.length > 0 && (
    <ul class="tool-scanners mono">
      {scanners.map((l) => (
        <li><a href={l.href} rel="noopener">→ {l.label}</a></li>
      ))}
    </ul>
  )}
  <p class="note">{kind === 'server' ? `🛰️ ${dict.tools.serverNote}` : `🔒 ${dict.tools.clientSideNote}`}</p>
  <hr class="tool-hr" />
  <a href={routes.tools[lang]} class="mono">{dict.tools.back}</a>
</BaseLayout>

<style>
  .tool-scanners {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  /* Mesmo ritmo do <hr> + retorno das páginas de projeto. */
  .tool-hr {
    margin: 1.6rem 0 1.3rem;
  }
</style>
