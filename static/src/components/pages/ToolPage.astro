---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubnetCalc from '../tools/SubnetCalc.astro';
import HashTool from '../tools/HashTool.astro';
import EncoderTool from '../tools/EncoderTool.astro';
import PasswordGen from '../tools/PasswordGen.astro';
import type { Lang } from '../../config';
import { t } from '../../i18n/ui';
import { toolUrl } from '../../i18n/routes';

type ToolSlug = 'subnets' | 'hashes' | 'encoder' | 'passwords';

interface Props {
  lang: Lang;
  tool: ToolSlug;
}
const { lang, tool } = Astro.props;
const dict = t(lang);
const other: Lang = lang === 'pt' ? 'en' : 'pt';
const meta = dict.tools[tool];

const components = {
  subnets: SubnetCalc,
  hashes: HashTool,
  encoder: EncoderTool,
  passwords: PasswordGen,
} as const;
const ToolComponent = components[tool];
---

<BaseLayout
  lang={lang}
  title={meta.name}
  description={meta.desc}
  altUrl={toolUrl(other, tool)}
  active="tools"
>
  <div class="page-head">
    <h1>{meta.name}</h1>
    <p class="intro">{meta.desc}</p>
  </div>
  <ToolComponent lang={lang} />
  <p class="note">🔒 {dict.tools.clientSideNote}</p>
</BaseLayout>
