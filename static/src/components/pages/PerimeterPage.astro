---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tabs from '../site/Tabs.astro';
import Widget from '../site/Widget.astro';
import Skeleton from '../site/Skeleton.astro';
import HostMap from '../HostMap.astro';
import SiteLayers from '../SiteLayers.astro';
import Ticker from '../Ticker.astro';
import { API_BASE, type Lang } from '../../config';
import { t } from '../../i18n/ui';
import { routes, projectUrl } from '../../i18n/routes';
// content/ é a fonte de verdade (ver CLAUDE.md): o mapa path-isco → técnica e
// os nomes/táticas ATT&CK vêm daqui, os mesmos IDs que alimentam /attack.
import attack from '../../../../content/attack.json';
import hpAttack from '../../../../content/honeypot-attack.json';
// Regras Sigma por path-isco (tab Deteções, fundida aqui a partir da antiga
// página /detecoes/) — um teste no worker garante que paths/técnicas não
// divergem dos DECOYS reais.
import detections from '../../../../content/detections.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t(lang);
const p = dict.perimeter;
const s = dict.site;
const d = dict.detections;
const other: Lang = lang === 'pt' ? 'en' : 'pt';

const tabs = [
  { id: 'honeypot', label: p.tabHoneypot },
  { id: 'detections', label: p.tabDetections },
  { id: 'cloudflare', label: p.tabCloudflare },
  { id: 'trends', label: p.tabTrends },
  { id: 'logs', label: p.tabLogs },
];

// Índice id → nome da técnica (1.ª ocorrência), a partir do heatmap ATT&CK.
const techName = new Map<string, string>();
for (const tactic of attack.tactics) {
  for (const tech of tactic.techniques) {
    if (!techName.has(tech.id)) techName.set(tech.id, tech.name);
  }
}

// Deep-link para a entrada da técnica no heatmap, no idioma corrente.
const attackBase = routes.attack[lang];
type TechEntry = { id: string; name: string; href: string };
const byPath: Record<string, TechEntry> = {};
const byId: Record<string, TechEntry> = {};
for (const [path, id] of Object.entries(hpAttack.paths)) {
  const entry: TechEntry = { id, name: techName.get(id) ?? id, href: `${attackBase}#${id}` };
  byPath[path] = entry;
  byId[id] = entry;
}

// Regras Sigma (tab Deteções) — mesmo techName map do heatmap acima.
const rules = detections.rules.map((r) => ({
  path: r.path,
  slug: r.slug,
  technique: r.technique,
  techniqueName: techName.get(r.technique) ?? r.technique,
  title: r.title[lang],
  summary: r.summary[lang],
  sigma: r.sigma.join('\n'),
}));

const jsStrings = {
  // Honeypot (24h)
  corrTitle: p.corrTitle,
  techNone: p.techNone,
  verdict: p.verdict,
  // Deteções (copy-to-clipboard)
  detCopy: d.copy,
  detCopied: d.copied,
  // Cloudflare / Tendências / Logs — partilhadas com o antigo Analytics
  countriesEmpty: s.countriesEmpty,
  statusEmpty: s.statusEmpty,
  firewallEmpty: s.firewallEmpty,
  tiEmpty: s.tiEmpty,
  tiNoneYet: s.tiNoneYet,
  tiDays: s.tiDays,
  logsEmpty: s.logsEmpty,
  logsPageOf: s.logsPageOf,
  tlPeak: s.tlPeak,
  tlLast: s.tlLast,
  riskLowSample: s.riskLowSample,
  colCountry: s.logColCountry,
  colNetwork: s.logColAsn,
  colSource: s.colSource,
  colAction: s.colAction,
  colCount: s.colCount,
  sourceHoneypot: s.sourceHoneypot,
  sourceCloudflare: s.sourceCloudflare,
};
---

<BaseLayout lang={lang} title={p.metaTitle} altUrl={routes.perimeter[other]} active="perimeter" wide>
  <div class="page-head">
    <h1>{p.title}</h1>
    <p class="intro">{p.intro}</p>
  </div>

  <div
    id="perim-root"
    data-api={API_BASE}
    data-lang={lang}
    data-strings={JSON.stringify(jsStrings)}
    data-tech={JSON.stringify({ byPath, byId })}
  >
    <Tabs tabs={tabs} label={p.title}>
      <!-- ---------- Honeypot ---------- -->
      <div slot="honeypot">
        <p class="intro">{p.honeypotIntro}</p>

        <p class="hp-fallback" id="hp-fallback">{p.unavailable}</p>

        <div class="stats-grid" id="hp-stats" hidden>
          <div class="stat"><div class="n" id="hp-attempts">—</div><div class="l">{p.statAttempts}</div></div>
          <div class="stat amber"><div class="n mono" id="hp-toppath">—</div><div class="l">{p.statTopPath}</div></div>
          <div class="stat blue"><div class="n" id="hp-countries">—</div><div class="l">{p.statCountries}</div></div>
          <div class="stat"><div class="n" id="hp-firstscan">—</div><div class="l">{p.statFirstScan}</div></div>
        </div>

        <Ticker lang={lang} />
        <p class="hp-corr-banner" id="hp-corr" role="status" hidden><span class="hp-corr-spark" aria-hidden="true">⚡</span> {p.corrLead}</p>

        <HostMap lang={lang} />

        <p class="note">🧭 {p.techNote} <a href={attackBase}>{p.techNoteLink}</a></p>
        <p class="note">📐 {p.projectNote} <a href={projectUrl(lang, 'honeypot')}>{p.projectLink}</a></p>
        <p class="note warn">🔒 {p.privacyNote}</p>
      </div>

      <!-- ---------- Deteções (pipeline honeypot → Sigma) ---------- -->
      <div slot="detections">
        <p class="intro">{d.intro}</p>

        <section aria-labelledby="h-det-pipeline">
          <div class="section-title"><h2 id="h-det-pipeline">{d.pipelineTitle}</h2></div>
          <ol class="det-pipeline">
            {d.pipelineSteps.map((step, i) => (
              <li class="det-step">
                <span class="det-step-n mono" aria-hidden="true">{i + 1}</span>
                <div>
                  <h3>{step.t}</h3>
                  <p>{step.d}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="note">{d.liveNote}</p>
        </section>

        <section id="det-rules" aria-label={d.title}>
          {rules.map((r) => (
            <article class="det-card" id={r.slug}>
              <header class="det-head">
                <h2 class="det-title">{r.title}</h2>
                <div class="det-meta mono">
                  <span class="det-path">{r.path}</span>
                  <a class="det-tech" href={`${attackBase}#${r.technique}`} title={`${r.technique} · ${r.techniqueName}`}>
                    {r.technique}
                  </a>
                  <span class="det-hits" data-path={r.path}>
                    <span class="det-hits-n">—</span> {d.hits7d}
                  </span>
                </div>
              </header>
              <p class="det-summary">{r.summary}</p>
              <div class="det-rule">
                <pre class="det-sigma"><code>{r.sigma}</code></pre>
                <button class="det-copy mono" type="button" data-slug={r.slug} aria-live="polite" aria-atomic="true">{d.copy}</button>
              </div>
            </article>
          ))}
        </section>

        <section aria-label="sigma-cli">
          <p class="intro">{d.convertLead}</p>
          <pre class="det-cmd mono"><code>{d.convertCmd}</code></pre>
          <p class="note">→ <a href={attackBase}>{d.seeAttack}</a></p>
        </section>
      </div>

      <!-- ---------- Cloudflare (ameaças à zona) ---------- -->
      <div slot="cloudflare">
        <p class="hp-fallback" id="cf-fallback">{s.unavailable}</p>
        <div id="cf-body" hidden>
          <div class="metric-grid">
            <div class="stat amber"><div class="n" id="cf-threats">—</div><div class="l">{s.cardThreats}</div></div>
            <div class="stat amber"><div class="n" id="cf-blocked">—</div><div class="l">{s.cardBlocked}</div></div>
            <div class="stat"><div class="n" id="cf-challenges">—</div><div class="l">{s.cardChallenges}</div></div>
            <div class="stat amber"><div class="n" id="cf-threatrate">—</div><div class="l">{s.cardThreatRate}</div></div>
          </div>
          <div class="widget-grid an-mt">
            <Widget title={s.tlThreats} tone="warn" meta={s.windowNote} class="wide-widget">
              <div class="spark warn" id="cf-tl-threats"><Skeleton block /></div>
            </Widget>
          </div>
          <div class="widget-grid an-mt">
            <Widget title={s.wTopCountries} tone="warn" meta={s.windowNote}>
              <div id="cf-countries"><Skeleton rows={4} /></div>
            </Widget>
            <Widget title={s.wTopStatus} meta={s.windowNote}>
              <div id="cf-status"><Skeleton rows={4} /></div>
            </Widget>
          </div>
          <div class="widget-grid an-mt">
            <Widget title={s.tiRiskCountry} tone="warn" meta={s.windowNote} class="wide-widget">
              <div id="cf-risk"><Skeleton rows={4} /></div>
            </Widget>
          </div>
          <p class="note">{s.riskNote}</p>
          <div class="widget-grid an-mt">
            <Widget title={s.wFirewallPaths} tone="warn"><div id="cf-fw-paths"><Skeleton rows={4} /></div></Widget>
            <Widget title={s.wFirewallUserAgents} tone="warn"><div id="cf-fw-uas"><Skeleton rows={4} /></div></Widget>
            <Widget title={s.wFirewallAsns} tone="warn"><div id="cf-fw-asns"><Skeleton rows={4} /></div></Widget>
          </div>
          <p class="note">{s.planNote}</p>
          <p class="note">🛰️ {s.privacyNote}</p>
        </div>
      </div>

      <!-- ---------- Tendências (7d, honeypot + firewall acumulado) ---------- -->
      <div slot="trends">
        <p class="note">{s.tiIntro}</p>
        <p class="hp-fallback" id="ti-fallback">{s.tiEmpty}</p>
        <div id="ti-body" hidden>
          <div class="metric-grid">
            <div class="stat amber"><div class="n" id="ti-events">—</div><div class="l">{s.tiEvents7d}</div></div>
            <div class="stat blue"><div class="n" id="ti-countries">—</div><div class="l">{s.tiCountries7d}</div></div>
            <div class="stat blue"><div class="n" id="ti-asns">—</div><div class="l">{s.tiAsns7d}</div></div>
            <div class="stat"><div class="n" id="ti-peak">—</div><div class="l">{s.tiPeakHour}</div></div>
          </div>
          <div class="widget-grid an-mt">
            <Widget title={s.tiHeatmap} tone="warn" class="wide-widget">
              <div class="heatmap" id="ti-heatmap"></div>
              <div class="heatmap-axis mono" aria-hidden="true">
                <span>00h</span><span>06h</span><span>12h</span><span>18h</span><span>23h</span>
              </div>
              <div class="heatmap-legend">
                <span>{s.tiHeatLess}</span>
                <span class="swatch i1"></span><span class="swatch i2"></span>
                <span class="swatch i3"></span><span class="swatch i4"></span>
                <span>{s.tiHeatMore}</span>
              </div>
            </Widget>
            <Widget title={s.tiHours} tone="warn" class="wide-widget">
              <div class="hours-strip" id="ti-hours"></div>
            </Widget>
          </div>
          <div class="widget-grid an-mt">
            <Widget title={s.tiNewAttackers} tone="warn"><div id="ti-newatk"></div></Widget>
            <Widget title={s.tiRecurring} tone="warn"><div id="ti-recatk"></div></Widget>
          </div>
          <div class="widget-grid an-mt">
            <Widget title={s.tiTechniques}><div id="ti-tech"></div></Widget>
            <Widget title={s.tiTopPaths}><div id="ti-toppaths"></div></Widget>
          </div>
          <div class="widget-grid an-mt">
            <Widget title={s.tiFirewallAction} tone="warn" meta={s.windowNote}><div id="ti-fwaction"></div></Widget>
            <Widget title={s.tiFirewallSource} tone="warn" meta={s.windowNote}><div id="ti-fwsource"></div></Widget>
          </div>
          <div class="widget-grid an-mt">
            <Widget title={s.tiCountriesMerged} tone="warn" meta={s.windowNote} class="wide-widget">
              <div id="ti-countries"></div>
            </Widget>
          </div>
          <div class="widget-grid an-mt">
            <Widget title={s.tiAsnsMerged} tone="warn" meta={s.windowNote} class="wide-widget">
              <div id="ti-networks"></div>
            </Widget>
          </div>
          <p class="note">🛰️ {s.privacyNote}</p>
        </div>
      </div>

      <!-- ---------- Logs (tabela pesquisável, sem IP) ---------- -->
      <div slot="logs">
        <p class="note">{s.logsIntro}</p>
        <div class="logs-toolbar">
          <input type="search" id="logs-search" class="logs-search" placeholder={s.logsSearch} aria-label={s.logsSearch} autocomplete="off" />
        </div>
        <p class="hp-fallback" id="logs-fallback">{s.tiEmpty}</p>
        <div class="table-scroll" id="logs-tablewrap" hidden tabindex="0" role="region" aria-label={p.tabLogs}>
          <table class="result-table wrap-normal hp-table">
            <thead>
              <tr>
                <th>{s.logColWhen}</th>
                <th>{s.logColCountry}</th>
                <th>{s.logColAsn}</th>
                <th>{s.logColPath}</th>
                <th>{s.logColTechnique}</th>
                <th>{s.logColVerdict}</th>
              </tr>
            </thead>
            <tbody id="logs-rows"></tbody>
          </table>
        </div>
        <div class="logs-pager" id="logs-pager" hidden>
          <button type="button" id="logs-prev" class="pager-btn">{s.logsPrev}</button>
          <span id="logs-count" class="mono"></span>
          <button type="button" id="logs-next" class="pager-btn">{s.logsNext}</button>
        </div>
        <p class="note">🛰️ {s.privacyNote}</p>
      </div>
    </Tabs>
  </div>

  <SiteLayers lang={lang} current="perimeter" />
</BaseLayout>

<script>
  import { formatNumber, formatBytes, formatPercent, threatRate, withBars, sparkPath } from '../../scripts/observability.js';

  const root = document.getElementById('perim-root')!;
  const base = root.dataset.api ?? '';
  const locale = root.dataset.lang === 'pt' ? 'pt-PT' : 'en-GB';
  const S = JSON.parse(root.dataset.strings ?? '{}');
  // { byPath: {path:{id,name,href}}, byId: {id:{id,name,href}} } — estático,
  // vindo de content/honeypot-attack.json + content/attack.json.
  const TECH = JSON.parse(root.dataset.tech!) as {
    byPath: Record<string, { id: string; name: string; href: string }>;
    byId: Record<string, { id: string; name: string; href: string }>;
  };

  const setText = (id: string, value: string) => {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
  };

  // Técnica de um evento: preferir a que o Worker anexou; senão, lookup local
  // por path (mesma fonte de dados — belt and suspenders). Eventos antigos
  // sem `technique` gravado degradam para o lookup por path.
  function techOf(ev: any) {
    const id = ev?.technique ?? TECH.byPath[ev?.path]?.id ?? null;
    return id ? (TECH.byId[id] ?? TECH.byPath[ev?.path] ?? null) : null;
  }

  type Correlation = { active: Set<string>; cve: Record<string, string> };

  // Técnicas atualmente exploradas (ticker CISA KEV/NVD). Nunca rejeita: se o
  // ticker falhar, a correlação simplesmente não acende (degradação graciosa).
  // Uma só busca, partilhada pelo banner do Honeypot e pelos Logs.
  let corrPromise: Promise<Correlation> | null = null;
  function tickerCorrelation(): Promise<Correlation> {
    if (corrPromise) return corrPromise;
    corrPromise = (async () => {
      const corr: Correlation = { active: new Set(), cve: {} };
      try {
        const res = await fetch(`${base}/api/ticker`, { headers: { accept: 'application/json' } });
        const ctype = res.headers.get('content-type') ?? '';
        if (!res.ok || !ctype.includes('application/json')) return corr;
        const data = await res.json();
        for (const item of Array.isArray(data.items) ? data.items : []) {
          for (const tid of Array.isArray(item.techniques) ? item.techniques : []) {
            corr.active.add(tid);
            if (!corr.cve[tid]) corr.cve[tid] = item.id;
          }
        }
      } catch {
        /* sem ticker: correlação vazia */
      }
      return corr;
    })();
    return corrPromise;
  }

  // Célula da técnica (link para /attack#<id>). Se a técnica estiver a ser
  // explorada agora (aparece no ticker CISA KEV), marca a linha e junta um
  // selo ligado ao CVE — o cruzamento que junta honeypot + ATT&CK + ticker.
  function techCell(ev: any, tr: HTMLTableRowElement, corr: Correlation): { td: HTMLTableCellElement; correlated: boolean } {
    const td = document.createElement('td');
    td.className = 'hp-tech';
    const meta = techOf(ev);
    if (!meta) {
      td.textContent = S.techNone;
      return { td, correlated: false };
    }
    const link = document.createElement('a');
    link.href = meta.href;
    link.className = 'mono hp-tech-id';
    link.textContent = meta.id;
    link.title = `${meta.id} · ${meta.name}`;
    td.append(link);

    const correlated = corr.active.has(meta.id);
    if (correlated) {
      tr.classList.add('hp-corr-row');
      const cve = corr.cve[meta.id];
      const badge = document.createElement('a');
      badge.className = 'hp-corr-badge mono';
      badge.href = `https://nvd.nist.gov/vuln/detail/${encodeURIComponent(cve)}`;
      badge.rel = 'noopener';
      badge.textContent = `⚡ ${cve}`;
      badge.title = `${S.corrTitle}: ${cve}`;
      td.append(document.createTextNode(' '), badge);
    }
    return { td, correlated };
  }

  // ---------- Honeypot (24h) ----------
  function fmtDuration(sec: number | null): string {
    if (sec === null || sec === undefined) return '—';
    if (sec < 60) return `${sec}s`;
    if (sec < 3600) return `${Math.floor(sec / 60)}m ${sec % 60}s`;
    return `${Math.floor(sec / 3600)}h ${Math.floor((sec % 3600) / 60)}m`;
  }

  async function loadHoneypot() {
    const fallbackEl = document.getElementById('hp-fallback')!;
    const corrEl = document.getElementById('hp-corr')!;
    try {
      const [res, corr] = await Promise.all([
        fetch(`${base}/api/honeypot`, { headers: { accept: 'application/json' } }),
        tickerCorrelation(),
      ]);
      const ctype = res.headers.get('content-type') ?? '';
      if (!res.ok || !ctype.includes('application/json')) throw new Error('no api');
      const data = await res.json();
      setText('hp-attempts', String(data.attempts24h ?? 0));
      setText('hp-toppath', data.topPath ?? '—');
      setText('hp-countries', String(data.countryCount ?? 0));
      setText('hp-firstscan', fmtDuration(data.timeToFirstScanSec));
      const recent = Array.isArray(data.recent) ? data.recent : [];
      corrEl.hidden = !recent.some((ev: any) => {
        const meta = techOf(ev);
        return meta && corr.active.has(meta.id);
      });
      fallbackEl.hidden = true;
      document.getElementById('hp-stats')!.hidden = false;

      // Contadores da tab Deteções — mesma resposta /api/honeypot, campo
      // paths7d (evita um 2.º pedido só para a tab de regras Sigma).
      const detCounts = new Map<string, number>(
        (Array.isArray(data.paths7d) ? data.paths7d : []).map((row: any) => [String(row.path), Number(row.count) || 0]),
      );
      for (const el of document.querySelectorAll<HTMLElement>('.det-hits')) {
        const n = el.querySelector('.det-hits-n');
        if (n) n.textContent = String(detCounts.get(el.dataset.path ?? '') ?? 0);
      }
    } catch {
      // Sem Worker publicado: fica o fallback já pintado (evita CLS).
    }
  }

  // ---------- Deteções: copiar regra Sigma ----------
  function wireDetCopy() {
    for (const btn of document.querySelectorAll<HTMLButtonElement>('.det-copy')) {
      btn.addEventListener('click', async () => {
        const code = btn.closest('.det-rule')?.querySelector('code');
        if (!code) return;
        try {
          await navigator.clipboard.writeText(code.textContent ?? '');
          btn.textContent = S.detCopied;
          setTimeout(() => { btn.textContent = S.detCopy; }, 1600);
        } catch {
          // clipboard indisponível (permissões/contexto): o texto continua
          // selecionável à mão no <pre>.
        }
      });
    }
  }

  // ---------- Barras horizontais / sparklines (mesma lógica do antigo Analytics) ----------
  function renderBars(
    id: string,
    rows: { label: string; value: number; tone?: string; display?: string }[],
    empty: string,
  ) {
    const host = document.getElementById(id);
    if (!host) return;
    host.replaceChildren();
    if (rows.length === 0) {
      const el = document.createElement('p');
      el.className = 'note';
      el.textContent = empty;
      host.append(el);
      return;
    }
    const list = document.createElement('div');
    list.className = 'bar-list';
    for (const row of withBars(rows)) {
      const r = document.createElement('div');
      r.className = 'bar-row';
      const head = document.createElement('div');
      head.className = 'bar-head';
      const label = document.createElement('span');
      label.className = 'bar-label';
      label.textContent = row.label;
      const val = document.createElement('span');
      val.className = 'bar-val';
      val.textContent = (row as any).display ?? formatNumber(row.value, locale);
      head.append(label, val);
      const track = document.createElement('div');
      track.className = 'bar-track';
      const fill = document.createElement('div');
      fill.className = row.tone ? `bar-fill ${row.tone}` : 'bar-fill';
      fill.style.width = `${(row as any).pct}%`;
      track.append(fill);
      r.append(head, track);
      list.append(r);
    }
    host.append(list);
  }

  const bars = (rows: any[], keyField: string, valField: string, tone?: string) =>
    rows.map((r) => ({ label: String(r[keyField]), value: Number(r[valField]) || 0, tone }));

  // Países/redes do honeypot (URLs-isco, definição estrita de "atacante") e
  // do firewall da Cloudflare (toda a zona, inclui ações benignas como
  // "skip") são universos diferentes — nunca somar as contagens. Mostra os
  // dois lado a lado, com uma coluna de fonte, em vez de widgets separados
  // que pareciam contradizer-se (ex.: honeypot diz "1 país", firewall lista 4).
  type SourceRow = { key: string; source: 'honeypot' | 'cloudflare'; count: number; action?: string | null };
  function renderSourceTable(id: string, headers: string[], rows: SourceRow[], withAction: boolean, empty: string) {
    const host = document.getElementById(id);
    if (!host) return;
    host.replaceChildren();
    if (rows.length === 0) {
      const el = document.createElement('p');
      el.className = 'note';
      el.textContent = empty;
      host.append(el);
      return;
    }
    const wrap = document.createElement('div');
    wrap.className = 'table-scroll';
    const table = document.createElement('table');
    table.className = 'result-table wrap-normal';
    const thead = document.createElement('thead');
    const headRow = document.createElement('tr');
    for (const label of headers) {
      const th = document.createElement('th');
      th.textContent = label;
      headRow.append(th);
    }
    thead.append(headRow);
    const tbody = document.createElement('tbody');
    for (const r of rows) {
      const tr = document.createElement('tr');
      const tdKey = document.createElement('td');
      tdKey.textContent = r.key;
      const tdSource = document.createElement('td');
      tdSource.textContent = r.source === 'honeypot' ? S.sourceHoneypot : S.sourceCloudflare;
      tr.append(tdKey, tdSource);
      if (withAction) {
        const tdAction = document.createElement('td');
        tdAction.textContent = r.action ?? '—';
        tr.append(tdAction);
      }
      const tdCount = document.createElement('td');
      tdCount.textContent = formatNumber(r.count, locale);
      tr.append(tdCount);
      tbody.append(tr);
    }
    table.append(thead, tbody);
    wrap.append(table);
    host.append(wrap);
  }

  const SVG_NS = 'http://www.w3.org/2000/svg';
  function renderSpark(id: string, series: any[], valueKey: string) {
    const host = document.getElementById(id);
    if (!host) return;
    host.replaceChildren();
    const values = series.map((d) => Number(d?.[valueKey]) || 0);
    if (values.length === 0) {
      const el = document.createElement('p');
      el.className = 'note';
      el.textContent = S.tiNoneYet;
      host.append(el);
      return;
    }
    const { line, area, max } = sparkPath(values);
    const svg = document.createElementNS(SVG_NS, 'svg');
    svg.setAttribute('class', 'spark-svg');
    svg.setAttribute('viewBox', '0 0 100 30');
    svg.setAttribute('preserveAspectRatio', 'none');
    svg.setAttribute('role', 'img');
    const areaEl = document.createElementNS(SVG_NS, 'path');
    areaEl.setAttribute('class', 'spark-area');
    areaEl.setAttribute('d', area);
    const lineEl = document.createElementNS(SVG_NS, 'path');
    lineEl.setAttribute('class', 'spark-line');
    lineEl.setAttribute('d', line);
    lineEl.setAttribute('vector-effect', 'non-scaling-stroke');
    svg.append(areaEl, lineEl);
    host.append(svg);
    const cap = document.createElement('div');
    cap.className = 'spark-cap';
    const last = document.createElement('span');
    last.textContent = `${S.tlLast}: ${formatNumber(values[values.length - 1], locale)}`;
    const peak = document.createElement('span');
    peak.textContent = `${S.tlPeak}: ${formatNumber(max, locale)}`;
    cap.append(last, peak);
    host.append(cap);
  }

  // ---------- Cloudflare (ameaças à zona, /api/cf-stats) ----------
  async function loadCfThreats() {
    try {
      const res = await fetch(`${base}/api/cf-stats`, { headers: { accept: 'application/json' } });
      const ctype = res.headers.get('content-type') ?? '';
      if (!res.ok || !ctype.includes('application/json')) throw new Error('no api');
      const zone = (await res.json()).zone ?? {};

      const requests = Number(zone.requests ?? 0);
      const threats = Number(zone.threats ?? 0);
      const blocked = (zone.blockedByStatus ?? []).reduce((a: number, r: any) => a + (Number(r.count) || 0), 0);
      const challenges = (zone.firewallByAction ?? [])
        .filter((r: any) => String(r.key).includes('challenge'))
        .reduce((a: number, r: any) => a + (Number(r.count) || 0), 0);

      setText('cf-threats', formatNumber(threats, locale));
      setText('cf-blocked', formatNumber(blocked, locale));
      setText('cf-challenges', formatNumber(challenges, locale));
      setText('cf-threatrate', formatPercent(threatRate(threats, requests)));

      renderBars('cf-countries', bars(zone.topCountries ?? [], 'country', 'threats', 'warn'), S.countriesEmpty);
      renderBars('cf-status', bars(zone.blockedByStatus ?? [], 'key', 'count'), S.statusEmpty);
      renderBars(
        'cf-risk',
        (zone.riskByCountry ?? []).map((r: any) => {
          const rate = Number(r.rate) || 0;
          const lowSample = !!r.lowSample;
          const raw = `${formatNumber(r.threats, locale)}/${formatNumber(r.requests, locale)}`;
          return {
            label: String(r.country),
            value: rate,
            // Amostra pequena não pinta como alarme (down/warn) mesmo com
            // taxa alta — o rácio não é fiável abaixo do limiar (ver riskNote).
            tone: lowSample ? undefined : rate >= 0.5 ? 'down' : rate >= 0.2 ? 'warn' : undefined,
            display: lowSample
              ? `${formatPercent(rate)} (${raw} · ${S.riskLowSample})`
              : `${formatPercent(rate)} (${raw})`,
          };
        }),
        S.tiNoneYet,
      );

      // Detalhe por URL/user-agent/ASN (firewall, 24h) — vem do dataset CRU
      // firewallEventsAdaptive (ver planNote): nunca IP, mesmo esse campo
      // estando disponível na fonte.
      renderBars('cf-fw-paths', bars(zone.firewallByPath ?? [], 'key', 'count', 'warn'), S.firewallEmpty);
      renderBars('cf-fw-uas', bars(zone.firewallByUserAgent ?? [], 'key', 'count', 'warn'), S.firewallEmpty);
      renderBars('cf-fw-asns', bars(zone.firewallByAsn ?? [], 'key', 'count', 'warn'), S.firewallEmpty);

      const series = Array.isArray(zone.series) ? zone.series : [];
      renderSpark('cf-tl-threats', series, 'threats');

      document.getElementById('cf-fallback')!.hidden = true;
      document.getElementById('cf-body')!.hidden = false;
    } catch {
      // Sem Worker: fica o fallback já pintado.
    }
  }

  // ---------- Tendências 7d (honeypot + firewall acumulado, /api/threat-intel) ----------
  function renderHeatmap(rows: { date: string; hours: number[] }[]) {
    const host = document.getElementById('ti-heatmap');
    if (!host) return;
    host.replaceChildren();
    let max = 0;
    for (const r of rows) for (const c of r.hours) if (c > max) max = c;
    for (const r of rows) {
      const rowEl = document.createElement('div');
      rowEl.className = 'heatmap-row';
      const label = document.createElement('span');
      label.className = 'heat-label';
      label.textContent = r.date.slice(5); // MM-DD
      rowEl.append(label);
      r.hours.forEach((count, hour) => {
        const cell = document.createElement('span');
        cell.className = 'heat-cell';
        const intensity = max > 0 ? count / max : 0;
        if (count > 0) cell.style.backgroundColor = `rgba(61, 220, 132, ${(0.15 + intensity * 0.85).toFixed(3)})`;
        cell.title = `${r.date} ${String(hour).padStart(2, '0')}h · ${count}`;
        rowEl.append(cell);
      });
      host.append(rowEl);
    }
  }

  function renderHours(hours: number[]) {
    const host = document.getElementById('ti-hours');
    if (!host) return;
    host.replaceChildren();
    const max = hours.reduce((m, v) => Math.max(m, v), 0);
    hours.forEach((count, hour) => {
      const bar = document.createElement('span');
      bar.className = 'hour-bar';
      bar.style.height = `${max > 0 && count > 0 ? Math.max(3, Math.round((count / max) * 54)) : 2}px`;
      bar.title = `${String(hour).padStart(2, '0')}h · ${count}`;
      host.append(bar);
    });
  }

  // Logs: estado de pesquisa + paginação (client-side sobre até 200 eventos).
  const timeFmt = new Intl.DateTimeFormat(undefined, {
    day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit',
  });
  let logEvents: any[] = [];
  let logCorr: Correlation = { active: new Set(), cve: {} };
  let logPage = 0;
  const LOG_PAGE = 25;

  function filteredEvents(): any[] {
    const q = (document.getElementById('logs-search') as HTMLInputElement | null)?.value.trim().toLowerCase() ?? '';
    if (!q) return logEvents;
    return logEvents.filter((e) => {
      const hay = `${e.country ?? ''} ${e.asn ? 'as' + e.asn : ''} ${e.path ?? ''} ${e.technique ?? ''}`.toLowerCase();
      return hay.includes(q);
    });
  }

  function renderLogsPage() {
    const rowsEl = document.getElementById('logs-rows');
    if (!rowsEl) return;
    const list = filteredEvents();
    const pages = Math.max(1, Math.ceil(list.length / LOG_PAGE));
    if (logPage >= pages) logPage = pages - 1;
    rowsEl.replaceChildren();
    const slice = list.slice(logPage * LOG_PAGE, logPage * LOG_PAGE + LOG_PAGE);
    if (slice.length === 0) {
      const tr = document.createElement('tr');
      const td = document.createElement('td');
      td.colSpan = 6;
      td.className = 'hp-loading';
      td.textContent = S.logsEmpty;
      tr.append(td);
      rowsEl.append(tr);
    }
    for (const e of slice) {
      const tr = document.createElement('tr');
      const cells = [
        timeFmt.format(new Date(e.ts)),
        e.country ?? 'XX',
        e.asn ? `AS${e.asn}` : '—',
        e.path ?? '',
      ];
      cells.forEach((value, i) => {
        const td = document.createElement('td');
        td.textContent = value;
        if (i === 1) td.className = 'mono hp-cc';
        if (i === 3) td.className = 'mono hp-path';
        tr.append(td);
      });
      const { td } = techCell(e, tr, logCorr);
      tr.append(td);
      const verdict = document.createElement('td');
      verdict.className = 'hp-verdict';
      verdict.textContent = S.verdict;
      tr.append(verdict);
      rowsEl.append(tr);
    }
    setText('logs-count', `${list.length ? logPage + 1 : 0} ${S.logsPageOf} ${pages}`);
    (document.getElementById('logs-prev') as HTMLButtonElement).disabled = logPage <= 0;
    (document.getElementById('logs-next') as HTMLButtonElement).disabled = logPage >= pages - 1;
  }

  function wireLogs() {
    document.getElementById('logs-search')?.addEventListener('input', () => { logPage = 0; renderLogsPage(); });
    document.getElementById('logs-prev')?.addEventListener('click', () => { if (logPage > 0) { logPage--; renderLogsPage(); } });
    document.getElementById('logs-next')?.addEventListener('click', () => { logPage++; renderLogsPage(); });
  }

  async function loadThreatIntel() {
    try {
      const [res, corr] = await Promise.all([
        fetch(`${base}/api/threat-intel`, { headers: { accept: 'application/json' } }),
        tickerCorrelation(),
      ]);
      const ctype = res.headers.get('content-type') ?? '';
      if (!res.ok || !ctype.includes('application/json')) throw new Error('no api');
      const d = await res.json();
      const totals = d.totals ?? {};

      setText('ti-events', formatNumber(totals.events7d ?? 0, locale));
      setText('ti-countries', formatNumber(totals.countries7d ?? 0, locale));
      setText('ti-asns', formatNumber(totals.asns7d ?? 0, locale));
      setText('ti-peak', d.peakHour ? `${String(d.peakHour.hour).padStart(2, '0')}h` : '—');

      renderHeatmap(Array.isArray(d.heatmap) ? d.heatmap : []);
      renderHours(Array.isArray(d.byHourOfDay) ? d.byHourOfDay : []);
      renderBars('ti-newatk', bars(d.newAttackers ?? [], 'key', 'count', 'warn'), S.tiNoneYet);
      renderBars(
        'ti-recatk',
        (d.recurringAttackers ?? []).map((r: any) => ({
          label: String(r.key),
          value: Number(r.count) || 0,
          tone: 'warn',
          display: `${formatNumber(r.count, locale)} · ${r.days} ${S.tiDays}`,
        })),
        S.tiNoneYet,
      );
      renderBars('ti-tech', bars(d.topTechniques ?? [], 'key', 'count'), S.tiEmpty);
      renderBars('ti-toppaths', bars(d.topPaths ?? [], 'key', 'count'), S.tiEmpty);
      const fw = d.firewall7d ?? {};
      renderBars('ti-fwaction', bars(fw.byAction ?? [], 'key', 'count', 'warn'), S.firewallEmpty);
      renderBars('ti-fwsource', bars(fw.bySource ?? [], 'key', 'count', 'warn'), S.firewallEmpty);
      renderSourceTable(
        'ti-countries',
        [S.colCountry, S.colSource, S.colAction, S.colCount],
        [
          ...(d.topCountries ?? []).map((r: any): SourceRow => ({
            key: String(r.key), source: 'honeypot', count: Number(r.count) || 0,
          })),
          ...(fw.byCountry ?? []).map((r: any): SourceRow => ({
            key: String(r.country), source: 'cloudflare', count: Number(r.count) || 0, action: String(r.action ?? '—'),
          })),
        ].sort((a, b) => b.count - a.count),
        true,
        S.tiEmpty,
      );
      renderSourceTable(
        'ti-networks',
        [S.colNetwork, S.colSource, S.colCount],
        [
          ...(d.topAsns ?? []).map((r: any): SourceRow => ({
            key: String(r.key), source: 'honeypot', count: Number(r.count) || 0,
          })),
          ...(fw.byAsn ?? []).map((r: any): SourceRow => ({
            key: String(r.key), source: 'cloudflare', count: Number(r.count) || 0,
          })),
        ].sort((a, b) => b.count - a.count),
        false,
        S.tiEmpty,
      );

      document.getElementById('ti-fallback')!.hidden = true;
      document.getElementById('ti-body')!.hidden = false;

      // Logs
      logEvents = Array.isArray(d.events) ? d.events : [];
      logCorr = corr;
      if (logEvents.length > 0) {
        document.getElementById('logs-fallback')!.hidden = true;
        document.getElementById('logs-tablewrap')!.hidden = false;
        document.getElementById('logs-pager')!.hidden = false;
        renderLogsPage();
      }
    } catch {
      // Sem Worker/dados: ficam os fallbacks já pintados.
    }
  }

  // Lazy-load: a Threat Intel faz uma leitura pesada (168 buckets horários no
  // Worker) — só se busca quando a tab Tendências ou Logs é aberta pela
  // primeira vez, não à carga da página.
  let tiLoaded = false;
  function ensureThreatIntel() {
    if (tiLoaded) return;
    tiLoaded = true;
    loadThreatIntel();
  }
  for (const tab of document.querySelectorAll('[data-tab="trends"], [data-tab="logs"]')) {
    tab.addEventListener('click', ensureThreatIntel);
  }
  // Cloudflare também é best-effort e só se busca quando a tab abre — evita
  // um pedido à API da Cloudflare em toda a visita ao Perímetro.
  let cfLoaded = false;
  function ensureCf() {
    if (cfLoaded) return;
    cfLoaded = true;
    loadCfThreats();
  }
  for (const tab of document.querySelectorAll('[data-tab="cloudflare"]')) {
    tab.addEventListener('click', ensureCf);
  }

  wireLogs();
  wireDetCopy();
  loadHoneypot();
</script>

<style>
  .an-mt { margin-top: 0.9rem; }
  .wide-widget { grid-column: 1 / -1; }

  /* Logs: toolbar + paginação (mesmo padrão do antigo Analytics) */
  .logs-toolbar { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 0.7rem; }
  .logs-search {
    flex: 1;
    min-width: 12rem;
    background: var(--bg-raise-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font: inherit;
    font-size: 0.85rem;
    padding: 0.5rem 0.7rem;
  }
  .logs-search:focus-visible { outline: 2px solid var(--accent-3); outline-offset: 1px; }
  .logs-pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 0.7rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .pager-btn {
    appearance: none;
    background: var(--bg-raise-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font: inherit;
    font-size: 0.8rem;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
  }
  .pager-btn:hover:not(:disabled) { border-color: var(--accent); }
  .pager-btn:disabled { opacity: 0.4; cursor: default; }

  /* ---------- Deteções (fundida de /detecoes/) ---------- */
  .det-pipeline {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.8rem;
  }
  @media (min-width: 720px) {
    .det-pipeline { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .det-step {
    display: flex;
    gap: 0.8rem;
    background: var(--bg-raise);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.1rem;
  }
  .det-step-n {
    color: var(--accent);
    font-size: 1.4rem;
    line-height: 1;
  }
  .det-step h3 {
    margin: 0 0 0.3rem;
    font-size: 0.95rem;
  }
  .det-step p {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .det-card {
    background: var(--bg-raise);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.2rem;
    margin: 1.2rem 0 0;
  }
  .det-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }
  .det-title {
    margin: 0;
    font-size: 1.05rem;
    flex: 1 1 16rem;
  }
  .det-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.8rem;
  }
  .det-path {
    color: var(--accent-2);
    overflow-wrap: anywhere;
  }
  .det-tech {
    color: var(--accent-3);
    text-decoration: none;
  }
  .det-tech:hover { text-decoration: underline; }
  .det-hits {
    color: var(--muted);
    white-space: nowrap;
  }
  .det-hits-n { color: var(--accent); }
  .det-summary {
    color: var(--muted);
    margin: 0.7rem 0 0.9rem;
    font-size: 0.9rem;
  }
  .det-rule { position: relative; }
  .det-sigma {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.9rem 1rem;
    overflow-x: auto;
    margin: 0;
  }
  .det-sigma code {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--text);
    white-space: pre;
  }
  .det-copy {
    /* inline-flex + min-height: alvo de toque de 44px, mesma técnica do
       .btn.small global — esta classe é local e não herdava dessa correção. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    background: var(--bg-raise-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    color: var(--accent);
    font-size: 0.72rem;
    padding: 0.3rem 0.6rem;
    cursor: pointer;
  }
  .det-copy:hover { border-color: var(--accent); }

  /* Em mobile o .det-copy a 44px (alvo de toque) passava a tapar as
     primeiras linhas do Sigma (title/id) em regras mais longas — o botão
     sai do fluxo absoluto e desce para debaixo do código, sem alterar
     nada no desktop. */
  @media (max-width: 640px) {
    .det-rule {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .det-copy {
      position: static;
      align-self: flex-end;
    }
  }

  .det-cmd {
    background: var(--bg-raise);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.7rem 0.9rem;
    overflow-x: auto;
    margin: 0.6rem 0 0.8rem;
  }
  .det-cmd code {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.85rem;
    color: var(--accent);
    white-space: pre;
  }
</style>
