      tdCount.textContent = formatNumber(r.count, locale);
      tr.append(tdCount);
      tbody.append(tr);
    }
    table.append(thead, tbody);
    wrap.append(table);
    host.append(wrap);
  }

  // ---------- Cadeia do perímetro (D1, sempre visível acima das tabs) ----------
  // Combina três respostas: cf-stats (pedidos/ameaças da zona), threat-intel
  // (firewall7d.byAction para a soma bloqueado+desafiado — a MESMA
  // classificação e os MESMOS 7 dias que alimentam as barras "Firewall por
  // ação" e o gráfico "Mitigação por dia", para os números nunca se
  // contradizerem entre painéis — e totals.events7d para o honeypot).
  // Preenche-se só quando as duas chegam; nenhuma delas é obrigatória para
  // as respetivas tabs continuarem a funcionar sozinhas.
  let chainZone: any = null;
  let chainFw: any = null;
  let chainEvents7d: number | null = null;

  function renderChain() {
    if (!chainZone || !chainFw || chainEvents7d === null) return;
    const requests = Number(chainZone.requests) || 0;
    const threats = Number(chainZone.threats) || 0;
    setText('chain-requests', formatNumber(requests, locale));
    setText('chain-threats', formatNumber(threats, locale));
    setText('chain-threats-l', `${S.chainThreats} (${formatPercent(threatRate(threats, requests))})`);
    setText('chain-mitigated', formatNumber(sumByActionClass(chainFw.byAction ?? [], ['blocked', 'challenged']), locale));
    setText('chain-honeypot', formatNumber(chainEvents7d, locale));
  }

  const SVG_NS = 'http://www.w3.org/2000/svg';
  function renderSpark(id: string, series: any[], valueKey: string) {
    const host = document.getElementById(id);
    if (!host) return;
    host.replaceChildren();
    const values = series.map((d) => Number(d?.[valueKey]) || 0);
    if (values.length === 0) {
      const el = document.createElement('p');
      el.className = 'note';
      el.textContent = S.tiNoneYet;
      host.append(el);
      return;
    }
    const { line, area, max } = sparkPath(values);
    const svg = document.createElementNS(SVG_NS, 'svg');
    svg.setAttribute('class', 'spark-svg');
    svg.setAttribute('viewBox', '0 0 100 30');
    svg.setAttribute('preserveAspectRatio', 'none');
    svg.setAttribute('role', 'img');
    const areaEl = document.createElementNS(SVG_NS, 'path');
    areaEl.setAttribute('class', 'spark-area');
    areaEl.setAttribute('d', area);
    const lineEl = document.createElementNS(SVG_NS, 'path');
    lineEl.setAttribute('class', 'spark-line');
    lineEl.setAttribute('d', line);
    lineEl.setAttribute('vector-effect', 'non-scaling-stroke');
    svg.append(areaEl, lineEl);
    host.append(svg);
    const cap = document.createElement('div');
    cap.className = 'spark-cap';
    const last = document.createElement('span');
    last.textContent = `${S.tlLast}: ${formatNumber(values[values.length - 1], locale)}`;
    const peak = document.createElement('span');
    peak.textContent = `${S.tlPeak}: ${formatNumber(max, locale)}`;
    cap.append(last, peak);
    host.append(cap);
  }

  // ---------- Risco por país: dispersão pedidos × taxa (D3) ----------
  // Substitui a antiga lista de barras: aí ES a 96,9% (127 pedidos) e GB a
  // 100% (1 pedido) apareciam quase lado a lado, e uma nota de 5 linhas
  // explicava porque não se comparavam. Num gráfico de dispersão a diferença
  // de amostra é o eixo horizontal — não precisa de ser explicada em texto.
  type RiskPoint = { x: number; y: number; r: number; row: any };

  function riskDotClass(row: any): string {
    if (row.lowSample) return 'sample';
    const rate = Number(row.rate) || 0;
    if (rate >= 0.5) return 'high';
    if (rate >= 0.2) return 'med';
    return 'low';
  }

  function renderRiskScatter(rows: any[]) {
    const host = document.getElementById('cf-risk');
    if (!host) return;
    host.replaceChildren();
    if (rows.length === 0) {
      const el = document.createElement('p');
      el.className = 'note';
      el.textContent = S.tiNoneYet;
      host.append(el);
      return;
    }
    const W = 620;
    const H = 244;
    const L = 46;
    const R = 604;
    const T = 20;
    const B = 188;
    const maxReq = Math.max(1, ...rows.map((r) => Number(r.requests) || 0));
    const domainMax = Math.max(10, 10 ** Math.ceil(Math.log10(maxReq)));
    const scaleX = (v: number) => logScaleX(v, { min: 1, max: domainMax, rangeMin: L, rangeMax: R });

    const svg = document.createElementNS(SVG_NS, 'svg');
    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    svg.setAttribute('class', 'scatter-svg');
    svg.setAttribute('role', 'img');
    svg.setAttribute('aria-label', S.riskTitle);

    const line = (x1: number, y1: number, x2: number, y2: number, cls: string) => {
      const el = document.createElementNS(SVG_NS, 'line');
      el.setAttribute('x1', x1.toFixed(1));
      el.setAttribute('y1', y1.toFixed(1));
      el.setAttribute('x2', x2.toFixed(1));
      el.setAttribute('y2', y2.toFixed(1));
      el.setAttribute('class', cls);
      svg.append(el);
    };
    const text = (x: number, y: number, anchor: string, cls: string, content: string) => {
      const el = document.createElementNS(SVG_NS, 'text');
      el.setAttribute('x', x.toFixed(1));
      el.setAttribute('y', y.toFixed(1));
      el.setAttribute('text-anchor', anchor);
      el.setAttribute('class', cls);
      el.textContent = content;
      svg.append(el);
    };

    line(L, B, R, B, 'chart-axis');
    for (const pct of [25, 50, 75, 100]) {
      const y = B - (pct / 100) * (B - T);
      line(L, y, R, y, 'chart-axis');
      text(L - 8, y + 3, 'end', 'chart-lbl', `${pct}%`);
    }
    text(L - 8, B + 3, 'end', 'chart-lbl', '0');

    // Limiar de amostra (100 pedidos): a mesma linha que separava "amostra
    // pequena"/"amostra fiável" na antiga nota de texto, agora desenhada.
    const thresholdX = scaleX(100);
    const thr = document.createElementNS(SVG_NS, 'line');
    thr.setAttribute('x1', thresholdX.toFixed(1));
    thr.setAttribute('y1', String(T));
    thr.setAttribute('x2', thresholdX.toFixed(1));
    thr.setAttribute('y2', String(B));
    thr.setAttribute('class', 'chart-threshold');
    svg.append(thr);
    // Perto do fundo, não do topo: um país de amostra fiável mas taxa alta
    // (ex.: ES a 96,9%) fica perto do limiar exatamente no topo do gráfico —
    // o rótulo colidia com o próprio ponto que estava a rotular.
    text(thresholdX - 6, B - 6, 'end', 'chart-lbl', S.riskThresholdLeft);
    text(thresholdX + 6, B - 6, 'start', 'chart-lbl', S.riskThresholdRight);

    for (let v = 1; v <= domainMax + 1; v *= 10) {
      text(scaleX(v), B + 20, 'middle', 'chart-lbl', formatNumber(v, locale));
    }
    text((L + R) / 2, B + 38, 'middle', 'chart-lbl', S.riskAxisRequests);

    const pts: RiskPoint[] = rows.map((row) => {
      const rate = Number(row.rate) || 0;
      return {
        x: scaleX(Number(row.requests) || 1),
        y: B - Math.min(1, Math.max(0, rate)) * (B - T),
        r: areaRadius(Number(row.threats) || 0, { minR: row.lowSample ? 5 : 6, k: 1 }),
        row,
      };
    });
    // Rótulos diretos só onde não colidem: o ponto continua sempre visível e
    // com tooltip, só o rótulo de texto que se omite quando colidiria com um
    // já aceite. O limiar tem de ser a LARGURA REAL do texto, não uma
    // distância fixa — com vários países de amostra pequena (todos a 100%,
    // apinhados no canto esquerdo da escala log) uma distância fixa pequena
    // deixava rótulos como "GB · 100.0%" e "BE · 100.0%" sobrepostos,
    // ilegíveis. ~5.6px/carácter é a largura aproximada do mono a 9px usado
    // em .chart-lbl (ver global.css).
    const MONO_CHAR_W = 5.6;
    const labelText = (row: any) => `${row.country} · ${formatPercent(Number(row.rate) || 0)}`;
    const halfWidth = (row: any) => (labelText(row).length * MONO_CHAR_W) / 2 + 4;
    const accepted: { x: number; y: number; halfW: number }[] = [];
    const labelled = new Set<number>();
    pts
      .map((p, i) => ({ p, i, halfW: halfWidth(p.row) }))
      .sort((a, b) => a.p.x - b.p.x)
      .forEach(({ p, i, halfW }) => {
        const collide = accepted.some(
          (q) => Math.abs(q.x - p.x) < (q.halfW + halfW) && Math.abs(q.y - p.y) < 16,
        );
        if (!collide) {
          accepted.push({ x: p.x, y: p.y, halfW });
          labelled.add(i);
        }
      });

    pts.forEach((p, i) => {
      const row = p.row;
      const rate = Number(row.rate) || 0;
      const g = document.createElementNS(SVG_NS, 'g');
      const title = document.createElementNS(SVG_NS, 'title');
      const raw = `${formatNumber(row.threats, locale)}/${formatNumber(row.requests, locale)}`;
      title.textContent = `${row.country} — ${formatPercent(rate)} (${raw})${row.lowSample ? ` · ${S.riskLowSample}` : ''}`;
      g.append(title);
      const circle = document.createElementNS(SVG_NS, 'circle');
      circle.setAttribute('cx', p.x.toFixed(1));
      circle.setAttribute('cy', p.y.toFixed(1));
      circle.setAttribute('r', p.r.toFixed(1));
      circle.setAttribute('class', `scatter-dot ${riskDotClass(row)}`);
      g.append(circle);
      if (labelled.has(i)) {
        text(p.x, p.y - p.r - 6, 'middle', 'chart-lbl strong', labelText(row));
      }
      svg.append(g);
    });

    host.append(svg);
  }

  function renderRiskTable(rows: any[]) {
    const host = document.getElementById('cf-risk-table');
    if (!host) return;
    host.replaceChildren();
    if (rows.length === 0) return; // a dispersão acima já mostra o estado vazio
    const wrap = document.createElement('div');
    wrap.className = 'table-scroll';
    const table = document.createElement('table');
    table.className = 'result-table wrap-normal';
    const thead = document.createElement('thead');
    const headRow = document.createElement('tr');
    for (const label of [S.colCountry, S.cardRequests, S.cardThreats, S.riskColRate]) {
      const th = document.createElement('th');
