      tbody.append(tr);
    }
    table.append(thead, tbody);
    wrap.append(table);
    host.append(wrap);
  }

  // ---------- Cloudflare (ameaças à zona, /api/cf-stats) ----------
  async function loadCfThreats() {
    try {
      const res = await fetch(`${base}/api/cf-stats`, { headers: { accept: 'application/json' } });
      const ctype = res.headers.get('content-type') ?? '';
      if (!res.ok || !ctype.includes('application/json')) throw new Error('no api');
      const zone = (await res.json()).zone ?? {};

      const requests = Number(zone.requests ?? 0);
      const threats = Number(zone.threats ?? 0);
      const blocked = (zone.blockedByStatus ?? []).reduce((a: number, r: any) => a + (Number(r.count) || 0), 0);
      // Mesma classificação de firewallActionClass usada em D1/D2 (não um
      // filtro ad-hoc à parte): sem isto, "link_maze_injected" (o desafio da
      // AI Labyrinth) ficava fora da contagem só por não ter "challenge" no
      // nome, e este cartão desalinhava do resto da página.
      const challenges = sumByActionClass(zone.firewallByAction ?? [], ['challenged']);

      setText('cf-threats', formatNumber(threats, locale));
      setText('cf-blocked', formatNumber(blocked, locale));
      setText('cf-challenges', formatNumber(challenges, locale));
      setText('cf-threatrate', formatPercent(threatRate(threats, requests)));

      renderBars('cf-countries', bars(zone.topCountries ?? [], 'country', 'threats', 'warn'), S.countriesEmpty);
      renderBars('cf-status', bars(zone.blockedByStatus ?? [], 'key', 'count'), S.statusEmpty);
      const riskRows = Array.isArray(zone.riskByCountry) ? zone.riskByCountry : [];
      renderRiskScatter(riskRows);
      renderRiskTable(riskRows);

      // Detalhe por URL/user-agent/ASN (firewall, 24h) — vem do dataset CRU
      // firewallEventsAdaptive (ver planNote): nunca IP, mesmo esse campo
      // estando disponível na fonte.
      renderBars('cf-fw-paths', bars(zone.firewallByPath ?? [], 'key', 'count', 'warn'), S.firewallEmpty);
      renderBars('cf-fw-uas', bars(zone.firewallByUserAgent ?? [], 'key', 'count', 'warn'), S.firewallEmpty);
      renderBars('cf-fw-asns', bars(zone.firewallByAsn ?? [], 'key', 'count', 'warn'), S.firewallEmpty);

      const series = Array.isArray(zone.series) ? zone.series : [];
      renderSpark('cf-tl-threats', series, 'threats');

      document.getElementById('cf-fallback')!.hidden = true;
      document.getElementById('cf-body')!.hidden = false;

      chainZone = zone;
      renderChain();
    } catch {
      // Sem Worker: fica o fallback já pintado.
    }
  }

  // ---------- Padrões (7d, honeypot + firewall acumulado, /api/threat-intel) ----------

  // Abaixo deste total de eventos na janela, o heatmap 168 células vira uma
  // única célula acesa — lê-se como painel avariado, não como "pouco
  // tráfego". Troca-se por uma linha do tempo simples (ver renderTimeline).
  const HEATMAP_MIN_EVENTS = 20;

  const dayFmt = new Intl.DateTimeFormat(locale, { day: '2-digit', month: '2-digit', timeZone: 'UTC' });

  // ---------- Mitigação por dia (D2) ----------
  // Os 7 snapshots diários de firewall só apareciam somados: um dia de
  // ataque a sério e um dia de tráfego humano a resolver desafios ficavam
  // indistinguíveis. `daily` vem de firewall7d.daily (mergeFirewall7d, no
  // Worker) — o byAction cru de cada dia; a classificação em
  // bloqueado/desafiado/passado é a mesma de firewallActionClass usada nas
  // barras "Firewall por ação", por isso os totais nunca se contradizem.
  function renderDailyBars(daily: any[]) {
    const host = document.getElementById('ti-daily');
    if (!host) return;
    host.replaceChildren();
    const rows = classifyDaily(daily);
    if (rows.length === 0) {
      const el = document.createElement('p');
      el.className = 'note';
      el.textContent = S.tiNoneYet;
      host.append(el);
      return;
    }
    const W = 620;
    const H = 216;
    const ML = 42;
    const MR = 8;
    const TOP = 26;
    const AXIS_Y = 178;
    const GAP = 2;
    const MINH = 2.2;
    const n = rows.length;
    const slot = (W - ML - MR) / n;
    const barW = Math.min(58, slot * 0.72);
    const max = Math.max(1, ...rows.map((r) => r.total));
    const scale = (AXIS_Y - TOP - GAP * 2) / max;
    const todayIso = new Date().toISOString().slice(0, 10);

    const svg = document.createElementNS(SVG_NS, 'svg');
    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    svg.setAttribute('class', 'daily-svg');
    svg.setAttribute('role', 'img');
    svg.setAttribute('aria-label', S.tiDailyBlocked);
    const axis = document.createElementNS(SVG_NS, 'line');
    axis.setAttribute('x1', String(ML));
    axis.setAttribute('y1', String(AXIS_Y));
    axis.setAttribute('x2', String(W - MR));
    axis.setAttribute('y2', String(AXIS_Y));
    axis.setAttribute('class', 'chart-axis');
    svg.append(axis);

    rows.forEach((r, i) => {
      const x = ML + i * slot + (slot - barW) / 2;
      const cx = x + barW / 2;
      const g = document.createElementNS(SVG_NS, 'g');
      const title = document.createElementNS(SVG_NS, 'title');
      title.textContent = `${r.date} — ${S.tiDailyBlocked}: ${formatNumber(r.blocked, locale)} · `
        + `${S.tiDailyChallenged}: ${formatNumber(r.challenged, locale)} · `
        + `${S.tiDailyAllowed}: ${formatNumber(r.allowed, locale)}`;
      g.append(title);

      let y = AXIS_Y;
      const seg = (value: number, cls: string) => {
        if (value <= 0) return;
        const h = Math.max(MINH, value * scale);
        y -= h;
        const rect = document.createElementNS(SVG_NS, 'rect');
        rect.setAttribute('x', x.toFixed(1));
        rect.setAttribute('y', y.toFixed(1));
        rect.setAttribute('width', barW.toFixed(1));
        rect.setAttribute('height', h.toFixed(1));
        rect.setAttribute('rx', Math.min(4, h / 2).toFixed(1));
        rect.setAttribute('class', `daily-seg ${cls}`);
        g.append(rect);
        y -= GAP;
      };
      seg(r.blocked, 'blocked');
      seg(r.challenged, 'challenged');
      seg(r.allowed, 'allowed');

      if (r.total > 0) {
        const val = document.createElementNS(SVG_NS, 'text');
        val.setAttribute('x', cx.toFixed(1));
        val.setAttribute('y', (y - 6).toFixed(1));
        val.setAttribute('text-anchor', 'middle');
        val.setAttribute('class', 'chart-val');
        val.textContent = formatNumber(r.total, locale);
        g.append(val);
      }
      const dayLbl = document.createElementNS(SVG_NS, 'text');
      dayLbl.setAttribute('x', cx.toFixed(1));
      dayLbl.setAttribute('y', String(AXIS_Y + 16));
      dayLbl.setAttribute('text-anchor', 'middle');
      dayLbl.setAttribute('class', r.date === todayIso ? 'chart-lbl strong' : 'chart-lbl');
      dayLbl.textContent = dayFmt.format(new Date(`${r.date}T00:00:00Z`));
      g.append(dayLbl);

      svg.append(g);
    });
    host.append(svg);

    const legend = document.createElement('div');
    legend.className = 'chart-legend mono';
    const totals = rows.reduce(
      (acc, r) => ({ blocked: acc.blocked + r.blocked, challenged: acc.challenged + r.challenged, allowed: acc.allowed + r.allowed }),
      { blocked: 0, challenged: 0, allowed: 0 },
    );
    const swatches: [string, string, number][] = [
      ['blocked', S.tiDailyBlocked, totals.blocked],
      ['challenged', S.tiDailyChallenged, totals.challenged],
      ['allowed', S.tiDailyAllowed, totals.allowed],
    ];
    for (const [cls, label, count] of swatches) {
      const span = document.createElement('span');
      const dot = document.createElement('i');
      dot.className = `chart-dot ${cls}`;
      span.append(dot, document.createTextNode(`${label} · ${formatNumber(count, locale)}`));
      legend.append(span);
    }
    host.append(legend);
  }

  // ---------- Linha do tempo (fallback do heatmap com poucos eventos) ----------
  function renderTimeline(events: any[]) {
    const host = document.getElementById('ti-timeline');
    if (!host) return;
    host.replaceChildren();
    const WEEK_MS = 7 * 86400_000;
    const now = Date.now();
    const start = now - WEEK_MS;
    const inWindow = events
      .filter((e) => Number(e?.ts) >= start)
      .sort((a, b) => Number(a.ts) - Number(b.ts));

    const W = 620;
    const H = 76;
    const L = 16;
    const R = 604;
    const Y = 40;
    const svg = document.createElementNS(SVG_NS, 'svg');
    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    svg.setAttribute('class', 'timeline-svg');
    svg.setAttribute('role', 'img');
    svg.setAttribute('aria-label', S.tiHeatmapSparse);

    const line = document.createElementNS(SVG_NS, 'line');
    line.setAttribute('x1', String(L));
    line.setAttribute('y1', String(Y));
    line.setAttribute('x2', String(R));
    line.setAttribute('y2', String(Y));
    line.setAttribute('class', 'chart-axis');
    svg.append(line);

    // Eventos com o mesmo instante (a anonimização arredonda a 5 min)
    // caem no mesmo x — em vez de se sobreporem, cada um seguinte desloca-se
    // ligeiramente, como o cluster "AS32613 · 2 eventos" do mockup.
    const xOf = (ts: number) => L + ((ts - start) / WEEK_MS) * (R - L);
    const bucketCount = new Map<number, number>();
    for (const e of inWindow) {
      const rawX = xOf(Number(e.ts));
      const bucket = Math.round(rawX / 6);
      const idx = bucketCount.get(bucket) ?? 0;
      bucketCount.set(bucket, idx + 1);
      const x = rawX + idx * 6;

      const g = document.createElementNS(SVG_NS, 'g');
      const title = document.createElementNS(SVG_NS, 'title');
      title.textContent = `${timeFmt.format(new Date(e.ts))} · ${e.country ?? 'XX'} · `
        + `${e.asn ? `AS${e.asn}` : '—'} · ${e.path ?? ''}`;
      g.append(title);
      const dot = document.createElementNS(SVG_NS, 'circle');
      dot.setAttribute('cx', x.toFixed(1));
      dot.setAttribute('cy', String(Y));
      dot.setAttribute('r', '5');
      dot.setAttribute('class', 'timeline-dot');
      g.append(dot);
      svg.append(g);
    }

    const startLbl = document.createElementNS(SVG_NS, 'text');
    startLbl.setAttribute('x', String(L));
    startLbl.setAttribute('y', String(Y + 24));
    startLbl.setAttribute('class', 'chart-lbl');
    startLbl.textContent = dayFmt.format(new Date(start));
    svg.append(startLbl);
    const endLbl = document.createElementNS(SVG_NS, 'text');
    endLbl.setAttribute('x', String(R));
    endLbl.setAttribute('y', String(Y + 24));
    endLbl.setAttribute('text-anchor', 'end');
    endLbl.setAttribute('class', 'chart-lbl strong');
    endLbl.textContent = S.tiTimelineToday;
    svg.append(endLbl);

    host.append(svg);
  }

  function renderHeatmap(rows: { date: string; hours: number[] }[]) {
    const host = document.getElementById('ti-heatmap');
    if (!host) return;
    host.replaceChildren();
    let max = 0;
    for (const r of rows) for (const c of r.hours) if (c > max) max = c;
    for (const r of rows) {
      const rowEl = document.createElement('div');
      rowEl.className = 'heatmap-row';
      const label = document.createElement('span');
      label.className = 'heat-label';
      label.textContent = r.date.slice(5); // MM-DD
      rowEl.append(label);
      r.hours.forEach((count, hour) => {
        const cell = document.createElement('span');
        cell.className = 'heat-cell';
        const intensity = max > 0 ? count / max : 0;
        if (count > 0) cell.style.backgroundColor = `rgba(61, 220, 132, ${(0.15 + intensity * 0.85).toFixed(3)})`;
        cell.title = `${r.date} ${String(hour).padStart(2, '0')}h · ${count}`;
        rowEl.append(cell);
      });
      host.append(rowEl);
    }
  }

  function renderHours(hours: number[]) {
    const host = document.getElementById('ti-hours');
    if (!host) return;
    host.replaceChildren();
    const max = hours.reduce((m, v) => Math.max(m, v), 0);
    hours.forEach((count, hour) => {
      const bar = document.createElement('span');
      bar.className = 'hour-bar';
      bar.style.height = `${max > 0 && count > 0 ? Math.max(3, Math.round((count / max) * 54)) : 2}px`;
      bar.title = `${String(hour).padStart(2, '0')}h · ${count}`;
      host.append(bar);
    });
  }

  // Logs: estado de pesquisa + paginação (client-side sobre até 200 eventos).
  const timeFmt = new Intl.DateTimeFormat(locale, {
    day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit',
  });
  const dateFmt = new Intl.DateTimeFormat(locale, { day: '2-digit', month: '2-digit', year: 'numeric' });
  let logEvents: any[] = [];
  let logCorr: Correlation = { active: new Set(), cve: {} };
  let logPage = 0;
  const LOG_PAGE = 25;

  function filteredEvents(): any[] {
    const q = (document.getElementById('logs-search') as HTMLInputElement | null)?.value.trim().toLowerCase() ?? '';
    if (!q) return logEvents;
    return logEvents.filter((e) => {
      const hay = `${e.country ?? ''} ${e.asn ? 'as' + e.asn : ''} ${e.path ?? ''} ${e.technique ?? ''}`.toLowerCase();
      return hay.includes(q);
    });
  }

  function renderLogsPage() {
    const rowsEl = document.getElementById('logs-rows');
    if (!rowsEl) return;
    const list = filteredEvents();
    const pages = Math.max(1, Math.ceil(list.length / LOG_PAGE));
    if (logPage >= pages) logPage = pages - 1;
    rowsEl.replaceChildren();
    const slice = list.slice(logPage * LOG_PAGE, logPage * LOG_PAGE + LOG_PAGE);
    if (slice.length === 0) {
      const tr = document.createElement('tr');
      const td = document.createElement('td');
      td.colSpan = 6;
      td.className = 'hp-loading';
      td.textContent = S.logsEmpty;
      tr.append(td);
      rowsEl.append(tr);
    }
    for (const e of slice) {
      const tr = document.createElement('tr');
      const cells = [
        timeFmt.format(new Date(e.ts)),
        e.country ?? 'XX',
        e.asn ? `AS${e.asn}` : '—',
        e.path ?? '',
      ];
      cells.forEach((value, i) => {
        const td = document.createElement('td');
        td.textContent = value;
        if (i === 1) td.className = 'mono hp-cc';
        if (i === 3) td.className = 'mono hp-path';
        tr.append(td);
      });
      const { td } = techCell(e, tr, logCorr);
      tr.append(td);
      const verdict = document.createElement('td');
      verdict.className = 'hp-verdict';
      verdict.textContent = S.verdict;
      tr.append(verdict);
      rowsEl.append(tr);
    }
    setText('logs-count', `${list.length ? logPage + 1 : 0} ${S.logsPageOf} ${pages}`);
    (document.getElementById('logs-prev') as HTMLButtonElement).disabled = logPage <= 0;
    (document.getElementById('logs-next') as HTMLButtonElement).disabled = logPage >= pages - 1;
  }

  function wireLogs() {
    document.getElementById('logs-search')?.addEventListener('input', () => { logPage = 0; renderLogsPage(); });
    document.getElementById('logs-prev')?.addEventListener('click', () => { if (logPage > 0) { logPage--; renderLogsPage(); } });
    document.getElementById('logs-next')?.addEventListener('click', () => { logPage++; renderLogsPage(); });
  }

  async function loadThreatIntel() {
    try {
      const [res, corr] = await Promise.all([
        fetch(`${base}/api/threat-intel`, { headers: { accept: 'application/json' } }),
        tickerCorrelation(),
      ]);
      const ctype = res.headers.get('content-type') ?? '';
      if (!res.ok || !ctype.includes('application/json')) throw new Error('no api');
      const d = await res.json();
      const totals = d.totals ?? {};

      // Valor + etiqueta concordantes em número (ver plural()): com 1 país,
      // o cartão dizia "1 Países".
      const kpi = (id: string, n: number, one: string, other: string) => {
        setText(id, formatNumber(n, locale));
        setText(`${id}-l`, plural(n, { one, other }, locale));
      };
      kpi('ti-events', Number(totals.events7d) || 0, S.tiEventsOne, S.tiEvents);
      kpi('ti-countries', Number(totals.countries7d) || 0, S.tiCountriesOne, S.tiCountries);
      kpi('ti-asns', Number(totals.asns7d) || 0, S.tiAsnsOne, S.tiAsns);
      setText('ti-peak', d.peakHour ? `${String(d.peakHour.hour).padStart(2, '0')}h` : '—');

      // Abaixo de HEATMAP_MIN_EVENTS eventos, o grid 168 células lê-se como
      // painel avariado (uma única célula acesa) — troca-se por uma linha
      // do tempo simples dos mesmos eventos.
      const eventsInWindow = Number(totals.events7d) || 0;
      const sparse = eventsInWindow < HEATMAP_MIN_EVENTS;
      document.getElementById('ti-heatmap-visual')!.hidden = sparse;
      document.getElementById('ti-heatmap-sparse')!.hidden = !sparse;
      document.getElementById('ti-timeline')!.hidden = !sparse;
      if (sparse) renderTimeline(Array.isArray(d.events) ? d.events : []);
      else renderHeatmap(Array.isArray(d.heatmap) ? d.heatmap : []);
      renderHours(Array.isArray(d.byHourOfDay) ? d.byHourOfDay : []);
      renderBars('ti-newatk', bars(d.newAttackers ?? [], 'key', 'count', 'warn'), S.tiNoneYet);
      renderBars(
        'ti-recatk',
        (d.recurringAttackers ?? []).map((r: any) => ({
          label: String(r.key),
          value: Number(r.count) || 0,
          tone: 'warn',
          display: `${formatNumber(r.count, locale)} · ${r.days} ${S.tiDays}`,
        })),
        S.tiNoneYet,
      );
      // Nome da técnica a par do ID: nos Logs e nas Deteções o ID cru ainda
      // tem o `title`/link a explicá-lo, mas numa barra não há onde passar o
      // rato — ficava só "T1110" sem dizer o que é.
      renderBars(
        'ti-tech',
        (d.topTechniques ?? []).map((r: any) => {
          const id = String(r.key);
          const name = TECH.byId[id]?.name;
          return { label: name ? `${id} · ${name}` : id, value: Number(r.count) || 0 };
        }),
        S.tiEmpty,
      );
      renderBars('ti-toppaths', bars(d.topPaths ?? [], 'key', 'count'), S.tiEmpty);
      const fw = d.firewall7d ?? {};
      renderDailyBars(Array.isArray(fw.daily) ? fw.daily : []);
      // Tom por CLASSE de ação, não âmbar para tudo: com 890 "skip" e 592
      // desafios resolvidos, o painel pintava tráfego legítimo (o meu, de
      // Portugal) da mesma cor que os 637 bloqueios reais.
      renderBars(
        'ti-fwaction',
        (fw.byAction ?? []).map((r: any) => ({
          label: String(r.key),
          value: Number(r.count) || 0,
          tone: firewallActionTone(r.key),
        })),
        S.firewallEmpty,
      );
      renderBars('ti-fwsource', bars(fw.bySource ?? [], 'key', 'count', 'warn'), S.firewallEmpty);
      renderSourceTable(
        'ti-tbl-countries',
        [S.colCountry, S.colSource, S.colAction, S.colCount],
        [
          ...(d.topCountries ?? []).map((r: any): SourceRow => ({
            key: String(r.key), source: 'honeypot', count: Number(r.count) || 0,
          })),
          ...(fw.byCountry ?? []).map((r: any): SourceRow => ({
            key: String(r.country), source: 'cloudflare', count: Number(r.count) || 0, action: String(r.action ?? '—'),
          })),
        ].sort((a, b) => b.count - a.count),
        true,
        S.tiEmpty,
      );
      renderSourceTable(
        'ti-tbl-networks',
        [S.colNetwork, S.colSource, S.colCount],
        [
          ...(d.topAsns ?? []).map((r: any): SourceRow => ({
            key: String(r.key), source: 'honeypot', count: Number(r.count) || 0,
          })),
          ...(fw.byAsn ?? []).map((r: any): SourceRow => ({
            key: String(r.key), source: 'cloudflare', count: Number(r.count) || 0,
          })),
        ].sort((a, b) => b.count - a.count),
        false,
        S.tiEmpty,
      );

      document.getElementById('ti-fallback')!.hidden = true;
      document.getElementById('ti-body')!.hidden = false;

      chainFw = fw;
      chainEvents7d = eventsInWindow;
      renderChain();

      // Logs
      logEvents = Array.isArray(d.events) ? d.events : [];
      logCorr = corr;
      if (logEvents.length > 0) {
        document.getElementById('logs-fallback')!.hidden = true;
        document.getElementById('logs-tablewrap')!.hidden = false;
        document.getElementById('logs-pager')!.hidden = false;
        // Janela desta lista, escrita: são os últimos 200 eventos guardados,
        // sem corte a 7 dias — sem isto, "Eventos (7d): 2" nos Padrões ao
        // lado de uma dúzia de linhas aqui lia-se como contradição.
        const oldest = logEvents.reduce((min, e) => Math.min(min, Number(e?.ts) || Infinity), Infinity);
        const windowEl = document.getElementById('logs-window')!;
        windowEl.textContent = S.logsWindowNote
          .replace('{n}', formatNumber(logEvents.length, locale))
          .replace('{date}', Number.isFinite(oldest) ? dateFmt.format(new Date(oldest)) : '—');
        windowEl.hidden = false;
        renderLogsPage();
      }
    } catch {
      // Sem Worker/dados: ficam os fallbacks já pintados.
    }
  }

  // Guardas de idempotência (mantidas mesmo com a carga abaixo deixando de
  // ser preguiçosa): um clique na tab nunca repete o pedido.
  let tiLoaded = false;
  function ensureThreatIntel() {
    if (tiLoaded) return;
    tiLoaded = true;
    loadThreatIntel();
  }
  for (const tab of document.querySelectorAll('[data-tab="trends"], [data-tab="logs"]')) {
    tab.addEventListener('click', ensureThreatIntel);
  }
  let cfLoaded = false;
  function ensureCf() {
    if (cfLoaded) return;
    cfLoaded = true;
    loadCfThreats();
  }
  for (const tab of document.querySelectorAll('[data-tab="cloudflare"]')) {
    tab.addEventListener('click', ensureCf);
  }

  wireLogs();
  wireDetCopy();
  loadHoneypot();
  // cf-stats e threat-intel deixam de ser só-ao-clique-na-tab: a cadeia do
  // perímetro (D1, acima das tabs) precisa das duas já na carga da página.
  // O KV já cacheia as duas respostas 6h no Worker — o custo extra de as
  // pedir sempre é uma leitura de cache barata, não um novo pedido à API da
  // Cloudflare a cada visita.
  ensureCf();
  ensureThreatIntel();
</script>

<style>
  .an-mt { margin-top: 0.9rem; }
  .wide-widget { grid-column: 1 / -1; }

