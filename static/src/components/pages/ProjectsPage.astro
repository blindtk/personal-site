---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../config';
import { t } from '../../i18n/ui';
import { routes, projectUrl } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t(lang);
const other: Lang = lang === 'pt' ? 'en' : 'pt';

const entries = (await getCollection('projects', (e) => e.id.startsWith(`${lang}/`)))
  .sort((a, b) => a.data.order - b.data.order);

// Gancho compacto do índice: primeira frase da descrição, cortada a ~100
// caracteres num limite de palavra. A escrita longa vive na página própria
// de cada projeto (projectUrl), não aqui.
function excerpt(text: string, max = 90): string {
  const firstSentence = text.split(/(?<=[.!?])\s/)[0] ?? text;
  if (firstSentence.length <= max) return firstSentence;
  const cut = firstSentence.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  const trimmed = (lastSpace > 0 ? cut.slice(0, lastSpace) : cut).replace(/[,;:—-]+$/, '');
  return `${trimmed}…`;
}
---

<BaseLayout lang={lang} title={dict.projects.title} altUrl={routes.projects[other]} active="projects">
  <div class="page-head">
    <h1>{dict.projects.title}</h1>
    <p class="intro">{dict.projects.intro}</p>
  </div>

  <div class="grid grid-3">
    {entries.map((entry) => {
      const slug = entry.id.slice(3);
      return (
        <div class="card">
          <h3><a href={projectUrl(lang, slug)}>{entry.data.title}</a></h3>
          <p>{excerpt(entry.data.description)}</p>
          <div class="meta">
            {entry.data.tags.map((tag) => <span class="badge">{tag}</span>)}
            {/* Sinal visual de que este-site e Honeypot fazem parte da teia
               de cross-links "por camadas" (SiteLayers) com Segurança/Provas/
               Deteções/ATT&CK — distingue-os, sem precisar de clicar, dos
               projetos independentes (Homelab, star-organizer). */}
            {(slug === 'este-site' || slug === 'honeypot') && (
              <span class="badge amber">{dict.projects.systemBadge}</span>
            )}
          </div>
          {(entry.data.repo || slug === 'honeypot') && (
            <div class="card-links mono">
              {entry.data.repo && <a href={entry.data.repo} rel="noopener">[{dict.projects.repo}]</a>}
              {/* O painel /honeypot/ (telemetria ao vivo, decoys + deteções)
                 é um destino distinto desta página (o "porquê"/arquitetura) —
                 evita confundir os dois sítios. */}
              {slug === 'honeypot' && <a href={routes.honeypot[lang]}>[{dict.projects.live}]</a>}
            </div>
          )}
          {/* Único gancho, no índice, para a teia de cross-links "por camadas"
             que já liga Segurança/Provas/Deteções/ATT&CK a este projeto — sem
             isto, só se descobre a partir de dentro de uma dessas páginas. */}
          {slug === 'este-site' && (
            <p class="card-hint"><a href={routes.security[lang]}>{dict.projects.systemCta}</a></p>
          )}
        </div>
      );
    })}
  </div>
</BaseLayout>

<style>
  /* Substitui o antigo .meta .repo-link (margin-left: auto): esse layout
     ficava inconsistente entre cartões — órfão numa 2.ª linha quando as tags
     enchiam a 1.ª (ex.: "Este site"), colado a meio quando não enchiam. Os
     links de ação ficam agora sempre na sua própria linha, à esquerda. */
  .card-links {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-top: 0.7rem;
    font-size: 0.78rem;
  }
  .card-links a {
    color: var(--accent);
  }
  .card-hint {
    margin: 0.6rem 0 0;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .card-hint a {
    color: var(--accent);
  }
</style>
