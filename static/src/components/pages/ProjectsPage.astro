---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, type Lang } from '../../config';
import { t } from '../../i18n/ui';
import { routes, projectUrl } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t(lang);
const other: Lang = lang === 'pt' ? 'en' : 'pt';

const entries = (await getCollection('projects', (e) => e.id.startsWith(`${lang}/`)))
  .sort((a, b) => a.data.order - b.data.order);

// A descrição aparece inteira: cada uma é escrita para caber num cartão
// (≤ ~100 caracteres) em vez de ser cortada a meio de uma frase aqui. A
// escrita longa vive na página própria de cada projeto.
---

<BaseLayout lang={lang} title={dict.projects.title} altUrl={routes.projects[other]} active="projects">
  <div class="page-head">
    <h1>{dict.projects.title}</h1>
    <p class="intro">{dict.projects.intro}</p>
  </div>

  <div class="grid grid-3">
    {entries.map((entry) => {
      const slug = entry.id.slice(3);
      return (
        <div class="card">
          <h2><a href={projectUrl(lang, slug)}>{entry.data.title}</a></h2>
          <p>{entry.data.description}</p>
          <div class="meta">
            {entry.data.tags.map((tag) => <span class="badge">{tag}</span>)}
          </div>
          {/* Uma linha de ações igual em todos os cartões: abrir o projeto e,
             só onde existe, o código e o painel público do Threat Intel
             (outro domínio, intel.danielmala.co: o relatório do sensor). */}
          <div class="card-links mono">
            <a href={projectUrl(lang, slug)}>[{dict.projects.open}]</a>
            {entry.data.repo && <a href={entry.data.repo} rel="noopener">[{dict.projects.repo}]</a>}
            {slug === 'threat-intel' && <a href={SITE.honeypotIntel} rel="noopener">[{dict.projects.live}]</a>}
          </div>
        </div>
      );
    })}
  </div>
</BaseLayout>

<style>
  /* Substitui o antigo .meta .repo-link (margin-left: auto): esse layout
     ficava inconsistente entre cartões — órfão numa 2.ª linha quando as tags
     enchiam a 1.ª (ex.: "Este site"), colado a meio quando não enchiam. Os
     links de ação ficam agora sempre na sua própria linha, à esquerda. */
  /* Cartão em coluna e linha de ações empurrada para o fundo: na mesma fila
     de cartões, as ações ficam alinhadas entre si. */
  .card {
    display: flex;
    flex-direction: column;
  }
  .card-links {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 0.7rem;
    font-size: 0.78rem;
  }
  .card-links a {
    color: var(--accent);
  }
</style>
