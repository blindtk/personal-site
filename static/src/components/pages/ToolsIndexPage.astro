---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../config';
import { t } from '../../i18n/ui';
import { routes, toolUrl } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t(lang);
const other: Lang = lang === 'pt' ? 'en' : 'pt';

const tools = [
  { slug: 'subnets', kind: 'client', ...dict.tools.subnets },
  { slug: 'hashes', kind: 'client', ...dict.tools.hashes },
  { slug: 'encoder', kind: 'client', ...dict.tools.encoder },
  { slug: 'passwords', kind: 'client', ...dict.tools.passwords },
  { slug: 'email-headers', kind: 'client', ...dict.tools['email-headers'] },
  { slug: 'exif', kind: 'client', ...dict.tools.exif },
  { slug: 'pwned', kind: 'server', ...dict.tools.pwned },
  { slug: 'self-scan', kind: 'server', ...dict.tools['self-scan'] },
] as const;
---

<BaseLayout lang={lang} title={dict.tools.title} altUrl={routes.tools[other]} active="tools">
  <div class="page-head">
    <h1>{dict.tools.title}</h1>
    <p class="intro">{dict.tools.intro}</p>
  </div>

  <div class="grid grid-2">
    {tools.map((tool) => (
      <a class="card" href={toolUrl(lang, tool.slug)}>
        <h3>{tool.name}</h3>
        <p>{tool.desc}</p>
        <div class="meta">
          <span class={`badge ${tool.kind === 'server' ? 'amber' : ''}`}>
            {tool.kind === 'server' ? `🛰️ ${dict.tools.serverBadge}` : `🔒 ${dict.tools.clientBadge}`}
          </span>
        </div>
      </a>
    ))}
  </div>

  <p class="note">{dict.tools.indexNote}</p>
</BaseLayout>
