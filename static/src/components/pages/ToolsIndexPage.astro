---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../config';
import { t } from '../../i18n/ui';
import { routes, toolUrl } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t(lang);
const other: Lang = lang === 'pt' ? 'en' : 'pt';

const tools = [
  { slug: 'subnets', ...dict.tools.subnets },
  { slug: 'hashes', ...dict.tools.hashes },
  { slug: 'encoder', ...dict.tools.encoder },
  { slug: 'passwords', ...dict.tools.passwords },
  { slug: 'email-headers', ...dict.tools['email-headers'] },
];
---

<BaseLayout lang={lang} title={dict.tools.title} altUrl={routes.tools[other]} active="tools">
  <div class="page-head">
    <h1>{dict.tools.title}</h1>
    <p class="intro">{dict.tools.intro}</p>
  </div>

  <div class="grid grid-2">
    {tools.map((tool) => (
      <a class="card" href={toolUrl(lang, tool.slug)}>
        <h3>{tool.name}</h3>
        <p>{tool.desc}</p>
        <div class="meta"><span class="badge">client-side</span></div>
      </a>
    ))}
  </div>

  <p class="note">🔒 {dict.tools.clientSideNote}</p>
</BaseLayout>
