---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HostMap from '../HostMap.astro';
import { API_BASE, type Lang } from '../../config';
import { t } from '../../i18n/ui';
import { routes } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t(lang);
const h = dict.honeypot;
const other: Lang = lang === 'pt' ? 'en' : 'pt';

const jsStrings = {
  verdict: h.verdict,
  empty: h.empty,
  unavailable: h.unavailable,
  secondsAgo: h.secondsAgo,
};
---

<BaseLayout lang={lang} title={h.metaTitle} altUrl={routes.honeypot[other]} active="honeypot">
  <div class="page-head">
    <h1>{h.title}</h1>
    <p class="intro">{h.intro}</p>
  </div>

  <section
    class="honeypot"
    id="honeypot"
    data-api={API_BASE}
    data-strings={JSON.stringify(jsStrings)}
    aria-label={h.title}
  >
    <p class="hp-fallback" id="hp-fallback" hidden>{h.unavailable}</p>

    <div class="stats-grid" id="hp-stats">
      <div class="stat"><div class="n" id="hp-attempts">—</div><div class="l">{h.statAttempts}</div></div>
      <div class="stat amber"><div class="n mono" id="hp-toppath">—</div><div class="l">{h.statTopPath}</div></div>
      <div class="stat blue"><div class="n" id="hp-countries">—</div><div class="l">{h.statCountries}</div></div>
      <div class="stat"><div class="n" id="hp-firstscan">—</div><div class="l">{h.statFirstScan}</div></div>
    </div>

    <div class="table-scroll">
      <table class="result-table hp-table">
        <thead>
          <tr>
            <th>{h.tableWhen}</th>
            <th>{h.tableOrigin}</th>
            <th>{h.tableAsn}</th>
            <th>{h.tablePath}</th>
            <th>{h.tableVerdict}</th>
          </tr>
        </thead>
        <tbody id="hp-rows">
          <tr><td colspan="5" class="hp-loading">{h.loading}</td></tr>
        </tbody>
      </table>
    </div>

    <p class="note warn">🔒 {h.privacyNote}</p>
  </section>

  <HostMap lang={lang} />
</BaseLayout>

<script>
  const root = document.getElementById('honeypot')!;
  const base = root.dataset.api ?? '';
  const S = JSON.parse(root.dataset.strings!);
  const rowsEl = document.getElementById('hp-rows')!;
  const fallbackEl = document.getElementById('hp-fallback')!;

  const setText = (id: string, value: string) => {
    document.getElementById(id)!.textContent = value;
  };

  function fmtDuration(sec: number | null): string {
    if (sec === null || sec === undefined) return '—';
    if (sec < 60) return `${sec}s`;
    if (sec < 3600) return `${Math.floor(sec / 60)}m ${sec % 60}s`;
    return `${Math.floor(sec / 3600)}h ${Math.floor((sec % 3600) / 60)}m`;
  }

  const timeFmt = new Intl.DateTimeFormat(undefined, { hour: '2-digit', minute: '2-digit', second: '2-digit' });

  function renderRows(recent: any[]) {
    rowsEl.replaceChildren();
    if (!recent || recent.length === 0) {
      const tr = document.createElement('tr');
      const td = document.createElement('td');
      td.colSpan = 5;
      td.className = 'hp-loading';
      td.textContent = S.empty;
      tr.append(td);
      rowsEl.append(tr);
      return;
    }
    for (const ev of recent) {
      const tr = document.createElement('tr');
      const cells = [
        timeFmt.format(new Date(ev.ts)),
        ev.country ?? 'XX',
        ev.asn ? `AS${ev.asn}` : '—',
        ev.path ?? '',
        S.verdict,
      ];
      cells.forEach((value, i) => {
        const td = document.createElement('td');
        td.textContent = value;
        if (i === 1) td.className = 'mono hp-cc';
        if (i === 3) td.className = 'mono hp-path';
        if (i === 4) td.className = 'hp-verdict';
        tr.append(td);
      });
      rowsEl.append(tr);
    }
  }

  async function load() {
    try {
      const res = await fetch(`${base}/api/honeypot`, { headers: { accept: 'application/json' } });
      const ctype = res.headers.get('content-type') ?? '';
      if (!res.ok || !ctype.includes('application/json')) throw new Error('no api');
      const data = await res.json();
      setText('hp-attempts', String(data.attempts24h ?? 0));
      setText('hp-toppath', data.topPath ?? '—');
      setText('hp-countries', String(data.countryCount ?? 0));
      setText('hp-firstscan', fmtDuration(data.timeToFirstScanSec));
      renderRows(data.recent ?? []);
    } catch {
      // Sem Worker publicado: mostra a nota explicativa e esconde a tabela.
      fallbackEl.hidden = false;
      document.getElementById('hp-stats')!.hidden = true;
      rowsEl.closest('.table-scroll')!.setAttribute('hidden', '');
    }
  }

  load();
</script>
