---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../config';
import { t } from '../../i18n/ui';
import { routes } from '../../i18n/routes';

interface Props {
  lang: Lang;
  project: CollectionEntry<'projects'>;
  /** URL do mesmo projeto no outro idioma, se existir. */
  altUrl?: string;
}
const { lang, project, altUrl } = Astro.props;
const dict = t(lang);
const { Content } = await render(project);
---

<BaseLayout
  lang={lang}
  title={project.data.title}
  description={project.data.description}
  altUrl={altUrl}
  active="projects"
>
  <div class="page-head">
    <h1>{project.data.title}</h1>
    <p class="intro">{project.data.description}</p>
  </div>
  {project.data.tags.length > 0 && (
    <div class="project-tags">
      {project.data.tags.map((tag) => <span class="badge">{tag}</span>)}
    </div>
  )}
  <article class="prose">
    <Content />
  </article>
  {(project.data.repo || project.data.demo) && (
    <div class="project-links mono">
      {project.data.repo && <a href={project.data.repo} rel="noopener">[{dict.projects.repo}]</a>}
      {project.data.demo && <a href={project.data.demo} rel="noopener">[{dict.projects.demo}]</a>}
    </div>
  )}
  <hr class="project-hr" />
  <a href={routes.projects[lang]} class="mono">{dict.projects.back}</a>
</BaseLayout>

<style>
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    /* Sem margem de topo: o .page-head já dá 2rem de respiro até à intro,
       o mesmo ritmo das restantes páginas (índice de Projetos, ATT&CK). */
    margin: 0 0 1.2rem;
  }
  .project-links {
    display: flex;
    gap: 1.2rem;
    margin-top: 1.5rem;
  }
  /* Projetos curtos não precisam do respiro de 2rem+2rem do <hr> global —
     essa folga é o que sobrava vazio abaixo do fold. */
  .project-hr {
    margin: 1.6rem 0 1.3rem;
  }
</style>
