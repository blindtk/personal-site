---
import type { Lang } from '../config';
import { t } from '../i18n/ui';
import { routes } from '../i18n/routes';

/**
 * Separadores da secção "Este site", no topo de cada uma das cinco páginas,
 * com a atual marcada. Substitui a lista "por camadas" que se repetia no fim
 * de cada página: a navegação fica num sítio só e a descrição de cada página
 * vive uma vez, na Visão geral.
 *
 * O honeypot não é uma página desta secção: é um projeto à parte
 * (Threat Intel), descrito em Projetos. ATT&CK e Certificações também ficam
 * de fora: são sobre o percurso pessoal, não sobre o site (ver a nota no
 * BaseLayout.astro).
 */
type LayerKey = 'overview' | 'security' | 'cloudflare' | 'evidence' | 'performance';

interface Props {
  lang: Lang;
  current: LayerKey;
}
const { lang, current } = Astro.props;
const dict = t(lang).layers;

const items: { key: LayerKey; href: string; label: string }[] = [
  { key: 'overview', href: routes.siteOverview[lang], label: dict.overview },
  { key: 'security', href: routes.security[lang], label: dict.security },
  { key: 'cloudflare', href: routes.cloudflare[lang], label: dict.cloudflare },
  { key: 'evidence', href: routes.evidence[lang], label: dict.evidence },
  { key: 'performance', href: routes.performance[lang], label: dict.performance },
];
---

<nav class="layers-tabs" aria-label={dict.title}>
  <ul class="mono">
    {items.map((item) => (
      <li>
        <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>{item.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .layers-tabs {
    margin: 1.3rem 0 1.6rem;
    border-bottom: 1px solid var(--border);
  }
  .layers-tabs ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    /* Em ecrãs estreitos os separadores partem em duas linhas em vez de
       esconderem os últimos atrás de um scroll horizontal. */
    flex-wrap: wrap;
    gap: 0 0.2rem;
    font-size: 0.82rem;
    white-space: nowrap;
  }
  .layers-tabs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.6rem;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .layers-tabs a:hover,
  .layers-tabs a:focus-visible {
    color: var(--text);
  }
  .layers-tabs a[aria-current='page'] {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
