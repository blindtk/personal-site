---
import { API_BASE, type Lang } from '../../config';
import { t } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).tools.mirror;

// Todos os valores são per-request (servidor) ou lidos no cliente (browser),
// por isso nada é pré-renderizado no build — só as strings e os rótulos.
const jsStrings = s;
---

<section class="mirror" id="mirror" data-api={API_BASE} data-strings={JSON.stringify(jsStrings)}>
  <div class="mirror-log">
    <div><span class="p">$</span> {s.logDirect}</div>
    <div><span class="ok" id="mirror-log-server">✓</span> {s.logServer}</div>
    <div><span class="warn">▲</span> {s.logLocal}</div>
  </div>

  <div class="mirror-grid">
    <div class="panel">
      <div class="phead">
        <span>// {s.serverTitle}</span>
        <span class="live">● {s.serverBadge}</span>
      </div>
      <p class="scan-status mono" id="mirror-status">{s.loading}</p>
      <div class="mirror-kv" id="mirror-server" hidden></div>
      <div class="mirror-foot" id="mirror-server-foot" hidden>{s.serverFoot}</div>
    </div>

    <div class="panel">
      <div class="phead">
        <span>// {s.localTitle}</span>
        <span class="local">◆ {s.localBadge}</span>
      </div>
      <div class="mirror-kv" id="mirror-local"></div>
      <div class="mirror-foot">{s.localFoot}</div>
    </div>
  </div>

  <div class="mirror-note"><b>▲ {s.noteLabel}:</b> {s.note}</div>
</section>

<script>
  const root = document.getElementById('mirror')!;
  const base = root.dataset.api ?? '';
  const S = JSON.parse(root.dataset.strings!);
  const statusEl = document.getElementById('mirror-status')!;
  const serverEl = document.getElementById('mirror-server')!;
  const serverFoot = document.getElementById('mirror-server-foot')!;
  const localEl = document.getElementById('mirror-local')!;

  // Constrói uma linha chave→valor (v pode ter uma classe de ênfase).
  function row(container: HTMLElement, label: string, value: string, cls = '') {
    const div = document.createElement('div');
    const k = document.createElement('span');
    k.className = 'k';
    k.textContent = label;
    const v = document.createElement('span');
    v.className = cls ? `v ${cls}` : 'v';
    v.textContent = value;
    div.append(k, v);
    container.append(div);
  }

  // ---- painel local: lido no browser, nunca enviado ----
  function renderLocal() {
    const dpr = window.devicePixelRatio || 1;
    const scr = `${screen.width} × ${screen.height} @ ${dpr}× · ${screen.colorDepth}-bit`;
    row(localEl, S.lScreen, scr);

    let tz = S.none;
    try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || S.none; } catch { /* noop */ }
    row(localEl, S.lTz, tz + S.tzNote, 'warn');

    const langs = (navigator.languages && navigator.languages.length)
      ? navigator.languages.join(', ')
      : navigator.language || S.none;
    row(localEl, S.lLangs, langs);

    const cores = (navigator as any).hardwareConcurrency;
    const mem = (navigator as any).deviceMemory;
    const coreStr = `${cores ? `${cores} cores` : S.none}${mem ? ` · ≥ ${mem} GB` : ''}`;
    row(localEl, S.lCores, coreStr);

    const dark = matchMedia('(prefers-color-scheme: dark)').matches;
    const moreContrast = matchMedia('(prefers-contrast: more)').matches;
    row(localEl, S.lTheme, `${dark ? S.themeDark : S.themeLight} · ${moreContrast ? S.contrastMore : S.contrastNone}`);

    const coarse = matchMedia('(pointer: coarse)').matches;
    row(localEl, S.lPointer, coarse ? S.pointerCoarse : S.pointerFine);

    const dnt = navigator.doNotTrack === '1' || (window as any).doNotTrack === '1';
    const gpc = (navigator as any).globalPrivacyControl === true;
    row(localEl, S.lDnt, dnt ? S.dntOn : gpc ? S.dntGpc : S.dntUnset, dnt || gpc ? '' : 'dim');
  }

  // ---- painel do servidor: via Worker (/api/mirror) ----
  function renderServer(d: any) {
    serverEl.replaceChildren();
    const tls = [d.tlsVersion, d.tlsCipher].filter(Boolean).join(' · ') || S.none;
    row(serverEl, S.sTls, tls, 'hl');
    row(serverEl, S.sProtocol, d.httpProtocol || S.none);
    const org = d.asOrganization ? ` (${d.asOrganization})` : '';
    const geo = `${d.country}${d.asn ? ` · AS${d.asn}${org}` : ''}`;
    row(serverEl, S.sGeo, geo);
    if (d.colo) row(serverEl, S.sColo, d.colo);
    row(serverEl, S.sIp, S.ipValue, 'dim');
    if (d.userAgent) row(serverEl, S.sUa, d.userAgent);
    if (d.acceptLanguage) row(serverEl, S.sLang, d.acceptLanguage + S.langNote, 'warn');
    if (d.acceptEncoding) row(serverEl, S.sEncoding, d.acceptEncoding);
    row(serverEl, S.sReferer, d.refererPresent ? S.refererYes : S.refererNo, d.refererPresent ? '' : 'dim');
    row(serverEl, S.sChPlatform, d.secChUaPlatform || S.notSent, d.secChUaPlatform ? '' : 'dim');
    const dntV = d.dnt === 'dnt' ? S.dntOn : d.dnt === 'gpc' ? S.dntGpc : S.dntUnset;
    row(serverEl, S.sDnt, dntV, d.dnt === 'unset' ? 'dim' : '');

    statusEl.hidden = true;
    serverEl.hidden = false;
    serverFoot.hidden = false;
  }

  async function loadServer() {
    try {
      const res = await fetch(`${base}/api/mirror`, { headers: { accept: 'application/json' } });
      const ctype = res.headers.get('content-type') ?? '';
      if (!res.ok || !ctype.includes('application/json')) throw new Error('no api');
      renderServer(await res.json());
    } catch {
      // Sem Worker publicado: o painel local continua a funcionar.
      statusEl.textContent = S.unavailable;
    }
  }

  renderLocal();
  loadServer();
</script>
