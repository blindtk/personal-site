---
import { API_BASE, type Lang } from '../../config';
import { t } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).selfscan;

const jsStrings = {
  lastScan: s.lastScan,
  runNow: s.runNow,
  running: s.running,
  rateLimited: s.rateLimited,
  unavailable: s.unavailable,
  loading: s.loading,
  headersTitle: s.headersTitle,
};
---

<section class="self-scan" id="self-scan" data-api={API_BASE} data-strings={JSON.stringify(jsStrings)}>
  <div class="scan-grade">
    <div class="grade-badge" id="scan-grade" data-grade="">—</div>
    <div class="grade-cap">{s.gradeLabel}</div>
  </div>
  <div class="scan-body">
    <p class="scan-status mono" id="scan-status">{s.loading}</p>
    <div class="hdrlist mono" id="scan-headers" hidden></div>
    <div class="scan-foot">
      <button type="button" class="btn ghost small" id="scan-run">{s.runNow}</button>
      <span class="scan-ts mono" id="scan-ts"></span>
    </div>
  </div>
</section>

<script>
  const root = document.getElementById('self-scan')!;
  const base = root.dataset.api ?? '';
  const S = JSON.parse(root.dataset.strings!);
  const gradeEl = document.getElementById('scan-grade')!;
  const statusEl = document.getElementById('scan-status')!;
  const listEl = document.getElementById('scan-headers')!;
  const tsEl = document.getElementById('scan-ts')!;
  const runBtn = document.getElementById('scan-run') as HTMLButtonElement;

  const gradeTone = (g: string) =>
    /^A/.test(g) ? 'good' : /^[BC]/.test(g) ? 'mid' : 'bad';

  function render(data: any) {
    gradeEl.textContent = data.grade ?? '—';
    gradeEl.dataset.grade = gradeTone(data.grade ?? '');
    statusEl.textContent = S.headersTitle;

    listEl.replaceChildren();
    for (const h of data.checklist ?? []) {
      const row = document.createElement('div');
      const mark = document.createElement('span');
      mark.className = h.present ? 'ok' : 'no';
      mark.textContent = h.present ? '✓' : '✗';
      const code = document.createElement('code');
      code.textContent = h.name;
      row.append(mark, code);
      listEl.append(row);
    }
    listEl.hidden = false;

    if (data.scannedAt) {
      const when = new Date(data.scannedAt).toLocaleString();
      tsEl.textContent = `${S.lastScan}: ${when}`;
    }
  }

  async function load(refresh = false) {
    try {
      const url = `${base}/api/scan${refresh ? '?refresh=1' : ''}`;
      const res = await fetch(url, { headers: { accept: 'application/json' } });
      if (res.status === 429) { statusEl.textContent = S.rateLimited; return; }
      const ctype = res.headers.get('content-type') ?? '';
      if (!res.ok || !ctype.includes('application/json')) throw new Error('no api');
      render(await res.json());
    } catch {
      // Sem Worker publicado: degrada com graça (os scanners públicos
      // continuam listados na página).
      statusEl.textContent = S.unavailable;
      listEl.hidden = true;
      gradeEl.textContent = '—';
      runBtn.disabled = true;
    }
  }

  runBtn.addEventListener('click', async () => {
    runBtn.disabled = true;
    const prev = runBtn.textContent;
    runBtn.textContent = S.running;
    await load(true);
    runBtn.textContent = prev;
    runBtn.disabled = false;
  });

  load();
</script>
