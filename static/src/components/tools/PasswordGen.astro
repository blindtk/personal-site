---
import type { Lang } from '../../config';
import { t } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).tools.passwords;

const jsStrings = {
  needCharset: s.needCharset,
  copy: s.copy,
  copied: s.copied,
  bits: s.bits,
  weak: s.weak,
  ok: s.ok,
  strong: s.strong,
  excellent: s.excellent,
};
---

<div class="tool-panel" id="pw-tool" data-strings={JSON.stringify(jsStrings)}>
  <div class="field">
    <label for="pw-length">{s.length}: <span id="pw-length-val">20</span></label>
    <input type="range" id="pw-length" min="8" max="64" value="20" />
  </div>
  <div class="field">
    <label class="check-row"><input type="checkbox" id="pw-lower" checked /> {s.lower}</label>
    <label class="check-row"><input type="checkbox" id="pw-upper" checked /> {s.upper}</label>
    <label class="check-row"><input type="checkbox" id="pw-digits" checked /> {s.digits}</label>
    <label class="check-row"><input type="checkbox" id="pw-symbols" checked /> {s.symbols}</label>
    <label class="check-row"><input type="checkbox" id="pw-noambiguous" /> {s.noAmbiguous}</label>
  </div>
  <div class="btn-row">
    <button type="button" class="btn" id="pw-generate">{s.generate}</button>
    <button type="button" class="btn ghost small" id="pw-copy">{s.copy}</button>
  </div>
  <p class="error-msg" id="pw-error" hidden></p>
  <div class="password-out" id="pw-output"></div>
  <div class="field entropy-field">
    <label>{s.entropy}: <span id="pw-entropy">—</span></label>
    <div class="meter"><div class="fill" id="pw-meter"></div></div>
  </div>
</div>

<script>
  import { buildPool, generatePassword, entropyBits, strengthKey } from '../../scripts/password.js';

  const root = document.getElementById('pw-tool')!;
  const strings = JSON.parse(root.dataset.strings!);
  const lengthEl = document.getElementById('pw-length') as HTMLInputElement;
  const lengthVal = document.getElementById('pw-length-val')!;
  const output = document.getElementById('pw-output')!;
  const errorEl = document.getElementById('pw-error')!;
  const entropyEl = document.getElementById('pw-entropy')!;
  const meter = document.getElementById('pw-meter') as HTMLElement;
  const copyBtn = document.getElementById('pw-copy') as HTMLButtonElement;
  const check = (id: string) => (document.getElementById(id) as HTMLInputElement).checked;

  const COLORS: Record<string, string> = {
    weak: 'var(--danger)',
    ok: 'var(--accent-2)',
    strong: 'var(--accent)',
    excellent: 'var(--accent)',
  };

  function run() {
    const pool = buildPool({
      lower: check('pw-lower'),
      upper: check('pw-upper'),
      digits: check('pw-digits'),
      symbols: check('pw-symbols'),
      noAmbiguous: check('pw-noambiguous'),
    });
    if (!pool) {
      errorEl.textContent = strings.needCharset;
      errorEl.hidden = false;
      output.textContent = '';
      entropyEl.textContent = '—';
      meter.style.width = '0';
      return;
    }
    errorEl.hidden = true;
    const length = Number(lengthEl.value);
    output.textContent = generatePassword(pool, length);
    const bits = entropyBits(pool.length, length);
    const key = strengthKey(bits);
    entropyEl.textContent = `${bits} ${strings.bits} · ${strings[key]}`;
    meter.style.width = `${Math.min(100, (bits / 128) * 100)}%`;
    meter.style.backgroundColor = COLORS[key];
  }

  lengthEl.addEventListener('input', () => {
    lengthVal.textContent = lengthEl.value;
    run();
  });
  for (const id of ['pw-lower', 'pw-upper', 'pw-digits', 'pw-symbols', 'pw-noambiguous']) {
    document.getElementById(id)!.addEventListener('change', run);
  }
  document.getElementById('pw-generate')!.addEventListener('click', run);
  copyBtn.addEventListener('click', async () => {
    await navigator.clipboard.writeText(output.textContent ?? '');
    copyBtn.textContent = strings.copied;
    setTimeout(() => (copyBtn.textContent = strings.copy), 1500);
  });
  run();
</script>

<style>
  #pw-output { margin-top: 1rem; }
  .entropy-field { margin-top: 0.8rem; }
</style>
