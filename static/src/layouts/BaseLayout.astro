---
import { getCollection } from 'astro:content';
import { SITE, SITE_URL, type Lang } from '../config';
import { t } from '../i18n/ui';
import { routes, projectUrl, type RouteKey } from '../i18n/routes';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** URL da mesma página no outro idioma (para o seletor PT/EN e hreflang). */
  altUrl?: string;
  /** Chave da rota ativa, para destacar na nav. */
  active?: RouteKey;
  /** Alarga o container (páginas-dashboard: Analytics, Performance). */
  wide?: boolean;
}

const { lang, title, description, altUrl, active, wide } = Astro.props;
const dict = t(lang);
const otherLang: Lang = lang === 'pt' ? 'en' : 'pt';
const desc = description ?? SITE.description[lang];
const pageTitle = `${title} · ${SITE.handle}`;

// "Blog" só aparece na nav se houver pelo menos um post publicado
// (não-draft) em qualquer um dos dois idiomas — evita um link para uma
// secção vazia enquanto não há conteúdo real.
const publishedPosts = await getCollection('blog', (e) => !e.data.draft);
const hasBlog = publishedPosts.length > 0;

const navItems: { key: RouteKey; label: string }[] = [
  { key: 'about', label: dict.nav.about },
  ...(hasBlog ? [{ key: 'blog' as const, label: dict.nav.blog }] : []),
  { key: 'projects', label: dict.nav.projects },
  { key: 'tools', label: dict.nav.tools },
];

const navItemsAfterSecurity: { key: RouteKey; label: string }[] = [
  { key: 'links', label: dict.nav.links },
  { key: 'contact', label: dict.nav.contact },
];

const currentPath = Astro.url.pathname;

// "Este Site" agrupa na nav as seis camadas do mesmo sistema — a mesma
// lista e ordem do bloco de cross-links no fundo de cada uma delas (ver
// SiteLayers.astro, que é a fonte de verdade desta ordem): Visão Geral,
// Segurança, Perímetro (honeypot + deteções + ameaças Cloudflare, numa só
// página com tabs), Provas, Performance (tráfego + Core Web Vitals) e o
// projeto «Este site» (arquitetura e decisões). Perímetro (ataque ao vivo +
// a regra que o apanharia) vem antes de Provas (o audit trail — commit,
// cabeçalhos, CI) de propósito: mostra primeiro o que está a acontecer, só
// depois o "não acredites, verifica".
// `href` explícito, não RouteKey: o projeto «Este site» vive nos posts de
// /projetos/ (projectUrl), não é uma rota estática de routes.ts — e usar
// href também para as outras cinco simplifica o aria-current para uma só
// comparação (currentPath === item.href) que funciona para as seis.
// ATT&CK e Certificações ficam de fora de propósito — não são sobre o site,
// são sobre credenciais e percurso pessoais (o próprio attack.json chama-lhe
// "heatmap pessoal", "o meu CV"). O sítio natural para as duas é o Sobre,
// que já as linka em prosa; continuam também acessíveis pelo rodapé.
const siteGroup: { href: string; label: string }[] = [
  { href: routes.siteOverview[lang], label: dict.nav.overview },
  { href: routes.security[lang], label: dict.nav.security },
  { href: routes.perimeter[lang], label: dict.nav.perimeter },
  { href: routes.evidence[lang], label: dict.footer.evidence },
  { href: routes.performance[lang], label: dict.nav.performance },
  { href: projectUrl(lang, 'este-site'), label: dict.nav.projectThisSite },
];
const siteActive = siteGroup.some((item) => item.href === currentPath);

// Imagem de partilha (LinkedIn, Twitter/X, etc.) — uma por idioma, gerada
// a partir do mesmo design system do site.
const ogImage = lang === 'pt' ? '/og-image.png' : '/og-image-en.png';

// Dados estruturados (schema.org Person) — ajuda motores de busca a associar
// o site à identidade profissional (pode gerar knowledge panel). Vive aqui
// (site-wide) em vez de só na home/Sobre para não duplicar lógica por página.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: SITE.role[lang],
  url: SITE_URL,
  sameAs: [SITE.github, SITE.linkedin, SITE.credly].filter(Boolean),
};
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={SITE.name} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(currentPath, SITE_URL)} />
    {altUrl && <link rel="alternate" hreflang={otherLang} href={new URL(altUrl, SITE_URL)} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(currentPath, SITE_URL)} />
    <meta property="og:image" content={new URL(ogImage, SITE_URL)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/* < evita que um valor de config com "</script>" alguma vez quebre
       para fora da tag — hoje os valores são todos estáticos e inofensivos,
       mas é a mitigação padrão para JSON-LD via set:html.

       Este bloco é inline (JSON-LD não tem forma fiável de externalizar) e
       por isso NÃO está coberto pelo lever "zero inline" do resto do site —
       está autorizado na CSP por um hash sha256 explícito em
       static/public/_headers (ver docs/security-headers.md). Se este objeto
       mudar de conteúdo (ex.: SITE.role[pt] passar a diferir de
       SITE.role[en]), recalcula e atualiza esse hash — senão a CSP volta a
       bloquear este script em produção. */}
    <script type="application/ld+json" set:html={JSON.stringify(personSchema).replace(/</g, '\\u003c')} is:inline />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_PT' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={new URL(ogImage, SITE_URL)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{dict.a11y.skipToContent}</a>

    <nav class:list={['site-nav', { 'nav-solid': wide }]}>
      <div class:list={['container', 'inner', { wide }]}>
        <a class="brand" href={routes.home[lang]}>
          <span class="live-dot" aria-hidden="true"></span>
          <span class="cmd">{SITE.handle}</span>
        </a>
        <button
          class="nav-toggle"
          aria-expanded="false"
          aria-controls="nav-links"
          data-label-open={dict.nav.menu}
          data-label-close={dict.nav.menuClose}
        >
          <span class="nav-toggle-label">{dict.nav.menu}</span> <span class="nav-toggle-icon">≡</span>
        </button>
        <ul class="nav-links" id="nav-links">
          {navItems.map((item) => (
            <li>
              <a
                href={routes[item.key][lang]}
                aria-current={active === item.key ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
          <li class="nav-security">
            {/* Sem open={siteActive}: abrir por omissão punha o painel
               flutuante (position: absolute) a tapar a intro da própria
               página no primeiro paint, sem precisar de nenhuma interação. A
               secção ativa continua marcada — só no aria-current do summary. */}
            <details>
              <summary aria-current={siteActive ? 'page' : undefined}>{dict.nav.thisSite}</summary>
              <ul class="sub-links">
                {siteGroup.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={currentPath === item.href ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
          {navItemsAfterSecurity.map((item) => (
            <li>
              <a
                href={routes[item.key][lang]}
                aria-current={active === item.key ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a
              class="lab-link"
              href={routes.lab[lang]}
              aria-current={active === 'lab' ? 'page' : undefined}
            >
              {dict.nav.lab} ⚡
            </a>
          </li>
          <li>
            <a class="lang-switch" href={altUrl ?? routes.home[otherLang]} aria-label={dict.a11y.switchLang}>
              {otherLang.toUpperCase()}
            </a>
          </li>
        </ul>
      </div>
    </nav>

    <main id="main" class:list={['container', { wide }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class:list={['container', 'inner', { wide }]}>
        <span>
          © {new Date().getFullYear()} {SITE.name} · {SITE.role[lang]}
        </span>
        {/* Dois grupos, não uma lista só: "Este site" (as páginas de
           segurança/telemetria) e "Percurso" (credenciais pessoais — ATT&CK,
           Certificações). Misturados numa lista só, pareciam a mesma família;
           ver a nota em SiteLayers.astro sobre porque ATT&CK/Certificações
           não são "camadas" do site. */}
        <span class="footer-group">
          {dict.footer.thisSiteLabel}{' '}
          <a href={routes.security[lang]}>{dict.footer.security}</a> ·{' '}
          <a href={routes.perimeter[lang]}>{dict.footer.perimeter}</a> ·{' '}
          <a href={routes.evidence[lang]}>{dict.footer.evidence}</a>
        </span>
        <span class="footer-group">
          {dict.footer.pathLabel}{' '}
          <a href={routes.attack[lang]}>{dict.footer.attack}</a> ·{' '}
          <a href={routes.certifications[lang]}>{dict.footer.certs}</a>
        </span>
        <span>
          {dict.footer.built}
          {' '}
          <a href={SITE.github} rel="noopener">GitHub</a>.
        </span>
      </div>
    </footer>

    <!-- Ficheiro estático em public/js/ (não hoisted pelo Astro): fica
         fora do bundler para nunca ser inlinado no HTML — ver astro.config.mjs. -->
    <script src="/js/nav.js" defer is:inline></script>
    <!-- Beacon de Core Web Vitals (first-party, agregado, sem PII): mede a
         performance real e envia UMA vez para /api/vitals — alimenta a página
         Performance. Ver public/js/vitals.js. -->
    <script src="/js/vitals.js" defer is:inline></script>
  </body>
</html>
