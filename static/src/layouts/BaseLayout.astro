---
import { getCollection } from 'astro:content';
import { SITE, SITE_URL, type Lang } from '../config';
import { t } from '../i18n/ui';
import { routes, type RouteKey } from '../i18n/routes';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** URL da mesma página no outro idioma (para o seletor PT/EN e hreflang). */
  altUrl?: string;
  /** Chave da rota ativa, para destacar na nav. */
  active?: RouteKey;
}

const { lang, title, description, altUrl, active } = Astro.props;
const dict = t(lang);
const otherLang: Lang = lang === 'pt' ? 'en' : 'pt';
const desc = description ?? SITE.description[lang];
const pageTitle = `${title} · ${SITE.handle}`;

// "Blog" só aparece na nav se houver pelo menos um post publicado
// (não-draft) em qualquer um dos dois idiomas — evita um link para uma
// secção vazia enquanto não há conteúdo real.
const publishedPosts = await getCollection('blog', (e) => !e.data.draft);
const hasBlog = publishedPosts.length > 0;

const navItems: { key: RouteKey; label: string }[] = [
  { key: 'about', label: dict.nav.about },
  ...(hasBlog ? [{ key: 'blog' as const, label: dict.nav.blog }] : []),
  { key: 'projects', label: dict.nav.projects },
  { key: 'tools', label: dict.nav.tools },
];

const navItemsAfterSecurity: { key: RouteKey; label: string }[] = [
  { key: 'links', label: dict.nav.links },
  { key: 'contact', label: dict.nav.contact },
];

// "Este Site" agrupa na nav as páginas sobre a arquitetura e telemetria
// DESTE site: Visão Geral, Segurança, Provas, Perímetro, Deteções, Analytics
// e Performance. ATT&CK e Certificações ficam de fora de propósito — não são
// sobre o site, são sobre credenciais e percurso pessoais (o próprio
// attack.json chama-lhe "heatmap pessoal", "o meu CV"). O sítio natural para
// as duas é o Sobre, que já as linka em prosa; continuam também acessíveis
// pelo rodapé e por cross-links a partir do Perímetro/Deteções.
const siteGroup: { key: RouteKey; label: string }[] = [
  { key: 'siteOverview', label: dict.nav.overview },
  { key: 'security', label: dict.nav.security },
  { key: 'evidence', label: dict.footer.evidence },
  { key: 'perimeter', label: dict.nav.perimeter },
  { key: 'detections', label: dict.footer.detections },
  { key: 'analytics', label: dict.nav.analytics },
  { key: 'performance', label: dict.nav.performance },
];
const siteActive = siteGroup.some((item) => item.key === active);

const currentPath = Astro.url.pathname;
// Imagem de partilha (LinkedIn, Twitter/X, etc.) — uma por idioma, gerada
// a partir do mesmo design system do site.
const ogImage = lang === 'pt' ? '/og-image.png' : '/og-image-en.png';

// Dados estruturados (schema.org Person) — ajuda motores de busca a associar
// o site à identidade profissional (pode gerar knowledge panel). Vive aqui
// (site-wide) em vez de só na home/Sobre para não duplicar lógica por página.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: SITE.role[lang],
  url: SITE_URL,
  sameAs: [SITE.github, SITE.linkedin, SITE.credly].filter(Boolean),
};
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={SITE.name} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(currentPath, SITE_URL)} />
    {altUrl && <link rel="alternate" hreflang={otherLang} href={new URL(altUrl, SITE_URL)} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(currentPath, SITE_URL)} />
    <meta property="og:image" content={new URL(ogImage, SITE_URL)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/* < evita que um valor de config com "</script>" alguma vez quebre
       para fora da tag — hoje os valores são todos estáticos e inofensivos,
       mas é a mitigação padrão para JSON-LD via set:html.

       Este bloco é inline (JSON-LD não tem forma fiável de externalizar) e
       por isso NÃO está coberto pelo lever "zero inline" do resto do site —
       está autorizado na CSP por um hash sha256 explícito em
       static/public/_headers (ver docs/security-headers.md). Se este objeto
       mudar de conteúdo (ex.: SITE.role[pt] passar a diferir de
       SITE.role[en]), recalcula e atualiza esse hash — senão a CSP volta a
       bloquear este script em produção. */}
    <script type="application/ld+json" set:html={JSON.stringify(personSchema).replace(/</g, '\\u003c')} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_PT' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={new URL(ogImage, SITE_URL)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{dict.a11y.skipToContent}</a>

    <nav class="site-nav">
      <div class="container inner">
        <a class="brand" href={routes.home[lang]}>
          <span class="live-dot" aria-hidden="true"></span>
          <span class="cmd">{SITE.handle}</span>
        </a>
        <button
          class="nav-toggle"
          aria-expanded="false"
          aria-controls="nav-links"
          data-label-open={dict.nav.menu}
          data-label-close={dict.nav.menuClose}
        >
          <span class="nav-toggle-label">{dict.nav.menu}</span> <span class="nav-toggle-icon">≡</span>
        </button>
        <ul class="nav-links" id="nav-links">
          {navItems.map((item) => (
            <li>
              <a
                href={routes[item.key][lang]}
                aria-current={active === item.key ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
          <li class="nav-security">
            {/* Sem open={siteActive}: abrir por omissão punha o painel
               flutuante (position: absolute) a tapar a intro da própria
               página no primeiro paint, sem precisar de nenhuma interação. A
               secção ativa continua marcada — só no aria-current do summary. */}
            <details>
              <summary aria-current={siteActive ? 'page' : undefined}>{dict.nav.thisSite}</summary>
              <ul class="sub-links">
                {siteGroup.map((item) => (
                  <li>
                    <a
                      href={routes[item.key][lang]}
                      aria-current={active === item.key ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
          {navItemsAfterSecurity.map((item) => (
            <li>
              <a
                href={routes[item.key][lang]}
                aria-current={active === item.key ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a
              class="lab-link"
              href={routes.lab[lang]}
              aria-current={active === 'lab' ? 'page' : undefined}
            >
              {dict.nav.lab} ⚡
            </a>
          </li>
          <li>
            <a class="lang-switch" href={altUrl ?? routes.home[otherLang]} aria-label={dict.a11y.switchLang}>
              {otherLang.toUpperCase()}
            </a>
          </li>
        </ul>
      </div>
    </nav>

    <main id="main" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container inner">
        <span>
          © {new Date().getFullYear()} {SITE.name} · {SITE.role[lang]} ·{' '}
          <a href={routes.security[lang]}>{dict.footer.security}</a> ·{' '}
          <a href={routes.evidence[lang]}>{dict.footer.evidence}</a> ·{' '}
          <a href={routes.detections[lang]}>{dict.footer.detections}</a> ·{' '}
          <a href={routes.attack[lang]}>{dict.footer.attack}</a> ·{' '}
          <a href={routes.certifications[lang]}>{dict.footer.certs}</a>
        </span>
        <span>
          {dict.footer.built}
          {' '}
          <a href={SITE.github} rel="noopener">GitHub</a>. {dict.footer.rights}
        </span>
      </div>
    </footer>

    <!-- Ficheiro estático em public/js/ (não hoisted pelo Astro): fica
         fora do bundler para nunca ser inlinado no HTML — ver astro.config.mjs. -->
    <script src="/js/nav.js" defer></script>
  </body>
</html>
