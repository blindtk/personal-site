# Cabeçalhos de segurança (Cloudflare Pages lê este ficheiro).
#
# A Content-Security-Policy é uma linha estática escrita à mão aqui — não é
# gerada no build. Já foi: hashes SHA-256 por <script>/<style> inline,
# calculados no build (Astro security.csp) e unidos numa única linha no
# header. Abandonado porque o nº de hashes crescia com o nº de *combinações*
# página×script/estilo (cada página combina o script partilhado com o seu
# próprio num só bloco inline, hash diferente por combinação) — ao fim de
# ~50 páginas a linha ultrapassava os 2000 caracteres máximos por header do
# Cloudflare Pages, e o Pages descartava o header CSP inteiro em produção
# (CSP ausente, sem aviso). A correção foi eliminar o inline em vez de o
# catalogar: zero <script>/<style> inline no site (ver
# static/astro.config.mjs e static/public/js/), por isso 'self' já é tão
# restrito quanto uma lista de hashes — mas com tamanho fixo, que não volta
# a crescer com mais páginas ou ferramentas.
#
# Exceção única: o <script type="application/ld+json"> (schema.org Person)
# em src/layouts/BaseLayout.astro é inline em todas as páginas — JSON-LD não
# tem equivalente a <link> externo com suporte fiável em crawlers, por isso
# não pode seguir o lever "sempre externo" dos outros scripts. O parser HTML
# aplica script-src/script-src-elem a QUALQUER elemento <script>, mesmo com
# type não-executável (browsers não distinguem pelo type ao decidir bloquear
# inline — só depois de já não bloquear é que o type decide se corre como
# JS). Por isso entra aqui um único hash sha256 do conteúdo exato do bloco,
# em vez de reabrir 'unsafe-inline'. O conteúdo (SITE.name/role/url/redes em
# config.ts) é igual em PT e EN hoje, logo um hash chega; se algum dia PT e
# EN divergirem (ex.: role[pt] != role[en]), recalcula e acrescenta o
# segundo hash — não crescerá por página, só por variante de conteúdo (ver
# docs/security-headers.md para o comando de cálculo).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-0BTdAeq88K+MWdoaEIXoW7FrmFBFgz2f/m7l28Mn4AA='; style-src 'self'; img-src 'self' blob:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; worker-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types 'none'; report-uri /api/csp-report; report-to csp-endpoint
  # Força HTTPS por 2 anos (sem "preload" para manter reversível enquanto o
  # domínio é provisório; acrescenta "; preload" e submete em hstspreload.org
  # quando o domínio final estiver fixo).
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  # Impede MIME sniffing.
  X-Content-Type-Options: nosniff
  # Anti-clickjacking (frame-ancestors não é válido em CSP via <meta>, mas
  # já não usamos <meta> para CSP — mantido a par pelo mesmo motivo:
  # browsers antigos que não suportem frame-ancestors).
  X-Frame-Options: DENY
  # Não vaza o path completo como referer para outros sites.
  Referrer-Policy: strict-origin-when-cross-origin
  # Desliga APIs de browser que o site não usa.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  # Endpoint da Reporting API para violações CSP (o report-to da CSP acima
  # aponta para este nome). URL relativo — resolve contra a própria
  # origem, onde o Worker interceta /api/* (ver dynamic/worker/).
  Reporting-Endpoints: csp-endpoint="/api/csp-report"
  # Isolamento de contexto de navegação e de recursos.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  # Só carrega subrecursos same-origin ou com CORP explícito. Todo o site é
  # same-origin (CSS/JS/fontes/imagens/favicon), por isso não quebra nada; a
  # par do COOP acima ativa cross-origin isolation (defesa contra Spectre).
  # As og-image.png são cross-origin mas só as buscam OUTROS sites (previews),
  # nunca as nossas páginas — daí o CORP: cross-origin específico delas abaixo.
  Cross-Origin-Embedder-Policy: require-corp

# As imagens Open Graph precisam de ser carregáveis por outras origens
# (pré-visualizações de LinkedIn/Slack/etc.), por isso relaxa-se o CORP e
# fixa-se um cache longo.
# O "!" é obrigatório: quando várias regras coincidem, o Pages NÃO substitui
# um header repetido — CONCATENA os valores com vírgula. Sem o detach, este
# ficheiro servia "same-origin, cross-origin" (valor inválido, o browser
# ignora o header por inteiro). O "!" remove primeiro o valor herdado do
# bloco /* e só depois se define o novo.
/og-image.png
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=31536000, immutable
/og-image-en.png
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=31536000, immutable
