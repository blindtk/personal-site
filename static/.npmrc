# Sem scripts de ciclo de vida nas dependências (postinstall do esbuild, etc.):
# o CI já corre `npm ci --ignore-scripts`, mas o build do Cloudflare Pages faz
# primeiro o seu próprio `npm clean-install` — este ficheiro também o cobre,
# sem depender de variáveis do dashboard (SKIP_DEPENDENCY_INSTALL não foi
# aplicada nos logs do Pages). O build e os testes não precisam deles; se um dia
# for preciso, `npm rebuild <pacote>` corre-os à mão.
ignore-scripts=true
