// Renovate faz os *version updates* (rotina + majors). O Dependabot fica
// ligado SÓ para *security updates* — é complementar, não concorrente: cobre
// as vulnerabilidades em dependências transitivas (fundo do lock file), que o
// Renovate por design não abre PR (só age nas diretas do package.json). Ex.:
// sharp/libvips puxado pelo wrangler em dynamic/worker/. NÃO ligar o Dependabot
// *version updates* — esses sim colidiriam com o Renovate. Ver dynamic/PLAN.md.
// Requer a app "Renovate" (Mend) instalada no repositório:
//   https://github.com/apps/renovate
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Tudo o que não é major agrupado num único PR (menos ruído);
    // majors continuam em PRs separados para revisão com calma.
    'group:allNonMajor',
    // Pina as GitHub Actions por digest SHA (uses: owner/repo@<sha> # vX.Y.Z)
    // e mantém os digests atualizados — proteção contra tags movidas.
    'helpers:pinGitHubActionDigests',
  ],
  timezone: 'Europe/Lisbon',
  // Janela semanal única: segunda-feira de madrugada.
  schedule: ['before 8am on monday'],
  // Respeita os ranges semver do package.json (não os reescreve).
  rangeStrategy: 'preserve',
  // Espera 3 dias antes de propor uma versão nova — janela de segurança
  // contra pacotes comprometidos publicados e retirados pouco depois.
  minimumReleaseAge: '3 days',
  // Refresca o package-lock.json uma vez por mês (apanha transitivas).
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 8am on the first day of the month'],
  },
  prConcurrentLimit: 3,
  labels: ['dependencies'],
  // CVEs ignoram minimumReleaseAge e o schedule semanal por omissão
  // (schedule vazio = "a qualquer hora") — só marcamos com label próprio
  // para se distinguirem das atualizações de rotina.
  vulnerabilityAlerts: {
    labels: ['security'],
  },
  // Labels extra por manager/tipo, para triagem visual dos PRs.
  packageRules: [
    {
      matchManagers: ['npm'],
      addLabels: ['npm'],
    },
    {
      matchManagers: ['github-actions'],
      addLabels: ['github-actions'],
    },
    {
      matchManagers: ['pre-commit'],
      addLabels: ['pre-commit'],
    },
    {
      matchManagers: ['custom.regex'],
      addLabels: ['pypi'],
    },
    {
      matchUpdateTypes: ['major'],
      addLabels: ['major'],
    },
    // TypeScript 7 é o novo compilador nativo (Go) e ainda não expõe a API
    // programática de que o @astrojs/check/@astrojs/language-server dependem
    // (erro "does not expose the programmatic API that `astro check` relies
    // on"). Major bump prematuro por dependência upstream — ver PR #159 e
    // https://github.com/withastro/roadmap/discussions/1321. Em vez de
    // desativar, fica a aguardar aprovação no Dependency Dashboard (issue do
    // Renovate): não abre PR, mas o major continua visível lá. Quando o
    // @astrojs/check seguir o TS7, marcar a checkbox para criar o PR.
    {
      matchPackageNames: ['typescript'],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
    // @jazzer.js/core 4.x: os prebuilds nativos são compilados contra glibc
    // 2.38 e a imagem do run_fuzzers (Ubuntu 20.04) só tem a 2.31 — o harness
    // não arranca ("GLIBC_2.32 not found"). O .clusterfuzzlite/build.sh fixa
    // o prebuild do v2.1.0 por URL + SHA-256, que o Renovate não atualiza.
    // Ver PR #206. Fica a aguardar aprovação no Dependency Dashboard (não
    // abre PR, mas o major continua visível lá). Quando a imagem tiver
    // glibc >= 2.38, atualizar o prebuild no build.sh e o CONTRIBUTING.md e
    // só então marcar a checkbox.
    {
      matchPackageNames: ['@jazzer.js/core'],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
  ],
  // O manager pre-commit vem desligado por omissão — ligá-lo para seguir o
  // `rev:` dos hooks (ex.: gitleaks em .pre-commit-config.yaml), que de outra
  // forma ficava por atualizar.
  'pre-commit': { enabled: true },
  // Versões cravadas em `run:` (pipx) não têm manager nativo: o semgrep e o
  // zizmor pinados em .github/workflows/security.yml. Regex + datasource PyPI
  // para as manter atualizadas como o resto.
  customManagers: [
    {
      // actionlint vem de um URL de release com versão E sha256 literais;
      // nenhum manager nativo o vê. A PR do Renovate avisa da versão nova —
      // o checksum é sempre conferido por um humano contra o
      // actionlint_<versão>_checksums.txt oficial.
      customType: 'regex',
      description: 'actionlint release pin in security.yml',
      managerFilePatterns: ['/^\\.github/workflows/security\\.yml$/'],
      matchStrings: ['actionlint/releases/download/v(?<currentValue>[0-9.]+)/'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'rhysd/actionlint',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
    {
      // Imagem do testssl.sh usada num `docker run` dentro de um `run:` em
      // verify-tls.yml — nenhum manager nativo (nem o dockerfile) a vê.
      // Tag + digest na mesma linha; o Renovate atualiza os dois.
      customType: 'regex',
      description: 'testssl.sh image (tag + digest) in verify-tls.yml',
      managerFilePatterns: ['/^\\.github/workflows/verify-tls\\.yml$/'],
      matchStrings: [
        '(?<depName>drwetter/testssl\\.sh):(?<currentValue>[0-9][^@\\s]*)@(?<currentDigest>sha256:[a-f0-9]{64})',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/[^/]+\\.ya?ml$/'],
      matchStrings: ['pipx install (?<depName>[a-z0-9._-]+)==(?<currentValue>\\S+)'],
      datasourceTemplate: 'pypi',
    },
  ],
}
